<local:BaseEquipmentControl x:Class="TwoD5DMonitoring.Controls.Equipment.BlowerControl"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:local="clr-namespace:TwoD5DMonitoring.Controls"
              xmlns:models="clr-namespace:TwoD5DMonitoring.Models"
              xmlns:conv="clr-namespace:TwoD5DMonitoring.Converters">

    <local:BaseEquipmentControl.Resources>
        <conv:EquipmentStateToColorConverter x:Key="StateToColorConverter" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <conv:BoolToConnectedBrushConverter x:Key="BoolToConnectedBrushConverter" />
        <conv:PointToCanvasLeftConverter x:Key="PointToCanvasLeftConverter" />
        <conv:PointToCanvasTopConverter x:Key="PointToCanvasTopConverter" />

        <!-- Blower Housing Geometry -->
        <PathGeometry x:Key="HousingGeometry">
            <PathFigure StartPoint="0,0" IsClosed="True">
                <LineSegment Point="180,0"/>
                <ArcSegment Point="180,120" Size="10,10" SweepDirection="Clockwise"/>
                <LineSegment Point="0,120"/>
                <ArcSegment Point="0,0" Size="10,10" SweepDirection="Clockwise"/>
            </PathFigure>
        </PathGeometry>

        <!-- Inlet Flange -->
        <PathGeometry x:Key="InletFlangeGeometry">
            <PathFigure StartPoint="0,0" IsClosed="True">
                <LineSegment Point="40,0"/>
                <LineSegment Point="40,20"/>
                <LineSegment Point="0,20"/>
            </PathFigure>
        </PathGeometry>

        <!-- Outlet Flange -->
        <PathGeometry x:Key="OutletFlangeGeometry">
            <PathFigure StartPoint="0,0" IsClosed="True">
                <LineSegment Point="40,0"/>
                <LineSegment Point="40,20"/>
                <LineSegment Point="0,20"/>
            </PathFigure>
        </PathGeometry>

        <!-- Impeller Geometry (2-lobe rotor) -->
        <PathGeometry x:Key="ImpellerGeometry">
            <PathFigure StartPoint="0,0" IsClosed="True">
                <BezierSegment Point1="25,-10" Point2="25,10" Point3="0,20"/>
                <BezierSegment Point1="-25,10" Point2="-25,-10" Point3="0,0"/>
            </PathFigure>
        </PathGeometry>

        <!-- Motor Geometry -->
        <PathGeometry x:Key="MotorGeometry">
            <PathFigure StartPoint="0,0" IsClosed="True">
                <LineSegment Point="80,0"/>
                <LineSegment Point="80,60"/>
                <LineSegment Point="0,60"/>
            </PathFigure>
        </PathGeometry>

        <!-- Pulley Geometry -->
        <EllipseGeometry x:Key="PulleyGeometry" Center="0,0" RadiusX="25" RadiusY="10"/>

        <!-- Belt Geometry -->
        <PathGeometry x:Key="BeltGeometry">
            <PathFigure StartPoint="-25,-5" IsClosed="True">
                <LineSegment Point="25,-5"/>
                <LineSegment Point="25,5"/>
                <LineSegment Point="-25,5"/>
            </PathFigure>
        </PathGeometry>

        <!-- Pressure Gauge -->
        <EllipseGeometry x:Key="GaugeGeometry" Center="0,0" RadiusX="25" RadiusY="25"/>

        <!-- Housing Brush -->
        <LinearGradientBrush x:Key="HousingBrush" StartPoint="0,0" EndPoint="1,0" MappingMode="RelativeToBoundingBox">
            <GradientStop Color="#4A4A4A" Offset="0.0"/>
            <GradientStop Color="#333333" Offset="0.5"/>
            <GradientStop Color="#222222" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Impeller Brush -->
        <RadialGradientBrush x:Key="ImpellerBrush" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5" GradientOrigin="0.3,0.3">
            <GradientStop Color="#FFD700" Offset="0.0"/>
            <GradientStop Color="#DAA520" Offset="0.5"/>
            <GradientStop Color="#B8860B" Offset="1.0"/>
        </RadialGradientBrush>

        <!-- Motor Brush -->
        <LinearGradientBrush x:Key="MotorBrush" StartPoint="0,0" EndPoint="1,0" MappingMode="RelativeToBoundingBox">
            <GradientStop Color="#5A5A5A" Offset="0.0"/>
            <GradientStop Color="#3A3A3A" Offset="0.5"/>
            <GradientStop Color="#2A2A2A" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Pulley Brush -->
        <RadialGradientBrush x:Key="PulleyBrush" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5" GradientOrigin="0.3,0.3">
            <GradientStop Color="#3A3A3A" Offset="0.0"/>
            <GradientStop Color="#1A1A1A" Offset="0.7"/>
            <GradientStop Color="#0A0A0A" Offset="1.0"/>
        </RadialGradientBrush>

        <!-- Belt Brush -->
        <LinearGradientBrush x:Key="BeltBrush" StartPoint="0,0" EndPoint="0,1" MappingMode="RelativeToBoundingBox">
            <GradientStop Color="#1A1A1A" Offset="0.0"/>
            <GradientStop Color="#0A0A0A" Offset="0.5"/>
            <GradientStop Color="#1A1A1A" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Gauge Brush -->
        <RadialGradientBrush x:Key="GaugeBrush" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5" GradientOrigin="0.3,0.3">
            <GradientStop Color="#1A1A1A" Offset="0.0"/>
            <GradientStop Color="#0A0A0A" Offset="0.5"/>
            <GradientStop Color="#050505" Offset="1.0"/>
        </RadialGradientBrush>

        <!-- Pressure Gauge Needle -->
        <PathGeometry x:Key="NeedleGeometry">
            <PathFigure StartPoint="0,0" IsClosed="True">
                <LineSegment Point="3,0"/>
                <LineSegment Point="0,-20"/>
                <LineSegment Point="-3,0"/>
            </PathFigure>
        </PathGeometry>

        <!-- Valve Style -->
        <Style x:Key="ValveStyle" TargetType="Path">
            <Setter Property="Stroke" Value="#666666"/>
            <Setter Property="StrokeThickness" Value="2"/>
        </Style>

        <!-- Indicator Light Style -->
        <Style x:Key="IndicatorLightStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="Stroke" Value="#444444"/>
            <Setter Property="StrokeThickness" Value="2"/>
        </Style>

        <!-- Impeller Animation -->
        <Storyboard x:Key="ImpellerAnimation" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="ImpellerRotation"
                             Storyboard.TargetProperty="Angle"
                             From="0" To="360"
                             Duration="0:0:0.5"/>
        </Storyboard>

        <!-- Pulley Animation -->
        <Storyboard x:Key="PulleyAnimation" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="PulleyRotation"
                             Storyboard.TargetProperty="Angle"
                             From="0" To="360"
                             Duration="0:0:0.8"/>
        </Storyboard>
    </local:BaseEquipmentControl.Resources>

    <Grid x:Name="RootGrid" Width="180" Height="120" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <TransformGroup>
                <RotateTransform x:Name="RotationTransform" Angle="0" CenterX="90" CenterY="60"/>
                <ScaleTransform x:Name="ScaleTransform" ScaleX="1" ScaleY="1"/>
            </TransformGroup>
        </Grid.RenderTransform>

        <!-- Shadow -->
        <Ellipse Fill="#40000000" Width="150" Height="8" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-4" Opacity="0.3" IsHitTestVisible="False">
            <Ellipse.Effect>
                <BlurEffect Radius="4"/>
            </Ellipse.Effect>
        </Ellipse>

        <!-- Blower Housing -->
        <Path x:Name="Housing"
              Data="{StaticResource HousingGeometry}"
              Fill="{StaticResource HousingBrush}"
              Stroke="#555555" StrokeThickness="1.5">
            <Path.Effect>
                <DropShadowEffect Color="Black" BlurRadius="4" ShadowDepth="2" Opacity="0.5" Direction="270"/>
            </Path.Effect>
        </Path>

        <!-- Inlet Flange -->
        <Path x:Name="InletFlange"
              Data="{StaticResource InletFlangeGeometry}"
              Fill="#3A3A3A" Stroke="#666666" StrokeThickness="2"
              Canvas.Left="-40" Canvas.Top="50"
              Width="40" Height="20">
            <Path.Effect>
                <DropShadowEffect Color="Black" BlurRadius="2" ShadowDepth="1" Opacity="0.5"/>
            </Path.Effect>
        </Path>

        <!-- Outlet Flange -->
        <Path x:Name="OutletFlange"
              Data="{StaticResource OutletFlangeGeometry}"
              Fill="#3A3A3A" Stroke="#666666" StrokeThickness="2"
              Canvas.Left="180" Canvas.Top="50"
              Width="40" Height="20">
            <Path.Effect>
                <DropShadowEffect Color="Black" BlurRadius="2" ShadowDepth="1" Opacity="0.5"/>
            </Path.Effect>
        </Path>

        <!-- Motor -->
        <Path x:Name="Motor"
              Data="{StaticResource MotorGeometry}"
              Fill="{StaticResource MotorBrush}"
              Stroke="#555555" StrokeThickness="1"
              Canvas.Left="190" Canvas.Top="30">
            <Path.Effect>
                <DropShadowEffect Color="Black" BlurRadius="2" ShadowDepth="1" Opacity="0.4"/>
            </Path.Effect>
        </Path>

        <!-- Motor Pulley -->
        <Ellipse x:Name="MotorPulley"
                 Width="50" Height="20"
                 Fill="{StaticResource PulleyBrush}"
                 Stroke="#444444" StrokeThickness="1"
                 Canvas.Left="265" Canvas.Top="55"
                 RenderTransformOrigin="0.5,0.5">
            <Ellipse.RenderTransform>
                <RotateTransform x:Name="PulleyRotation" CenterX="25" CenterY="10" Angle="0"/>
            </Ellipse.RenderTransform>
            <Ellipse.Effect>
                <DropShadowEffect Color="Black" BlurRadius="2" ShadowDepth="1" Opacity="0.4"/>
            </Ellipse.Effect>
        </Ellipse>

        <!-- Blower Pulley -->
        <Ellipse x:Name="BlowerPulley"
                 Width="50" Height="20"
                 Fill="{StaticResource PulleyBrush}"
                 Stroke="#444444" StrokeThickness="1"
                 Canvas.Left="65" Canvas.Top="10"
                 RenderTransformOrigin="0.5,0.5">
            <Ellipse.RenderTransform>
                <RotateTransform x:Name="BlowerPulleyRotation" CenterX="25" CenterY="10" Angle="0"/>
            </Ellipse.RenderTransform>
        </Ellipse>

        <!-- Belt -->
        <Path x:Name="Belt"
              Data="{StaticResource BeltGeometry}"
              Fill="{StaticResource BeltBrush}"
              Stroke="#0A0A0A" StrokeThickness="0.5"
              Canvas.Left="65" Canvas.Top="10"
              Width="200" Height="20"
              RenderTransformOrigin="0.5,0.5">
            <Path.RenderTransform>
                <TranslateTransform X="0" Y="10"/>
            </Path.RenderTransform>
        </Path>

        <!-- Impeller 1 (Left) -->
        <Path x:Name="Impeller1"
              Data="{StaticResource ImpellerGeometry}"
              Fill="{StaticResource ImpellerBrush}"
              Canvas.Left="40" Canvas.Top="45"
              Width="50" Height="50"
              RenderTransformOrigin="0.5,0.5">
            <Path.RenderTransform>
                <RotateTransform x:Name="Impeller1Rotation" CenterX="25" CenterY="25" Angle="0"/>
            </Path.RenderTransform>
            <Path.Effect>
                <DropShadowEffect Color="Black" BlurRadius="3" ShadowDepth="1" Opacity="0.5"/>
            </Path.Effect>
        </Path>

        <!-- Impeller 2 (Right) -->
        <Path x:Name="Impeller2"
              Data="{StaticResource ImpellerGeometry}"
              Fill="{StaticResource ImpellerBrush}"
              Canvas.Left="90" Canvas.Top="45"
              Width="50" Height="50"
              RenderTransformOrigin="0.5,0.5">
            <Path.RenderTransform>
                <RotateTransform x:Name="Impeller2Rotation" CenterX="25" CenterY="25" Angle="180"/>
            </Path.RenderTransform>
            <Path.Effect>
                <DropShadowEffect Color="Black" BlurRadius="3" ShadowDepth="1" Opacity="0.5"/>
            </Path.Effect>
        </Path>

        <!-- Pressure Gauge -->
        <Ellipse x:Name="Gauge"
                 Width="50" Height="50"
                 Fill="{StaticResource GaugeBrush}"
                 Stroke="#333333" StrokeThickness="2"
                 Canvas.Left="10" Canvas.Top="10">
            <Ellipse.Effect>
                <DropShadowEffect Color="Black" BlurRadius="2" ShadowDepth="1" Opacity="0.5"/>
            </Ellipse.Effect>
            <Ellipse.RenderTransform>
                <TranslateTransform X="25" Y="25"/>
            </Ellipse.RenderTransform>
        </Ellipse>

        <!-- Gauge Needle -->
        <Path x:Name="GaugeNeedle"
              Data="{StaticResource NeedleGeometry}"
              Fill="#FF4444"
              Canvas.Left="35" Canvas.Top="35"
              Width="6" Height="20"
              RenderTransformOrigin="0.5,1">
            <Path.RenderTransform>
                <RotateTransform x:Name="NeedleRotation" CenterX="3" CenterY="20" Angle="-90"/>
            </Path.RenderTransform>
        </Path>

        <!-- Inlet Valve -->
        <Path x:Name="InletValve"
              Style="{StaticResource ValveStyle}"
              Data="M0,0 L20,0 L20,-15 L10,-15 L10,-25 L0,-15 Z"
              Canvas.Left="10" Canvas.Top="30"
              Width="20" Height="25"
              Visibility="Collapsed">
            <Path.RenderTransform>
                <RotateTransform x:Name="InletValveRotation" CenterX="10" CenterY="12.5" Angle="0"/>
            </Path.RenderTransform>
        </Path>

        <!-- Outlet Valve -->
        <Path x:Name="OutletValve"
              Style="{StaticResource ValveStyle}"
              Data="M0,0 L20,0 L20,15 L10,15 L10,25 L0,15 Z"
              Canvas.Left="150" Canvas.Top="30"
              Width="20" Height="25"
              Visibility="Collapsed">
            <Path.RenderTransform>
                <RotateTransform x:Name="OutletValveRotation" CenterX="10" CenterY="12.5" Angle="180"/>
            </Path.RenderTransform>
        </Path>

        <!-- Status Light -->
        <Ellipse x:Name="StatusLight"
                 Width="14" Height="14"
                 HorizontalAlignment="Right" VerticalAlignment="Top"
                 Margin="0,8,8,0" Stroke="#444444" StrokeThickness="2">
            <Ellipse.Fill>
                <RadialGradientBrush Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5" GradientOrigin="0.5,0.5">
                    <GradientStop Color="#404040" Offset="0.0"/>
                    <GradientStop Color="#202020" Offset="1.0"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <!-- Anchor Points -->
        <ItemsControl x:Name="AnchorsControl" Visibility="Collapsed">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas x:Name="AnchorsCanvas" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Ellipse Style="{StaticResource AnchorPointStyle}"
                             Fill="{Binding IsConnected, Converter={StaticResource BoolToConnectedBrushConverter}}"
                             ToolTip="{Binding Name}"
                             Tag="{Binding}">
                        <Ellipse.RenderTransform>
                            <TranslateTransform X="-7" Y="-7" />
                        </Ellipse.RenderTransform>
                    </Ellipse>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="Canvas.Left" Value="{Binding Position.X, Converter={StaticResource PointToCanvasLeftConverter}}"/>
                    <Setter Property="Canvas.Top" Value="{Binding Position.Y, Converter={StaticResource PointToCanvasTopConverter}}"/>
                </Style>
            </ItemsControl.ItemContainerStyle>
        </ItemsControl>

        <!-- Selection Border -->
        <Border x:Name="SelectionBorder" Style="{StaticResource SelectionBorderStyle}" Visibility="Collapsed"/>
    </Grid>
</local:BaseEquipmentControl>
