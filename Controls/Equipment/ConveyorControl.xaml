<local:BaseEquipmentControl x:Class="TwoD5DMonitoring.Controls.Equipment.ConveyorControl"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:local="clr-namespace:TwoD5DMonitoring.Controls"
              xmlns:models="clr-namespace:TwoD5DMonitoring.Models"
              xmlns:conv="clr-namespace:TwoD5DMonitoring.Converters"
              xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <local:BaseEquipmentControl.Resources>
        <conv:EquipmentStateToColorConverter x:Key="StateToColorConverter" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <conv:BoolToConnectedBrushConverter x:Key="BoolToConnectedBrushConverter" />
        <conv:DiameterToShadowThicknessConverter x:Key="DiameterToShadowThicknessConverter" />
        <conv:PointToCanvasLeftConverter x:Key="PointToCanvasLeftConverter" />
        <conv:PointToCanvasTopConverter x:Key="PointToCanvasTopConverter" />

        <!-- Conveyor Frame -->
        <PathGeometry x:Key="FrameGeometry">
            <PathFigure StartPoint="0,15" IsClosed="True">
                <LineSegment Point="300,15"/>
                <LineSegment Point="300,55"/>
                <LineSegment Point="0,55"/>
            </PathFigure>
        </PathGeometry>

        <!-- Belt -->
        <PathGeometry x:Key="BeltGeometry">
            <PathFigure StartPoint="2,17" IsClosed="True">
                <LineSegment Point="298,17"/>
                <LineSegment Point="298,53"/>
                <LineSegment Point="2,53"/>
            </PathFigure>
        </PathGeometry>

        <!-- Left Roller -->
        <EllipseGeometry x:Key="LeftRollerGeometry" Center="15,35" RadiusX="15" RadiusY="20"/>

        <!-- Right Roller -->
        <EllipseGeometry x:Key="RightRollerGeometry" Center="285,35" RadiusX="15" RadiusY="20"/>

        <!-- Rubber Block -->
        <PathGeometry x:Key="RubberBlockGeometry">
            <PathFigure StartPoint="0,0" IsClosed="True">
                <LineSegment Point="40,0"/>
                <BezierSegment Point1="50,-5" Point2="50,25" Point3="40,25"/>
                <LineSegment Point="0,25"/>
            </PathFigure>
        </PathGeometry>

        <!-- Frame Brush -->
        <LinearGradientBrush x:Key="FrameBrush" StartPoint="0,0" EndPoint="0,1" MappingMode="RelativeToBoundingBox">
            <GradientStop Color="#4A4A4A" Offset="0.0"/>
            <GradientStop Color="#333333" Offset="0.5"/>
            <GradientStop Color="#222222" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Belt Brush -->
        <LinearGradientBrush x:Key="BeltBrush" StartPoint="0,0" EndPoint="0,1" MappingMode="RelativeToBoundingBox">
            <GradientStop Color="#1A1A1A" Offset="0.0"/>
            <GradientStop Color="#0A0A0A" Offset="0.5"/>
            <GradientStop Color="#1A1A1A" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Roller Brush -->
        <RadialGradientBrush x:Key="RollerBrush" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5" GradientOrigin="0.3,0.3">
            <GradientStop Color="#5A5A5A" Offset="0.0"/>
            <GradientStop Color="#2A2A2A" Offset="0.7"/>
            <GradientStop Color="#1A1A1A" Offset="1.0"/>
        </RadialGradientBrush>

        <!-- Rubber Block Brush -->
        <LinearGradientBrush x:Key="RubberBlockBrush" StartPoint="0,0" EndPoint="1,1" MappingMode="RelativeToBoundingBox">
            <GradientStop Color="#2A1A1A" Offset="0.0"/>
            <GradientStop Color="#1A0D0D" Offset="0.5"/>
            <GradientStop Color="#100808" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Status Indicator Light -->
        <Style x:Key="IndicatorLightStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="Stroke" Value="#444444"/>
            <Setter Property="StrokeThickness" Value="2"/>
        </Style>
    </local:BaseEquipmentControl.Resources>

    <Grid x:Name="RootGrid" Width="300" Height="70" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <TransformGroup>
                <RotateTransform x:Name="RotationTransform" Angle="0" CenterX="150" CenterY="35"/>
                <ScaleTransform x:Name="ScaleTransform" ScaleX="1" ScaleY="1"/>
            </TransformGroup>
        </Grid.RenderTransform>

        <!-- Shadow -->
        <Ellipse Fill="#40000000" Width="260" Height="6" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-2" Opacity="0.3" IsHitTestVisible="False">
            <Ellipse.Effect>
                <BlurEffect Radius="3"/>
            </Ellipse.Effect>
        </Ellipse>

        <!-- Frame -->
        <Path x:Name="Frame"
              Data="{StaticResource FrameGeometry}"
              Fill="{StaticResource FrameBrush}"
              Stroke="#555555" StrokeThickness="1.5">
            <Path.Effect>
                <DropShadowEffect Color="Black" BlurRadius="4" ShadowDepth="2" Opacity="0.5" Direction="270"/>
            </Path.Effect>
        </Path>

        <!-- Left Roller -->
        <Ellipse x:Name="LeftRoller"
                 Width="30" Height="40"
                 Canvas.Left="0" Canvas.Top="15"
                 Fill="{StaticResource RollerBrush}">
            <Ellipse.RenderTransform>
                <RotateTransform x:Name="LeftRollerRotation" CenterX="15" CenterY="20" Angle="0"/>
            </Ellipse.RenderTransform>
            <Ellipse.Effect>
                <DropShadowEffect Color="Black" BlurRadius="3" ShadowDepth="1" Opacity="0.4"/>
            </Ellipse.Effect>
        </Ellipse>

        <!-- Right Roller -->
        <Ellipse x:Name="RightRoller"
                 Width="30" Height="40"
                 Canvas.Left="270" Canvas.Top="15"
                 Fill="{StaticResource RollerBrush}">
            <Ellipse.RenderTransform>
                <RotateTransform x:Name="RightRollerRotation" CenterX="15" CenterY="20" Angle="0"/>
            </Ellipse.RenderTransform>
            <Ellipse.Effect>
                <DropShadowEffect Color="Black" BlurRadius="3" ShadowDepth="1" Opacity="0.4"/>
            </Ellipse.Effect>
        </Ellipse>

        <!-- Belt -->
        <Path x:Name="Belt"
              Data="{StaticResource BeltGeometry}"
              Fill="{StaticResource BeltBrush}"
              Stroke="#0A0A0A" StrokeThickness="0.5">
            <Path.Effect>
                <DropShadowEffect Color="Black" BlurRadius="2" ShadowDepth="1" Opacity="0.5" Direction="270"/>
            </Path.Effect>
        </Path>

        <!-- Rubber Blocks -->
        <ItemsControl x:Name="RubberBlocksControl"
                      ItemsSource="{Binding RubberBlocks}"
                      Canvas.Top="17"
                      Canvas.Left="2">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Path x:Name="RubberBlock"
                          Data="{StaticResource RubberBlockGeometry}"
                          Fill="{StaticResource RubberBlockBrush}"
                          Width="40" Height="25"
                          Canvas.Left="{Binding X}" Canvas.Top="{Binding Y}">
                        <Path.RenderTransform>
                            <TranslateTransform X="2" Y="17"/>
                        </Path.RenderTransform>
                    </Path>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Status Light -->
        <Ellipse x:Name="StatusLight"
                 Width="14" Height="14"
                 HorizontalAlignment="Left" VerticalAlignment="Top"
                 Margin="8,8,0,0" Stroke="#444444" StrokeThickness="2">
            <Ellipse.Fill>
                <RadialGradientBrush Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5" GradientOrigin="0.5,0.5">
                    <GradientStop Color="#404040" Offset="0.0"/>
                    <GradientStop Color="#202020" Offset="1.0"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <!-- Anchor Points -->
        <ItemsControl x:Name="AnchorsControl" Visibility="Collapsed">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Ellipse Style="{StaticResource AnchorPointStyle}"
                             Fill="{Binding IsConnected, Converter={StaticResource BoolToConnectedBrushConverter}}"
                             ToolTip="{Binding Name}"
                             Tag="{Binding}">
                        <Ellipse.RenderTransform>
                            <TranslateTransform X="-7" Y="-7" />
                        </Ellipse.RenderTransform>
                    </Ellipse>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="Canvas.Left" Value="{Binding Position.X, Converter={StaticResource PointToCanvasLeftConverter}}"/>
                    <Setter Property="Canvas.Top" Value="{Binding Position.Y, Converter={StaticResource PointToCanvasTopConverter}}"/>
                </Style>
            </ItemsControl.ItemContainerStyle>
        </ItemsControl>

        <!-- Selection Border -->
        <Border x:Name="SelectionBorder" Style="{StaticResource SelectionBorderStyle}" Visibility="Collapsed"/>
    </Grid>
</local:BaseEquipmentControl>



