<local:BaseEquipmentControl x:Class="TwoD5DMonitoring.Controls.Equipment.DustCollectorControl"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:local="clr-namespace:TwoD5DMonitoring.Controls"
              xmlns:models="clr-namespace:TwoD5DMonitoring.Models"
              xmlns:conv="clr-namespace:TwoD5DMonitoring.Converters"
              xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <local:BaseEquipmentControl.Resources>
        <conv:EquipmentStateToColorConverter x:Key="StateToColorConverter" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <conv:BoolToConnectedBrushConverter x:Key="BoolToConnectedBrushConverter" />
        <conv:DiameterToShadowThicknessConverter x:Key="DiameterToShadowThicknessConverter" />
        <conv:PointToCanvasLeftConverter x:Key="PointToCanvasLeftConverter" />
        <conv:PointToCanvasTopConverter x:Key="PointToCanvasTopConverter" />

        <!-- Pulse Box Geometry -->
        <PathGeometry x:Key="PulseBoxGeometry">
            <PathFigure StartPoint="0,0" IsClosed="True">
                <LineSegment Point="160,0"/>
                <LineSegment Point="160,50"/>
                <LineSegment Point="0,50"/>
            </PathFigure>
        </PathGeometry>

        <!-- Cylinder Geometry -->
        <PathGeometry x:Key="CylinderGeometry">
            <PathFigure StartPoint="20,50" IsClosed="True">
                <LineSegment Point="140,50"/>
                <LineSegment Point="130,180"/>
                <LineSegment Point="30,180"/>
            </PathFigure>
        </PathGeometry>

        <!-- Hopper Geometry -->
        <PathGeometry x:Key="HopperGeometry">
            <PathFigure StartPoint="30,180" IsClosed="True">
                <LineSegment Point="130,180"/>
                <LineSegment Point="100,260"/>
                <LineSegment Point="60,260"/>
            </PathFigure>
        </PathGeometry>

        <!-- Motor Geometry -->
        <PathGeometry x:Key="MotorGeometry">
            <PathFigure StartPoint="60,0" IsClosed="True">
                <LineSegment Point="100,0"/>
                <LineSegment Point="100,40"/>
                <LineSegment Point="60,40"/>
            </PathFigure>
        </PathGeometry>

        <!-- Filter Bag Geometry -->
        <PathGeometry x:Key="FilterBagGeometry">
            <PathFigure StartPoint="0,0" IsClosed="True">
                <LineSegment Point="15,0"/>
                <LineSegment Point="15,100"/>
                <LineSegment Point="0,100"/>
            </PathFigure>
        </PathGeometry>

        <!-- Fan Blade Geometry -->
        <PathGeometry x:Key="FanBladeGeometry">
            <PathFigure StartPoint="0,0" IsClosed="True">
                <LineSegment Point="30,0"/>
                <LineSegment Point="30,10"/>
                <LineSegment Point="0,10"/>
            </PathFigure>
        </PathGeometry>

        <!-- Inlet Geometry -->
        <PathGeometry x:Key="InletGeometry">
            <PathFigure StartPoint="0,0" IsClosed="True">
                <LineSegment Point="40,0"/>
                <LineSegment Point="40,15"/>
                <LineSegment Point="0,15"/>
            </PathFigure>
        </PathGeometry>

        <!-- Outlet Geometry -->
        <PathGeometry x:Key="OutletGeometry">
            <PathFigure StartPoint="0,0" IsClosed="True">
                <LineSegment Point="40,0"/>
                <LineSegment Point="40,15"/>
                <LineSegment Point="0,15"/>
            </PathFigure>
        </PathGeometry>

        <!-- Pulse Box Brush -->
        <LinearGradientBrush x:Key="PulseBoxBrush" StartPoint="0,0" EndPoint="1,0" MappingMode="RelativeToBoundingBox">
            <GradientStop Color="#4A4A4A" Offset="0.0"/>
            <GradientStop Color="#333333" Offset="0.5"/>
            <GradientStop Color="#222222" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Cylinder Brush -->
        <LinearGradientBrush x:Key="CylinderBrush" StartPoint="0,0" EndPoint="1,0" MappingMode="RelativeToBoundingBox">
            <GradientStop Color="#3A3A3A" Offset="0.0"/>
            <GradientStop Color="#222222" Offset="0.5"/>
            <GradientStop Color="#121212" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Hopper Brush -->
        <LinearGradientBrush x:Key="HopperBrush" StartPoint="0.5,0" EndPoint="0.5,1" MappingMode="RelativeToBoundingBox">
            <GradientStop Color="#3A3A3A" Offset="0.0"/>
            <GradientStop Color="#222222" Offset="0.5"/>
            <GradientStop Color="#121212" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Motor Brush -->
        <LinearGradientBrush x:Key="MotorBrush" StartPoint="0,0" EndPoint="1,0" MappingMode="RelativeToBoundingBox">
            <GradientStop Color="#5A5A5A" Offset="0.0"/>
            <GradientStop Color="#3A3A3A" Offset="0.5"/>
            <GradientStop Color="#2A2A2A" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Fan Brush -->
        <RadialGradientBrush x:Key="FanBrush" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5" GradientOrigin="0.3,0.3">
            <GradientStop Color="#5A5A5A" Offset="0.0"/>
            <GradientStop Color="#2A2A2A" Offset="0.7"/>
            <GradientStop Color="#1A1A1A" Offset="1.0"/>
        </RadialGradientBrush>

        <!-- Filter Bag Brush -->
        <LinearGradientBrush x:Key="FilterBagBrush" StartPoint="0,0" EndPoint="0,1" MappingMode="RelativeToBoundingBox">
            <GradientStop Color="#E8E8E8" Offset="0.0"/>
            <GradientStop Color="#CCCCCC" Offset="0.5"/>
            <GradientStop Color="#AAAAAA" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Indicator Light Style -->
        <Style x:Key="IndicatorLightStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Height" Value="12"/>
            <Setter Property="Stroke" Value="#444444"/>
            <Setter Property="StrokeThickness" Value="2"/>
        </Style>

        <!-- Animation for fan rotation -->
        <Storyboard x:Key="MotorAnimation" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="FanRotation"
                             Storyboard.TargetProperty="Angle"
                             From="0" To="360"
                             Duration="0:0:1"/>
        </Storyboard>

        <!-- Animation for filter pulsing -->
        <Storyboard x:Key="FilterPulseAnimation" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="FilterOpacity"
                             Storyboard.TargetProperty="Opacity"
                             From="0.3" To="1.0"
                             Duration="0:0:2"
                             AutoReverse="True"/>
        </Storyboard>
    </local:BaseEquipmentControl.Resources>

    <Grid x:Name="RootGrid" Width="160" Height="300" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <TransformGroup>
                <RotateTransform x:Name="RotationTransform" Angle="0" CenterX="80" CenterY="150"/>
                <ScaleTransform x:Name="ScaleTransform" ScaleX="1" ScaleY="1"/>
            </TransformGroup>
        </Grid.RenderTransform>

        <!-- Shadow -->
        <Ellipse Fill="#40000000" Width="120" Height="8" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-4" Opacity="0.3" IsHitTestVisible="False">
            <Ellipse.Effect>
                <BlurEffect Radius="4"/>
            </Ellipse.Effect>
        </Ellipse>

        <!-- Pulse Box -->
        <Path x:Name="PulseBox"
              Data="{StaticResource PulseBoxGeometry}"
              Fill="{StaticResource PulseBoxBrush}"
              Stroke="#555555" StrokeThickness="1.5">
            <Path.Effect>
                <DropShadowEffect Color="Black" BlurRadius="4" ShadowDepth="2" Opacity="0.5" Direction="270"/>
            </Path.Effect>
        </Path>

        <!-- Cylinder -->
        <Path x:Name="Cylinder"
              Data="{StaticResource CylinderGeometry}"
              Fill="{StaticResource CylinderBrush}"
              Stroke="#555555" StrokeThickness="1.5">
            <Path.Effect>
                <DropShadowEffect Color="Black" BlurRadius="4" ShadowDepth="2" Opacity="0.5" Direction="270"/>
            </Path.Effect>
        </Path>

        <!-- Hopper -->
        <Path x:Name="Hopper"
              Data="{StaticResource HopperGeometry}"
              Fill="{StaticResource HopperBrush}"
              Stroke="#555555" StrokeThickness="1.5">
            <Path.Effect>
                <DropShadowEffect Color="Black" BlurRadius="4" ShadowDepth="2" Opacity="0.5" Direction="270"/>
            </Path.Effect>
        </Path>

        <!-- Motor -->
        <Path x:Name="Motor"
              Data="{StaticResource MotorGeometry}"
              Fill="{StaticResource MotorBrush}"
              Stroke="#555555" StrokeThickness="1"
              Canvas.Left="60" Canvas.Top="0">
            <Path.Effect>
                <DropShadowEffect Color="Black" BlurRadius="2" ShadowDepth="1" Opacity="0.4"/>
            </Path.Effect>
        </Path>

        <!-- Fan -->
        <Path x:Name="Fan"
              Data="{StaticResource FanBladeGeometry}"
              Fill="{StaticResource FanBrush}"
              Stroke="#444444" StrokeThickness="1"
              Canvas.Left="72.5" Canvas.Top="10"
              Width="30" Height="20"
              RenderTransformOrigin="0.5,0.5">
            <Path.RenderTransform>
                <RotateTransform x:Name="FanRotation" CenterX="15" CenterY="10" Angle="0"/>
            </Path.RenderTransform>
        </Path>

        <!-- Filter Bags -->
        <ItemsControl x:Name="FilterBagsControl"
                      ItemsSource="{Binding FilterBags}"
                      Canvas.Left="25" Canvas.Top="55">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Path x:Name="FilterBag"
                          Data="{StaticResource FilterBagGeometry}"
                          Fill="{StaticResource FilterBagBrush}"
                          Stroke="#CCCCCC" StrokeThickness="0.5"
                          Width="15" Height="100"
                          Canvas.Left="{Binding X}" Canvas.Top="0"
                          Opacity="{Binding Opacity, Converter={StaticResource FilterOpacityConverter}, FallbackValue=0.5}">
                        <Path.RenderTransform>
                            <TranslateTransform x:Name="FilterTranslate" X="0" Y="0"/>
                        </Path.RenderTransform>
                    </Path>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Inlet -->
        <Path x:Name="Inlet"
              Data="{StaticResource InletGeometry}"
              Fill="#88AAEE"
              Stroke="#4488CC" StrokeThickness="1.5"
              Canvas.Left="60" Canvas.Top="260"
              Width="40" Height="15">
            <Path.Effect>
                <DropShadowEffect Color="Black" BlurRadius="2" ShadowDepth="1" Opacity="0.5"/>
            </Path.Effect>
        </Path>

        <!-- Outlet -->
        <Path x:Name="Outlet"
              Data="{StaticResource OutletGeometry}"
              Fill="#88AAEE"
              Stroke="#4488CC" StrokeThickness="1.5"
              Canvas.Left="60" Canvas.Top="280"
              Width="40" Height="15">
            <Path.Effect>
                <DropShadowEffect Color="Black" BlurRadius="2" ShadowDepth="1" Opacity="0.5"/>
            </Path.Effect>
        </Path>

        <!-- Status Light -->
        <Ellipse x:Name="StatusLight"
                 Width="12" Height="12"
                 HorizontalAlignment="Right" VerticalAlignment="Top"
                 Margin="0,8,8,0" Stroke="#444444" StrokeThickness="2">
            <Ellipse.Fill>
                <RadialGradientBrush Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5" GradientOrigin="0.5,0.5">
                    <GradientStop Color="#404040" Offset="0.0"/>
                    <GradientStop Color="#202020" Offset="1.0"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <!-- Anchor Points -->
        <ItemsControl x:Name="AnchorsControl" Visibility="Collapsed">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Ellipse Style="{StaticResource AnchorPointStyle}"
                             Fill="{Binding IsConnected, Converter={StaticResource BoolToConnectedBrushConverter}}"
                             ToolTip="{Binding Name}"
                             Tag="{Binding}">
                        <Ellipse.RenderTransform>
                            <TranslateTransform X="-7" Y="-7" />
                        </Ellipse.RenderTransform>
                    </Ellipse>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="Canvas.Left" Value="{Binding Position.X, Converter={StaticResource PointToCanvasLeftConverter}}"/>
                    <Setter Property="Canvas.Top" Value="{Binding Position.Y, Converter={StaticResource PointToCanvasTopConverter}}"/>
                </Style>
            </ItemsControl.ItemContainerStyle>
        </ItemsControl>

        <!-- Selection Border -->
        <Border x:Name="SelectionBorder" Style="{StaticResource SelectionBorderStyle}" Visibility="Collapsed"/>
    </Grid>
</local:BaseEquipmentControl>


