<local:BaseEquipmentControl x:Class="TwoD5DMonitoring.Controls.Equipment.FeedBinControl"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:local="clr-namespace:TwoD5DMonitoring.Controls"
              xmlns:models="clr-namespace:TwoD5DMonitoring.Models"
              xmlns:conv="clr-namespace:TwoD5DMonitoring.Converters">

    <local:BaseEquipmentControl.Resources>
        <conv:EquipmentStateToColorConverter x:Key="StateToColorConverter" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <conv:BoolToConnectedBrushConverter x:Key="BoolToConnectedBrushConverter" />
        <conv:DiameterToShadowThicknessConverter x:Key="DiameterToShadowThicknessConverter" />
        <conv:PointToCanvasLeftConverter x:Key="PointToCanvasLeftConverter" />
        <conv:PointToCanvasTopConverter x:Key="PointToCanvasTopConverter" />

        <!-- Bin Body Geometry -->
        <PathGeometry x:Key="BinBodyGeometry">
            <PathFigure StartPoint="0,0" IsClosed="True">
                <LineSegment Point="140,0"/>
                <LineSegment Point="130,220"/>
                <LineSegment Point="10,220"/>
            </PathFigure>
        </PathGeometry>

        <!-- Door Geometry -->
        <PathGeometry x:Key="DoorGeometry">
            <PathFigure StartPoint="30,10" IsClosed="True">
                <LineSegment Point="110,10"/>
                <LineSegment Point="110,50"/>
                <LineSegment Point="30,50"/>
            </PathFigure>
        </PathGeometry>

        <!-- Dust Outlet Geometry -->
        <PathGeometry x:Key="DustOutletGeometry">
            <PathFigure StartPoint="0,0" IsClosed="True">
                <LineSegment Point="24,0"/>
                <LineSegment Point="24,24"/>
                <LineSegment Point="0,24"/>
            </PathFigure>
        </PathGeometry>

        <!-- Outlet Flange Geometry -->
        <PathGeometry x:Key="OutletFlangeGeometry">
            <PathFigure StartPoint="50,0" IsClosed="True">
                <LineSegment Point="90,0"/>
                <LineSegment Point="90,15"/>
                <LineSegment Point="50,15"/>
            </PathFigure>
        </PathGeometry>

        <!-- Bin Body Brush -->
        <LinearGradientBrush x:Key="BinBodyBrush" StartPoint="0,0" EndPoint="1,0" MappingMode="RelativeToBoundingBox">
            <GradientStop Color="#4A4A4A" Offset="0.0"/>
            <GradientStop Color="#333333" Offset="0.5"/>
            <GradientStop Color="#222222" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Door Brush -->
        <LinearGradientBrush x:Key="DoorBrush" StartPoint="0,0" EndPoint="0,1" MappingMode="RelativeToBoundingBox">
            <GradientStop Color="#5A5A5A" Offset="0.0"/>
            <GradientStop Color="#3A3A3A" Offset="0.5"/>
            <GradientStop Color="#2A2A2A" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Flange Brush -->
        <LinearGradientBrush x:Key="FlangeBrush" StartPoint="0,0" EndPoint="1,0" MappingMode="RelativeToBoundingBox">
            <GradientStop Color="#5A5A5A" Offset="0.0"/>
            <GradientStop Color="#3A3A3A" Offset="0.5"/>
            <GradientStop Color="#2A2A2A" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Carbon Fill Brush -->
        <LinearGradientBrush x:Key="CarbonFillBrush" StartPoint="0.5,1" EndPoint="0.5,0" MappingMode="RelativeToBoundingBox">
            <GradientStop Color="#101010" Offset="0.0"/>
            <GradientStop Color="#1A1A1A" Offset="0.3"/>
            <GradientStop Color="#151515" Offset="0.7"/>
            <GradientStop Color="#0A0A0A" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Sensor Light Style -->
        <Style x:Key="SensorLightStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Height" Value="10"/>
            <Setter Property="Stroke" Value="#444444"/>
            <Setter Property="StrokeThickness" Value="1.5"/>
        </Style>

        <!-- Door Animation -->
        <Storyboard x:Key="DoorOpenAnimation">
            <DoubleAnimation Storyboard.TargetName="DoorRotation"
                             Storyboard.TargetProperty="Angle"
                             From="0" To="-90"
                             Duration="0:0:0.5"/>
        </Storyboard>

        <Storyboard x:Key="DoorCloseAnimation">
            <DoubleAnimation Storyboard.TargetName="DoorRotation"
                             Storyboard.TargetProperty="Angle"
                             From="-90" To="0"
                             Duration="0:0:0.5"/>
        </Storyboard>
    </local:BaseEquipmentControl.Resources>

    <Grid x:Name="RootGrid" Width="140" Height="240" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <TransformGroup>
                <RotateTransform x:Name="RotationTransform" Angle="0" CenterX="70" CenterY="120"/>
                <ScaleTransform x:Name="ScaleTransform" ScaleX="1" ScaleY="1"/>
            </TransformGroup>
        </Grid.RenderTransform>

        <!-- Shadow -->
        <Ellipse Fill="#40000000" Width="100" Height="8" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-4" Opacity="0.3" IsHitTestVisible="False">
            <Ellipse.Effect>
                <BlurEffect Radius="4"/>
            </Ellipse.Effect>
        </Ellipse>

        <!-- Bin Body -->
        <Path x:Name="BinBody"
              Data="{StaticResource BinBodyGeometry}"
              Fill="{StaticResource BinBodyBrush}"
              Stroke="#555555" StrokeThickness="1.5">
            <Path.Effect>
                <DropShadowEffect Color="Black" BlurRadius="4" ShadowDepth="2" Opacity="0.5" Direction="270"/>
            </Path.Effect>
        </Path>

        <!-- Highlight -->
        <Rectangle x:Name="Highlight"
                   Width="10"
                   HorizontalAlignment="Left"
                   Margin="4,0,0,0"
                   RadiusX="2" RadiusY="2">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0" MappingMode="RelativeToBoundingBox">
                    <GradientStop Color="#5A5A5A" Offset="0.0"/>
                    <GradientStop Color="#00000000" Offset="1.0"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- Door -->
        <Path x:Name="Door"
              Data="{StaticResource DoorGeometry}"
              Fill="{StaticResource DoorBrush}"
              Stroke="#666666" StrokeThickness="1.5"
              Canvas.Left="30" Canvas.Top="10">
            <Path.RenderTransform>
                <TransformGroup>
                    <RotateTransform x:Name="DoorRotation" CenterX="40" CenterY="20" Angle="0"/>
                    <TranslateTransform x:Name="DoorTranslate" X="0" Y="0"/>
                </TransformGroup>
            </Path.RenderTransform>
            <Path.Effect>
                <DropShadowEffect Color="Black" BlurRadius="2" ShadowDepth="1" Opacity="0.4"/>
            </Path.Effect>
        </Path>

        <!-- Dust Outlet -->
        <Path x:Name="DustOutlet"
              Data="{StaticResource DustOutletGeometry}"
              Fill="#333333" Stroke="#666666" StrokeThickness="1.5"
              Canvas.Left="58" Canvas.Top="10"
              Width="24" Height="24">
            <Path.Effect>
                <DropShadowEffect Color="Black" BlurRadius="2" ShadowDepth="1" Opacity="0.5"/>
            </Path.Effect>
        </Path>

        <!-- Outlet Flange -->
        <Path x:Name="OutletFlange"
              Data="{StaticResource OutletFlangeGeometry}"
              Fill="{StaticResource FlangeBrush}"
              Stroke="#666666" StrokeThickness="2"
              Canvas.Left="50" Canvas.Top="220"
              Width="40" Height="15">
            <Path.Effect>
                <DropShadowEffect Color="Black" BlurRadius="2" ShadowDepth="1" Opacity="0.5"/>
            </Path.Effect>
        </Path>

        <!-- Fill Level -->
        <Path x:Name="FillPath"
              Data="{StaticResource BinBodyGeometry}"
              Fill="{StaticResource CarbonFillBrush}"
              Visibility="Collapsed"
              Canvas.Left="5" Canvas.Top="10"
              Width="130" Height="200"
              RenderTransformOrigin="0.5,0.5">
            <Path.RenderTransform>
                <ScaleTransform x:Name="FillScale" ScaleX="1" ScaleY="0"/>
            </Path.RenderTransform>
            <Path.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="3" ShadowDepth="0" Opacity="0.5"/>
            </Path.Effect>
        </Path>

        <!-- Dust Outlet Flange -->
        <Ellipse x:Name="DustFlange"
                 Width="28" Height="28"
                 Stroke="#666666" StrokeThickness="2"
                 Fill="#333333"
                 Canvas.Left="56" Canvas.Top="8"
                 Visibility="Collapsed">
            <Ellipse.Effect>
                <DropShadowEffect Color="Black" BlurRadius="2" ShadowDepth="1" Opacity="0.5"/>
            </Ellipse.Effect>
        </Ellipse>

        <!-- Sensors -->
        <Ellipse x:Name="HighLevelSensor"
                 Style="{StaticResource SensorLightStyle}"
                 Canvas.Left="10" Canvas.Top="30"
                 Visibility="Collapsed"
                 ToolTip="High Level"/>

        <Ellipse x:Name="LowLevelSensor"
                 Style="{StaticResource SensorLightStyle}"
                 Canvas.Left="10" Canvas.Top="180"
                 Visibility="Collapsed"
                 ToolTip="Low Level"/>

        <!-- Status Light -->
        <Ellipse x:Name="StatusLight"
                 Width="14" Height="14"
                 HorizontalAlignment="Right" VerticalAlignment="Top"
                 Margin="0,8,8,0" Stroke="#444444" StrokeThickness="2">
            <Ellipse.Fill>
                <RadialGradientBrush Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5" GradientOrigin="0.5,0.5">
                    <GradientStop Color="#404040" Offset="0.0"/>
                    <GradientStop Color="#202020" Offset="1.0"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <!-- Anchor Points -->
        <ItemsControl x:Name="AnchorsControl" Visibility="Collapsed">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas x:Name="AnchorsCanvas" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Ellipse Style="{StaticResource AnchorPointStyle}"
                             Fill="{Binding IsConnected, Converter={StaticResource BoolToConnectedBrushConverter}}"
                             ToolTip="{Binding Name}"
                             Tag="{Binding}">
                        <Ellipse.RenderTransform>
                            <TranslateTransform X="-7" Y="-7" />
                        </Ellipse.RenderTransform>
                    </Ellipse>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="Canvas.Left" Value="{Binding Position.X, Converter={StaticResource PointToCanvasLeftConverter}}"/>
                    <Setter Property="Canvas.Top" Value="{Binding Position.Y, Converter={StaticResource PointToCanvasTopConverter}}"/>
                </Style>
            </ItemsControl.ItemContainerStyle>
        </ItemsControl>

        <!-- Selection Border -->
        <Border x:Name="SelectionBorder" Style="{StaticResource SelectionBorderStyle}" Visibility="Collapsed"/>
    </Grid>
</local:BaseEquipmentControl>


