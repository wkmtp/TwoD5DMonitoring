<local:BaseEquipmentControl x:Class="TwoD5DMonitoring.Controls.Equipment.MixerControl"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:local="clr-namespace:TwoD5DMonitoring.Controls"
              xmlns:models="clr-namespace:TwoD5DMonitoring.Models"
              xmlns:conv="clr-namespace:TwoD5DMonitoring.Converters">

<local:BaseEquipmentControl.Resources>
        <conv:EquipmentStateToColorConverter x:Key="StateToColorConverter" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <conv:BoolToConnectedBrushConverter x:Key="BoolToConnectedBrushConverter" />
        <conv:PointToCanvasLeftConverter x:Key="PointToCanvasLeftConverter" />
        <conv:PointToCanvasTopConverter x:Key="PointToCanvasTopConverter" />

        <!-- Mixer Body (Double Cone / Banbury) -->
        <PathGeometry x:Key="MixerBodyGeometry">
            <PathFigure StartPoint="0,0" IsClosed="True">
                <LineSegment Point="300,0"/>
                <LineSegment Point="280,30"/>
                <LineSegment Point="280,120"/>
                <LineSegment Point="300,150"/>
                <LineSegment Point="0,150"/>
                <LineSegment Point="20,120"/>
                <LineSegment Point="20,30"/>
            </PathFigure>
        </PathGeometry>

        <!-- Top Cover -->
        <PathGeometry x:Key="TopCoverGeometry">
            <PathFigure StartPoint="20,0" IsClosed="True">
                <LineSegment Point="280,0"/>
                <LineSegment Point="270,30"/>
                <LineSegment Point="30,30"/>
            </PathFigure>
        </PathGeometry>

        <!-- Feed Door (Top Left) -->
        <PathGeometry x:Key="FeedDoorGeometry">
            <PathFigure StartPoint="30,0" IsClosed="True">
                <LineSegment Point="120,0"/>
                <LineSegment Point="120,40"/>
                <LineSegment Point="30,40"/>
            </PathFigure>
        </PathGeometry>

        <!-- Discharge Door (Bottom Right) -->
        <PathGeometry x:Key="DischargeDoorGeometry">
            <PathFigure StartPoint="180,110" IsClosed="True">
                <LineSegment Point="270,110"/>
                <LineSegment Point="270,150"/>
                <LineSegment Point="180,150"/>
            </PathFigure>
        </PathGeometry>

        <!-- Rotor 1 (Left) -->
        <PathGeometry x:Key="Rotor1Geometry">
            <PathFigure StartPoint="0,0" IsClosed="True">
                <LineSegment Point="60,0"/>
                <BezierSegment Point1="75,-15" Point2="75,15" Point3="60,30"/>
                <LineSegment Point="0,30"/>
                <BezierSegment Point1="-15,15" Point2="-15,-15" Point3="0,0"/>
            </PathFigure>
        </PathGeometry>

        <!-- Rotor 2 (Right) -->
        <PathGeometry x:Key="Rotor2Geometry">
            <PathFigure StartPoint="0,0" IsClosed="True">
                <LineSegment Point="60,0"/>
                <BezierSegment Point1="75,-15" Point2="75,15" Point3="60,30"/>
                <LineSegment Point="0,30"/>
                <BezierSegment Point1="-15,15" Point2="-15,-15" Point3="0,0"/>
            </PathFigure>
        </PathGeometry>

        <!-- Drive Motor -->
        <PathGeometry x:Key="MotorGeometry">
            <PathFigure StartPoint="0,0" IsClosed="True">
                <LineSegment Point="100,0"/>
                <LineSegment Point="100,70"/>
                <LineSegment Point="0,70"/>
            </PathFigure>
        </PathGeometry>

        <!-- Gearbox -->
        <PathGeometry x:Key="GearboxGeometry">
            <PathFigure StartPoint="0,0" IsClosed="True">
                <LineSegment Point="80,0"/>
                <LineSegment Point="80,50"/>
                <LineSegment Point="0,50"/>
            </PathFigure>
        </PathGeometry>

        <!-- Temperature/Pressure Gauges -->
        <EllipseGeometry x:Key="GaugeGeometry" Center="0,0" RadiusX="20" RadiusY="20"/>

        <!-- Mixer Body Brush -->
        <LinearGradientBrush x:Key="MixerBodyBrush" StartPoint="0,0" EndPoint="1,0" MappingMode="RelativeToBoundingBox">
            <GradientStop Color="#4A4A4A" Offset="0.0"/>
            <GradientStop Color="#333333" Offset="0.5"/>
            <GradientStop Color="#222222" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Top Cover Brush -->
        <LinearGradientBrush x:Key="TopCoverBrush" StartPoint="0.5,0" EndPoint="0.5,1" MappingMode="RelativeToBoundingBox">
            <GradientStop Color="#5A5A5A" Offset="0.0"/>
            <GradientStop Color="#3A3A3A" Offset="0.5"/>
            <GradientStop Color="#2A2A2A" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Rotor Brush -->
        <RadialGradientBrush x:Key="RotorBrush" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5" GradientOrigin="0.3,0.3">
            <GradientStop Color="#3A3A3A" Offset="0.0"/>
            <GradientStop Color="#222222" Offset="0.7"/>
            <GradientStop Color="#121212" Offset="1.0"/>
        </RadialGradientBrush>

        <!-- Motor Brush -->
        <LinearGradientBrush x:Key="MotorBrush" StartPoint="0,0" EndPoint="1,0" MappingMode="RelativeToBoundingBox">
            <GradientStop Color="#5A5A5A" Offset="0.0"/>
            <GradientStop Color="#3A3A3A" Offset="0.5"/>
            <GradientStop Color="#2A2A2A" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Gearbox Brush -->
        <LinearGradientBrush x:Key="GearboxBrush" StartPoint="0,0" EndPoint="1,0" MappingMode="RelativeToBoundingBox">
            <GradientStop Color="#4A4A4A" Offset="0.0"/>
            <GradientStop Color="#333333" Offset="0.5"/>
            <GradientStop Color="#222222" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Door Brush -->
        <LinearGradientBrush x:Key="DoorBrush" StartPoint="0,0" EndPoint="0,1" MappingMode="RelativeToBoundingBox">
            <GradientStop Color="#5A5A5A" Offset="0.0"/>
            <GradientStop Color="#3A3A3A" Offset="0.5"/>
            <GradientStop Color="#2A2A2A" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Gauge Brush -->
        <RadialGradientBrush x:Key="GaugeBrush" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5" GradientOrigin="0.3,0.3">
            <GradientStop Color="#1A1A1A" Offset="0.0"/>
            <GradientStop Color="#0A0A0A" Offset="0.5"/>
            <GradientStop Color="#050505" Offset="1.0"/>
        </RadialGradientBrush>

        <!-- Temperature Gauge Needle -->
        <PathGeometry x:Key="TempNeedleGeometry">
            <PathFigure StartPoint="0,0" IsClosed="True">
                <LineSegment Point="3,0"/>
                <LineSegment Point="0,-18"/>
                <LineSegment Point="-3,0"/>
            </PathFigure>
        </PathGeometry>

        <!-- Pressure Gauge Needle -->
        <PathGeometry x:Key="PressureNeedleGeometry">
            <PathFigure StartPoint="0,0" IsClosed="True">
                <LineSegment Point="3,0"/>
                <LineSegment Point="0,-18"/>
                <LineSegment Point="-3,0"/>
            </PathFigure>
        </PathGeometry>

        <!-- Door Style -->
        <Style x:Key="DoorStyle" TargetType="Path">
            <Setter Property="Stroke" Value="#666666"/>
            <Setter Property="StrokeThickness" Value="2"/>
        </Style>

        <!-- Indicator Light Style -->
        <Style x:Key="IndicatorLightStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="Stroke" Value="#444444"/>
            <Setter Property="StrokeThickness" Value="2"/>
        </Style>

        <!-- Rotor Animation (Counter-rotating) -->
        <Storyboard x:Key="Rotor1Animation" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="Rotor1Rotation"
                             Storyboard.TargetProperty="Angle"
                             From="0" To="360"
                             Duration="0:0:2"/>
        </Storyboard>

        <Storyboard x:Key="Rotor2Animation" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="Rotor2Rotation"
                             Storyboard.TargetProperty="Angle"
                             From="180" To="540"
                             Duration="0:0:2"/>
        </Storyboard>

        <!-- Door Animations -->
        <Storyboard x:Key="FeedDoorOpenAnimation">
            <DoubleAnimation Storyboard.TargetName="FeedDoorRotation"
                             Storyboard.TargetProperty="Angle"
                             From="0" To="-90"
                             Duration="0:0:1.5">
                <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Storyboard x:Key="FeedDoorCloseAnimation">
            <DoubleAnimation Storyboard.TargetName="FeedDoorRotation"
                             Storyboard.TargetProperty="Angle"
                             From="-90" To="0"
                             Duration="0:0:1.5">
                <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Storyboard x:Key="DischargeDoorOpenAnimation">
            <DoubleAnimation Storyboard.TargetName="DischargeDoorRotation"
                             Storyboard.TargetProperty="Angle"
                             From="0" To="90"
                             Duration="0:0:1.5">
                <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Storyboard x:Key="DischargeDoorCloseAnimation">
            <DoubleAnimation Storyboard.TargetName="DischargeDoorRotation"
                             Storyboard.TargetProperty="Angle"
                             From="90" To="0"
                             Duration="0:0:1.5">
                <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </local:BaseEquipmentControl.Resources>

    <Grid x:Name="RootGrid" Width="300" Height="200" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <TransformGroup>
                <RotateTransform x:Name="RotationTransform" Angle="0" CenterX="150" CenterY="100"/>
                <ScaleTransform x:Name="ScaleTransform" ScaleX="1" ScaleY="1"/>
            </TransformGroup>
        </Grid.RenderTransform>

        <!-- Shadow -->
        <Ellipse Fill="#40000000" Width="260" Height="8" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-4" Opacity="0.3" IsHitTestVisible="False">
            <Ellipse.Effect>
                <BlurEffect Radius="4"/>
            </Ellipse.Effect>
        </Ellipse>

        <!-- Mixer Body -->
        <Path x:Name="MixerBody"
              Data="{StaticResource MixerBodyGeometry}"
              Fill="{StaticResource MixerBodyBrush}"
              Stroke="#555555" StrokeThickness="1.5">
            <Path.Effect>
                <DropShadowEffect Color="Black" BlurRadius="4" ShadowDepth="2" Opacity="0.5" Direction="270"/>
            </Path.Effect>
        </Path>

        <!-- Top Cover -->
        <Path x:Name="TopCover"
              Data="{StaticResource TopCoverGeometry}"
              Fill="{StaticResource TopCoverBrush}"
              Stroke="#555555" StrokeThickness="1.5"
              Canvas.Top="0">
            <Path.Effect>
                <DropShadowEffect Color="Black" BlurRadius="2" ShadowDepth="1" Opacity="0.4"/>
            </Path.Effect>
        </Path>

        <!-- Feed Door (Top Left) -->
        <Path x:Name="FeedDoor"
              Data="{StaticResource FeedDoorGeometry}"
              Fill="{StaticResource DoorBrush}"
              Stroke="#666666" StrokeThickness="2"
              Canvas.Left="30" Canvas.Top="0"
              Width="90" Height="40"
              RenderTransformOrigin="0.5,0">
            <Path.RenderTransform>
                <RotateTransform x:Name="FeedDoorRotation" CenterX="45" CenterY="0" Angle="0"/>
            </Path.RenderTransform>
            <Path.Effect>
                <DropShadowEffect Color="Black" BlurRadius="2" ShadowDepth="1" Opacity="0.4"/>
            </Path.Effect>
        </Path>

        <!-- Discharge Door (Bottom Right) -->
        <Path x:Name="DischargeDoor"
              Data="{StaticResource DischargeDoorGeometry}"
              Fill="{StaticResource DoorBrush}"
              Stroke="#666666" StrokeThickness="2"
              Canvas.Left="180" Canvas.Top="110"
              Width="90" Height="40"
              RenderTransformOrigin="0.5,1">
            <Path.RenderTransform>
                <RotateTransform x:Name="DischargeDoorRotation" CenterX="45" CenterY="40" Angle="0"/>
            </Path.RenderTransform>
            <Path.Effect>
                <DropShadowEffect Color="Black" BlurRadius="2" ShadowDepth="1" Opacity="0.4"/>
            </Path.Effect>
        </Path>

        <!-- Rotor 1 (Left) -->
        <Path x:Name="Rotor1"
              Data="{StaticResource Rotor1Geometry}"
              Fill="{StaticResource RotorBrush}"
              Canvas.Left="50" Canvas.Top="50"
              Width="60" Height="30"
              RenderTransformOrigin="0.5,0.5">
            <Path.RenderTransform>
                <RotateTransform x:Name="Rotor1Rotation" CenterX="30" CenterY="15" Angle="0"/>
            </Path.RenderTransform>
            <Path.Effect>
                <DropShadowEffect Color="Black" BlurRadius="3" ShadowDepth="1" Opacity="0.5"/>
            </Path.Effect>
        </Path>

        <!-- Rotor 2 (Right) -->
        <Path x:Name="Rotor2"
              Data="{StaticResource Rotor2Geometry}"
              Fill="{StaticResource RotorBrush}"
              Canvas.Left="190" Canvas.Top="50"
              Width="60" Height="30"
              RenderTransformOrigin="0.5,0.5">
            <Path.RenderTransform>
                <RotateTransform x:Name="Rotor2Rotation" CenterX="30" CenterY="15" Angle="180"/>
            </Path.RenderTransform>
            <Path.Effect>
                <DropShadowEffect Color="Black" BlurRadius="3" ShadowDepth="1" Opacity="0.5"/>
            </Path.Effect>
        </Path>

        <!-- Drive Motor -->
        <Path x:Name="Motor"
              Data="{StaticResource MotorGeometry}"
              Fill="{StaticResource MotorBrush}"
              Stroke="#555555" StrokeThickness="1.5"
              Canvas.Left="320" Canvas.Top="50"
              Width="100" Height="70">
            <Path.Effect>
                <DropShadowEffect Color="Black" BlurRadius="3" ShadowDepth="2" Opacity="0.5" Direction="270"/>
            </Path.Effect>
        </Path>

        <!-- Gearbox -->
        <Path x:Name="Gearbox"
              Data="{StaticResource GearboxGeometry}"
              Fill="{StaticResource GearboxBrush}"
              Stroke="#555555" StrokeThickness="1.5"
              Canvas.Left="240" Canvas.Top="65"
              Width="80" Height="50">
            <Path.Effect>
                <DropShadowEffect Color="Black" BlurRadius="2" ShadowDepth="1" Opacity="0.4"/>
            </Path.Effect>
        </Path>

        <!-- Temperature Gauge -->
        <Ellipse x:Name="TempGauge"
                 Width="40" Height="40"
                 Fill="{StaticResource GaugeBrush}"
                 Stroke="#333333" StrokeThickness="2"
                 Canvas.Left="10" Canvas.Top="150">
            <Ellipse.Effect>
                <DropShadowEffect Color="Black" BlurRadius="2" ShadowDepth="1" Opacity="0.5"/>
            </Ellipse.Effect>
            <Ellipse.RenderTransform>
                <TranslateTransform X="20" Y="20"/>
            </Ellipse.RenderTransform>
        </Ellipse>

        <!-- Temp Gauge Needle -->
        <Path x:Name="TempNeedle"
              Data="{StaticResource TempNeedleGeometry}"
              Fill="#FF4444"
              Canvas.Left="30" Canvas.Top="170"
              Width="6" Height="18"
              RenderTransformOrigin="0.5,1">
            <Path.RenderTransform>
                <RotateTransform x:Name="TempNeedleRotation" CenterX="3" CenterY="18" Angle="-90"/>
            </Path.RenderTransform>
        </Path>

        <!-- Pressure Gauge -->
        <Ellipse x:Name="PressureGauge"
                 Width="40" Height="40"
                 Fill="{StaticResource GaugeBrush}"
                 Stroke="#333333" StrokeThickness="2"
                 Canvas.Left="250" Canvas.Top="150">
            <Ellipse.Effect>
                <DropShadowEffect Color="Black" BlurRadius="2" ShadowDepth="1" Opacity="0.5"/>
            </Ellipse.Effect>
            <Ellipse.RenderTransform>
                <TranslateTransform X="20" Y="20"/>
            </Ellipse.RenderTransform>
        </Ellipse>

        <!-- Pressure Gauge Needle -->
        <Path x:Name="PressureNeedle"
              Data="{StaticResource PressureNeedleGeometry}"
              Fill="#FF4444"
              Canvas.Left="270" Canvas.Top="170"
              Width="6" Height="18"
              RenderTransformOrigin="0.5,1">
            <Path.RenderTransform>
                <RotateTransform x:Name="PressureNeedleRotation" CenterX="3" CenterY="18" Angle="-90"/>
            </Path.RenderTransform>
        </Path>

        <!-- Status Light -->
        <Ellipse x:Name="StatusLight"
                 Width="14" Height="14"
                 HorizontalAlignment="Right" VerticalAlignment="Top"
                 Margin="0,8,8,0" Stroke="#444444" StrokeThickness="2">
            <Ellipse.Fill>
                <RadialGradientBrush Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5" GradientOrigin="0.5,0.5">
                    <GradientStop Color="#404040" Offset="0.0"/>
                    <GradientStop Color="#202020" Offset="1.0"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <!-- Parameter Panel (Collapsible) -->
        <Border x:Name="ParameterPanel"
                Background="#20000000"
                BorderBrush="#666666" BorderThickness="1"
                CornerRadius="4"
                Padding="8"
                Visibility="Collapsed"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,8,8,0" Width="160">
            <StackPanel>
                <TextBlock Text="密炼机参数" FontSize="12" FontWeight="Bold" Foreground="#FFD700" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal" Margin="0,2">
                    <TextBlock Text="温度:" FontSize="11" Foreground="#CCCCCC" Width="60"/>
                    <TextBlock x:Name="TempValue" Text="0.0 °C" FontSize="11" Foreground="#CCCCCC" FontFamily="Consolas"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2">
                    <TextBlock Text="压力:" FontSize="11" Foreground="#CCCCCC" Width="60"/>
                    <TextBlock x:Name="PressureValue" Text="0.0 MPa" FontSize="11" Foreground="#CCCCCC" FontFamily="Consolas"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2">
                    <TextBlock Text="转速:" FontSize="11" Foreground="#CCCCCC" Width="60"/>
                    <TextBlock x:Name="SpeedValue" Text="0 rpm" FontSize="11" Foreground="#CCCCCC" FontFamily="Consolas"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2">
                    <TextBlock Text="功率:" FontSize="11" Foreground="#CCCCCC" Width="60"/>
                    <TextBlock x:Name="PowerValue" Text="0.0 kW" FontSize="11" Foreground="#CCCCCC" FontFamily="Consolas"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2">
                    <TextBlock Text="能耗:" FontSize="11" Foreground="#CCCCCC" Width="60"/>
                    <TextBlock x:Name="EnergyValue" Text="0.0 kWh" FontSize="11" Foreground="#CCCCCC" FontFamily="Consolas"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Anchor Points -->
        <ItemsControl x:Name="AnchorsControl" Visibility="Collapsed">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas x:Name="AnchorsCanvas" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Ellipse Style="{StaticResource AnchorPointStyle}"
                             Fill="{Binding IsConnected, Converter={StaticResource BoolToConnectedBrushConverter}}"
                             ToolTip="{Binding Name}"
                             Tag="{Binding}">
                        <Ellipse.RenderTransform>
                            <TranslateTransform X="-7" Y="-7" />
                        </Ellipse.RenderTransform>
                    </Ellipse>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="Canvas.Left" Value="{Binding Position.X, Converter={StaticResource PointToCanvasLeftConverter}}"/>
                    <Setter Property="Canvas.Top" Value="{Binding Position.Y, Converter={StaticResource PointToCanvasTopConverter}}"/>
                </Style>
            </ItemsControl.ItemContainerStyle>
        </ItemsControl>

        <!-- Selection Border -->
        <Border x:Name="SelectionBorder" Style="{StaticResource SelectionBorderStyle}" Visibility="Collapsed"/>
    </Grid>
</local:BaseEquipmentControl>
