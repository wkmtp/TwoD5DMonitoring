<local:BaseEquipmentControl x:Class="TwoD5DMonitoring.Controls.Equipment.PipeReducerControl"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:local="clr-namespace:TwoD5DMonitoring.Controls"
              xmlns:models="clr-namespace:TwoD5DMonitoring.Models"
              xmlns:conv="clr-namespace:TwoD5DMonitoring.Converters">

    <local:BaseEquipmentControl.Resources>
        <conv:EquipmentStateToColorConverter x:Key="StateToColorConverter" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <conv:BoolToConnectedBrushConverter x:Key="BoolToConnectedBrushConverter" />
        <conv:PointToCanvasLeftConverter x:Key="PointToCanvasLeftConverter" />
        <conv:PointToCanvasTopConverter x:Key="PointToCanvasTopConverter" />

        <!-- Reducer Geometry (Concentric) -->
        <PathGeometry x:Key="ConcentricReducerGeometry">
            <PathFigure StartPoint="0,0" IsClosed="True">
                <LineSegment Point="150,0"/>
                <LineSegment Point="150,30"/>
                <LineSegment Point="100,80"/>
                <LineSegment Point="100,110"/>
                <LineSegment Point="0,110"/>
                <LineSegment Point="0,80"/>
                <LineSegment Point="50,30"/>
                <LineSegment Point="50,0"/>
            </PathFigure>
        </PathGeometry>

        <!-- Reducer Geometry (Eccentric) -->
        <PathGeometry x:Key="EccentricReducerGeometry">
            <PathFigure StartPoint="0,0" IsClosed="True">
                <LineSegment Point="150,0"/>
                <LineSegment Point="150,30"/>
                <LineSegment Point="100,110"/>
                <LineSegment Point="0,110"/>
            </PathFigure>
        </PathGeometry>

        <!-- Flange Geometry -->
        <PathGeometry x:Key="FlangeGeometry">
            <PathFigure StartPoint="0,0" IsClosed="True">
                <LineSegment Point="20,0"/>
                <LineSegment Point="20,15"/>
                <LineSegment Point="0,15"/>
            </PathFigure>
        </PathGeometry>

        <!-- Reducer Body Brush -->
        <LinearGradientBrush x:Key="ReducerBodyBrush" StartPoint="0,0" EndPoint="1,0" MappingMode="RelativeToBoundingBox">
            <GradientStop Color="#4A4A4A" Offset="0.0"/>
            <GradientStop Color="#333333" Offset="0.5"/>
            <GradientStop Color="#222222" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Flange Brush -->
        <LinearGradientBrush x:Key="FlangeBrush" StartPoint="0,0" EndPoint="1,0" MappingMode="RelativeToBoundingBox">
            <GradientStop Color="#5A5A5A" Offset="0.0"/>
            <GradientStop Color="#3A3A3A" Offset="0.5"/>
            <GradientStop Color="#2A2A2A" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Valve Style -->
        <Style x:Key="ValveStyle" TargetType="Path">
            <Setter Property="Stroke" Value="#666666"/>
            <Setter Property="StrokeThickness" Value="2"/>
        </Style>

        <!-- Indicator Light Style -->
        <Style x:Key="IndicatorLightStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Height" Value="12"/>
            <Setter Property="Stroke" Value="#444444"/>
            <Setter Property="StrokeThickness" Value="2"/>
        </Style>
    </local:BaseEquipmentControl.Resources>

    <Grid x:Name="RootGrid" Width="150" Height="110" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <TransformGroup>
                <RotateTransform x:Name="RotationTransform" Angle="0" CenterX="75" CenterY="55"/>
                <ScaleTransform x:Name="ScaleTransform" ScaleX="1" ScaleY="1"/>
            </TransformGroup>
        </Grid.RenderTransform>

        <!-- Shadow -->
        <Ellipse Fill="#40000000" Width="120" Height="8" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-4" Opacity="0.3" IsHitTestVisible="False">
            <Ellipse.Effect>
                <BlurEffect Radius="4"/>
            </Ellipse.Effect>
        </Ellipse>

        <!-- Reducer Body (Concentric) -->
        <Path x:Name="ConcentricReducer"
              Data="{StaticResource ConcentricReducerGeometry}"
              Fill="{StaticResource ReducerBodyBrush}"
              Stroke="#555555" StrokeThickness="1.5"
              Visibility="Visible">
            <Path.Effect>
                <DropShadowEffect Color="Black" BlurRadius="4" ShadowDepth="2" Opacity="0.5" Direction="270"/>
            </Path.Effect>
        </Path>

        <!-- Reducer Body (Eccentric) -->
        <Path x:Name="EccentricReducer"
              Data="{StaticResource EccentricReducerGeometry}"
              Fill="{StaticResource ReducerBodyBrush}"
              Stroke="#555555" StrokeThickness="1.5"
              Visibility="Collapsed">
            <Path.Effect>
                <DropShadowEffect Color="Black" BlurRadius="4" ShadowDepth="2" Opacity="0.5" Direction="270"/>
            </Path.Effect>
        </Path>

        <!-- Inlet Flange -->
        <Path x:Name="InletFlange"
              Data="{StaticResource FlangeGeometry}"
              Fill="{StaticResource FlangeBrush}"
              Stroke="#666666" StrokeThickness="2"
              Canvas.Left="0" Canvas.Top="30"
              Width="20" Height="50">
            <Path.RenderTransform>
                <TranslateTransform X="0" Y="30"/>
            </Path.RenderTransform>
            <Path.Effect>
                <DropShadowEffect Color="Black" BlurRadius="2" ShadowDepth="1" Opacity="0.5"/>
            </Path.Effect>
        </Path>

        <!-- Outlet Flange -->
        <Path x:Name="OutletFlange"
              Data="{StaticResource FlangeGeometry}"
              Fill="{StaticResource FlangeBrush}"
              Stroke="#666666" StrokeThickness="2"
              Canvas.Left="130" Canvas.Top="55"
              Width="20" Height="30">
            <Path.RenderTransform>
                <TranslateTransform X="0" Y="55"/>
            </Path.RenderTransform>
            <Path.Effect>
                <DropShadowEffect Color="Black" BlurRadius="2" ShadowDepth="1" Opacity="0.5"/>
            </Path.Effect>
        </Path>

        <!-- Status Light -->
        <Ellipse x:Name="StatusLight"
                 Width="12" Height="12"
                 HorizontalAlignment="Right" VerticalAlignment="Top"
                 Margin="0,8,8,0" Stroke="#444444" StrokeThickness="2">
            <Ellipse.Fill>
                <RadialGradientBrush Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5" GradientOrigin="0.5,0.5">
                    <GradientStop Color="#404040" Offset="0.0"/>
                    <GradientStop Color="#202020" Offset="1.0"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <!-- Anchor Points -->
        <ItemsControl x:Name="AnchorsControl" Visibility="Collapsed">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas x:Name="AnchorsCanvas" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Ellipse Style="{StaticResource AnchorPointStyle}"
                             Fill="{Binding IsConnected, Converter={StaticResource BoolToConnectedBrushConverter}}"
                             ToolTip="{Binding Name}"
                             Tag="{Binding}">
                        <Ellipse.RenderTransform>
                            <TranslateTransform X="-7" Y="-7" />
                        </Ellipse.RenderTransform>
                    </Ellipse>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="Canvas.Left" Value="{Binding Position.X, Converter={StaticResource PointToCanvasLeftConverter}}"/>
                    <Setter Property="Canvas.Top" Value="{Binding Position.Y, Converter={StaticResource PointToCanvasTopConverter}}"/>
                </Style>
            </ItemsControl.ItemContainerStyle>
        </ItemsControl>

        <!-- Selection Border -->
        <Border x:Name="SelectionBorder" Style="{StaticResource SelectionBorderStyle}" Visibility="Collapsed"/>
    </Grid>
</local:BaseEquipmentControl>
