<local:BaseEquipmentControl x:Class="TwoD5DMonitoring.Controls.Equipment.PressurizedTankControl"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:local="clr-namespace:TwoD5DMonitoring.Controls"
              xmlns:models="clr-namespace:TwoD5DMonitoring.Models"
              xmlns:conv="clr-namespace:TwoD5DMonitoring.Converters">

    <local:BaseEquipmentControl.Resources>
        <conv:EquipmentStateToColorConverter x:Key="StateToColorConverter" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <conv:BoolToConnectedBrushConverter x:Key="BoolToConnectedBrushConverter" />
        <conv:DiameterToShadowThicknessConverter x:Key="DiameterToShadowThicknessConverter" />
        <conv:PointToCanvasLeftConverter x:Key="PointToCanvasLeftConverter" />
        <conv:PointToCanvasTopConverter x:Key="PointToCanvasTopConverter" />

        <!-- Cylinder + Cone Geometry -->
        <PathGeometry x:Key="CylinderGeometry">
            <PathFigure StartPoint="0,0" IsClosed="True">
                <LineSegment Point="120,0"/>
                <LineSegment Point="120,120"/>
                <LineSegment Point="0,120"/>
            </PathFigure>
        </PathGeometry>

        <PathGeometry x:Key="ConeGeometry">
            <PathFigure StartPoint="15,120" IsClosed="True">
                <LineSegment Point="105,120"/>
                <LineSegment Point="60,200"/>
            </PathFigure>
        </PathGeometry>

        <!-- Inlet Valve Geometry -->
        <PathGeometry x:Key="InletValveGeometry">
            <PathFigure StartPoint="0,0" IsClosed="True">
                <LineSegment Point="20,0"/>
                <LineSegment Point="20,-15"/>
                <LineSegment Point="10,-15"/>
                <LineSegment Point="10,-25"/>
                <LineSegment Point="0,-15"/>
            </PathFigure>
        </PathGeometry>

        <!-- Outlet Valve Geometry -->
        <PathGeometry x:Key="OutletValveGeometry">
            <PathFigure StartPoint="0,0" IsClosed="True">
                <LineSegment Point="20,0"/>
                <LineSegment Point="20,15"/>
                <LineSegment Point="10,15"/>
                <LineSegment Point="10,25"/>
                <LineSegment Point="0,15"/>
            </PathFigure>
        </PathGeometry>

        <!-- Dust Outlet Geometry -->
        <PathGeometry x:Key="DustOutletGeometry">
            <PathFigure StartPoint="0,0" IsClosed="True">
                <LineSegment Point="18,0"/>
                <LineSegment Point="18,-20"/>
                <LineSegment Point="0,-20"/>
            </PathFigure>
        </PathGeometry>

        <!-- Carbon Fill Brush -->
        <LinearGradientBrush x:Key="CarbonFillBrush" StartPoint="0.5,1" EndPoint="0.5,0" MappingMode="RelativeToBoundingBox">
            <GradientStop Color="#101010" Offset="0.0"/>
            <GradientStop Color="#1A1A1A" Offset="0.3"/>
            <GradientStop Color="#151515" Offset="0.7"/>
            <GradientStop Color="#0A0A0A" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Tank Body Brush -->
        <LinearGradientBrush x:Key="TankBodyBrush" StartPoint="0,0" EndPoint="1,0" MappingMode="RelativeToBoundingBox">
            <GradientStop Color="#4A4A4A" Offset="0.0"/>
            <GradientStop Color="#333333" Offset="0.3"/>
            <GradientStop Color="#222222" Offset="0.6"/>
            <GradientStop Color="#333333" Offset="0.8"/>
            <GradientStop Color="#4A4A4A" Offset="1.0"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ConeBrush" StartPoint="0.5,0" EndPoint="0.5,1" MappingMode="RelativeToBoundingBox">
            <GradientStop Color="#3A3A3A" Offset="0.0"/>
            <GradientStop Color="#222222" Offset="0.5"/>
            <GradientStop Color="#121212" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Valve Style -->
        <Style x:Key="ValveStyle" TargetType="Path">
            <Setter Property="Stroke" Value="#666666"/>
            <Setter Property="StrokeThickness" Value="2"/>
        </Style>

        <!-- Sensor Light Style -->
        <Style x:Key="SensorLightStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Height" Value="10"/>
            <Setter Property="Stroke" Value="#444444"/>
            <Setter Property="StrokeThickness" Value="1.5"/>
        </Style>
    </local:BaseEquipmentControl.Resources>

    <Grid x:Name="RootGrid" Width="120" Height="220" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <TransformGroup>
                <RotateTransform x:Name="RotationTransform" Angle="0" CenterX="60" CenterY="110"/>
                <ScaleTransform x:Name="ScaleTransform" ScaleX="1" ScaleY="1"/>
            </TransformGroup>
        </Grid.RenderTransform>

        <!-- Shadow -->
        <Ellipse Fill="#40000000" Width="100" Height="8" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-4" Opacity="0.3" IsHitTestVisible="False">
            <Ellipse.Effect>
                <BlurEffect Radius="4"/>
            </Ellipse.Effect>
        </Ellipse>

        <!-- Cylinder -->
        <Path x:Name="Cylinder"
              Data="{StaticResource CylinderGeometry}"
              Fill="{StaticResource TankBodyBrush}"
              Stroke="#555555" StrokeThickness="1.5">
            <Path.Effect>
                <DropShadowEffect Color="Black" BlurRadius="4" ShadowDepth="2" Opacity="0.5" Direction="270"/>
            </Path.Effect>
        </Path>

        <!-- Cone -->
        <Path x:Name="Cone"
              Data="{StaticResource ConeGeometry}"
              Fill="{StaticResource ConeBrush}"
              Stroke="#555555" StrokeThickness="1.5"
              Canvas.Top="120">
            <Path.Effect>
                <DropShadowEffect Color="Black" BlurRadius="4" ShadowDepth="2" Opacity="0.5" Direction="270"/>
            </Path.Effect>
        </Path>

        <!-- Inlet Valve -->
        <Path x:Name="InletValve"
              Style="{StaticResource ValveStyle}"
              Data="{StaticResource InletValveGeometry}"
              Canvas.Left="50" Canvas.Top="-15"
              Width="20" Height="25"
              Visibility="Collapsed">
            <Path.RenderTransform>
                <RotateTransform x:Name="InletValveRotation" CenterX="10" CenterY="12.5" Angle="0"/>
            </Path.RenderTransform>
        </Path>

        <!-- Outlet Valve -->
        <Path x:Name="OutletValve"
              Style="{StaticResource ValveStyle}"
              Data="{StaticResource OutletValveGeometry}"
              Canvas.Left="50" Canvas.Top="200"
              Width="20" Height="25"
              Visibility="Collapsed">
            <Path.RenderTransform>
                <RotateTransform x:Name="OutletValveRotation" CenterX="10" CenterY="12.5" Angle="180"/>
            </Path.RenderTransform>
        </Path>

        <!-- Dust Outlet -->
        <Path x:Name="DustOutlet"
              Style="{StaticResource ValveStyle}"
              Data="{StaticResource DustOutletGeometry}"
              Canvas.Left="51" Canvas.Top="10"
              Width="18" Height="20"
              Visibility="Collapsed"/>

        <!-- Fill Level -->
        <Path x:Name="FillLevel"
              Data="{StaticResource CylinderGeometry}"
              Fill="{StaticResource CarbonFillBrush}"
              Visibility="Collapsed"
              Canvas.Left="0" Canvas.Top="0"
              Width="120" Height="120"
              RenderTransformOrigin="0.5,0.5">
            <Path.RenderTransform>
                <ScaleTransform x:Name="FillScale" ScaleX="1" ScaleY="0"/>
            </Path.RenderTransform>
            <Path.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="3" ShadowDepth="0" Opacity="0.5"/>
            </Path.Effect>
        </Path>

        <!-- Sensors -->
        <Ellipse x:Name="HighPressureSensor"
                 Style="{StaticResource SensorLightStyle}"
                 Canvas.Left="10" Canvas.Top="30"
                 Visibility="Collapsed"
                 ToolTip="High Pressure"/>

        <Ellipse x:Name="LowPressureSensor"
                 Style="{StaticResource SensorLightStyle}"
                 Canvas.Left="10" Canvas.Top="90"
                 Visibility="Collapsed"
                 ToolTip="Low Pressure"/>

        <Ellipse x:Name="TemperatureSensor"
                 Style="{StaticResource SensorLightStyle}"
                 Canvas.Left="100" Canvas.Top="60"
                 Visibility="Collapsed"
                 ToolTip="Temperature"/>

        <!-- Status Light -->
        <Ellipse x:Name="StatusLight"
                 Width="14" Height="14"
                 HorizontalAlignment="Right" VerticalAlignment="Top"
                 Margin="0,8,8,0" Stroke="#444444" StrokeThickness="2">
            <Ellipse.Fill>
                <RadialGradientBrush Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5" GradientOrigin="0.5,0.5">
                    <GradientStop Color="#404040" Offset="0.0"/>
                    <GradientStop Color="#202020" Offset="1.0"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <!-- Anchor Points -->
        <ItemsControl x:Name="AnchorsControl" Visibility="Collapsed">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Ellipse Style="{StaticResource AnchorPointStyle}"
                             Fill="{Binding IsConnected, Converter={StaticResource BoolToConnectedBrushConverter}}"
                             ToolTip="{Binding Name}"
                             Tag="{Binding}">
                        <Ellipse.RenderTransform>
                            <TranslateTransform X="-7" Y="-7" />
                        </Ellipse.RenderTransform>
                    </Ellipse>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="Canvas.Left" Value="{Binding Position.X, Converter={StaticResource PointToCanvasLeftConverter}}"/>
                    <Setter Property="Canvas.Top" Value="{Binding Position.Y, Converter={StaticResource PointToCanvasTopConverter}}"/>
                </Style>
            </ItemsControl.ItemContainerStyle>
        </ItemsControl>

        <!-- Selection Border -->
        <Border x:Name="SelectionBorder" Style="{StaticResource SelectionBorderStyle}" Visibility="Collapsed"/>
    </Grid>
</local:BaseEquipmentControl>


