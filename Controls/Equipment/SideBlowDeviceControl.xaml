<local:BaseEquipmentControl x:Class="TwoD5DMonitoring.Controls.Equipment.SideBlowDeviceControl"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:local="clr-namespace:TwoD5DMonitoring.Controls"
              xmlns:models="clr-namespace:TwoD5DMonitoring.Models"
              xmlns:conv="clr-namespace:TwoD5DMonitoring.Converters">

    <local:BaseEquipmentControl.Resources>
        <conv:EquipmentStateToColorConverter x:Key="StateToColorConverter" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <conv:BoolToConnectedBrushConverter x:Key="BoolToConnectedBrushConverter" />
        <conv:PointToCanvasLeftConverter x:Key="PointToCanvasLeftConverter" />
        <conv:PointToCanvasTopConverter x:Key="PointToCanvasTopConverter" />

        <!-- Main Pipe Geometry -->
        <PathGeometry x:Key="MainPipeGeometry">
            <PathFigure StartPoint="0,0" IsClosed="True">
                <LineSegment Point="300,0"/>
                <LineSegment Point="300,60"/>
                <LineSegment Point="0,60"/>
            </PathFigure>
        </PathGeometry>

        <!-- Branch Pipe Geometry -->
        <PathGeometry x:Key="BranchPipeGeometry">
            <PathFigure StartPoint="0,0" IsClosed="True">
                <LineSegment Point="80,0"/>
                <LineSegment Point="80,-60"/>
                <LineSegment Point="0,-60"/>
            </PathFigure>
        </PathGeometry>

        <!-- Valve Geometry -->
        <PathGeometry x:Key="ValveGeometry">
            <PathFigure StartPoint="0,0" IsClosed="True">
                <LineSegment Point="50,0"/>
                <LineSegment Point="50,30"/>
                <LineSegment Point="0,30"/>
            </PathFigure>
        </PathGeometry>

        <!-- Main Pipe Brush -->
        <LinearGradientBrush x:Key="MainPipeBrush" StartPoint="0,0" EndPoint="1,0" MappingMode="RelativeToBoundingBox">
            <GradientStop Color="#3A3A3A" Offset="0.0"/>
            <GradientStop Color="#222222" Offset="0.5"/>
            <GradientStop Color="#121212" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Branch Pipe Brush -->
        <LinearGradientBrush x:Key="BranchPipeBrush" StartPoint="0,0" EndPoint="0,1" MappingMode="RelativeToBoundingBox">
            <GradientStop Color="#3A3A3A" Offset="0.0"/>
            <GradientStop Color="#222222" Offset="0.5"/>
            <GradientStop Color="#121212" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Valve Body Brush -->
        <LinearGradientBrush x:Key="ValveBodyBrush" StartPoint="0,0" EndPoint="1,0" MappingMode="RelativeToBoundingBox">
            <GradientStop Color="#4A4A4A" Offset="0.0"/>
            <GradientStop Color="#333333" Offset="0.5"/>
            <GradientStop Color="#222222" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Valve Core Brush -->
        <LinearGradientBrush x:Key="ValveCoreBrush" StartPoint="0,0" EndPoint="0,1" MappingMode="RelativeToBoundingBox">
            <GradientStop Color="#5A5A5A" Offset="0.0"/>
            <GradientStop Color="#3A3A3A" Offset="0.5"/>
            <GradientStop Color="#2A2A2A" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Valve Style -->
        <Style x:Key="ValveStyle" TargetType="Path">
            <Setter Property="Stroke" Value="#666666"/>
            <Setter Property="StrokeThickness" Value="2"/>
        </Style>

        <!-- Indicator Light Style -->
        <Style x:Key="IndicatorLightStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Height" Value="12"/>
            <Setter Property="Stroke" Value="#444444"/>
            <Setter Property="StrokeThickness" Value="2"/>
        </Style>
    </local:BaseEquipmentControl.Resources>

    <Grid x:Name="RootGrid" Width="300" Height="180" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <TransformGroup>
                <RotateTransform x:Name="RotationTransform" Angle="0" CenterX="150" CenterY="90"/>
                <ScaleTransform x:Name="ScaleTransform" ScaleX="1" ScaleY="1"/>
            </TransformGroup>
        </Grid.RenderTransform>

        <!-- Shadow -->
        <Ellipse Fill="#40000000" Width="280" Height="8" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-4" Opacity="0.3" IsHitTestVisible="False">
            <Ellipse.Effect>
                <BlurEffect Radius="4"/>
            </Ellipse.Effect>
        </Ellipse>

        <!-- Main Pipe -->
        <Path x:Name="MainPipe"
              Data="{StaticResource MainPipeGeometry}"
              Fill="{StaticResource MainPipeBrush}"
              Stroke="#555555" StrokeThickness="1.5">
            <Path.Effect>
                <DropShadowEffect Color="Black" BlurRadius="4" ShadowDepth="2" Opacity="0.5" Direction="270"/>
            </Path.Effect>
        </Path>

        <!-- Branch Pipe -->
        <Path x:Name="BranchPipe"
              Data="{StaticResource BranchPipeGeometry}"
              Fill="{StaticResource BranchPipeBrush}"
              Stroke="#555555" StrokeThickness="1.5"
              Canvas.Left="110" Canvas.Top="-60">
            <Path.RenderTransform>
                <RotateTransform x:Name="BranchRotation" CenterX="40" CenterY="60" Angle="45"/>
            </Path.RenderTransform>
            <Path.Effect>
                <DropShadowEffect Color="Black" BlurRadius="3" ShadowDepth="1" Opacity="0.4"/>
            </Path.Effect>
        </Path>

        <!-- Valve Body -->
        <Path x:Name="ValveBody"
              Data="{StaticResource ValveGeometry}"
              Fill="{StaticResource ValveBodyBrush}"
              Stroke="#555555" StrokeThickness="1.5"
              Canvas.Left="110" Canvas.Top="-5">
            <Path.RenderTransform>
                <TranslateTransform X="0" Y="0"/>
            </Path.RenderTransform>
            <Path.Effect>
                <DropShadowEffect Color="Black" BlurRadius="3" ShadowDepth="1" Opacity="0.5" Direction="270"/>
            </Path.Effect>
        </Path>

        <!-- Valve Core -->
        <Path x:Name="ValveCore"
              Data="{StaticResource ValveGeometry}"
              Fill="{StaticResource ValveCoreBrush}"
              Canvas.Left="120" Canvas.Top="5"
              Width="30" Height="20"
              RenderTransformOrigin="0.5,0.5">
            <Path.RenderTransform>
                <TranslateTransform x:Name="ValveCoreTranslate" X="0" Y="0"/>
            </Path.RenderTransform>
        </Path>

        <!-- Branch Flange -->
        <Ellipse x:Name="BranchFlange"
                 Width="80" Height="80"
                 Stroke="#666666" StrokeThickness="2"
                 Fill="#333333"
                 Canvas.Left="110" Canvas.Top="-100"
                 Visibility="Collapsed">
            <Ellipse.RenderTransform>
                <TranslateTransform X="-40" Y="-40"/>
            </Ellipse.RenderTransform>
            <Ellipse.Effect>
                <DropShadowEffect Color="Black" BlurRadius="2" ShadowDepth="1" Opacity="0.5"/>
            </Ellipse.Effect>
        </Ellipse>

        <!-- Status Light -->
        <Ellipse x:Name="StatusLight"
                 Width="12" Height="12"
                 HorizontalAlignment="Right" VerticalAlignment="Top"
                 Margin="0,8,8,0" Stroke="#444444" StrokeThickness="2">
            <Ellipse.Fill>
                <RadialGradientBrush Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5" GradientOrigin="0.5,0.5">
                    <GradientStop Color="#404040" Offset="0.0"/>
                    <GradientStop Color="#202020" Offset="1.0"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <!-- Anchor Points -->
        <ItemsControl x:Name="AnchorsControl" Visibility="Collapsed">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas x:Name="AnchorsCanvas" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Ellipse Style="{StaticResource AnchorPointStyle}"
                             Fill="{Binding IsConnected, Converter={StaticResource BoolToConnectedBrushConverter}}"
                             ToolTip="{Binding Name}"
                             Tag="{Binding}">
                        <Ellipse.RenderTransform>
                            <TranslateTransform X="-7" Y="-7" />
                        </Ellipse.RenderTransform>
                    </Ellipse>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="Canvas.Left" Value="{Binding Position.X, Converter={StaticResource PointToCanvasLeftConverter}}"/>
                    <Setter Property="Canvas.Top" Value="{Binding Position.Y, Converter={StaticResource PointToCanvasTopConverter}}"/>
                </Style>
            </ItemsControl.ItemContainerStyle>
        </ItemsControl>

        <!-- Selection Border -->
        <Border x:Name="SelectionBorder" Style="{StaticResource SelectionBorderStyle}" Visibility="Collapsed"/>
    </Grid>
</local:BaseEquipmentControl>
