<local:BaseEquipmentControl x:Class="TwoD5DMonitoring.Controls.Equipment.TankControl"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:local="clr-namespace:TwoD5DMonitoring.Controls"
              xmlns:models="clr-namespace:TwoD5DMonitoring.Models"
              xmlns:conv="clr-namespace:TwoD5DMonitoring.Converters">

    <local:BaseEquipmentControl.Resources>
        <conv:EquipmentStateToColorConverter x:Key="StateToColorConverter" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <conv:BoolToConnectedBrushConverter x:Key="BoolToConnectedBrushConverter" />
        <conv:DiameterToShadowThicknessConverter x:Key="DiameterToShadowThicknessConverter" />
        <conv:PointToCanvasLeftConverter x:Key="PointToCanvasLeftConverter" />
        <conv:PointToCanvasTopConverter x:Key="PointToCanvasTopConverter" />
        <conv:DiameterToShadowWidthConverter x:Key="DiameterToShadowWidthConverter" />

        <!-- Tank Cylinder Brush -->
        <LinearGradientBrush x:Key="TankCylinderBrush" StartPoint="0,0" EndPoint="1,0" MappingMode="RelativeToBoundingBox">
            <GradientStop Color="#3A3A3A" Offset="0.0"/>
            <GradientStop Color="#222222" Offset="0.3"/>
            <GradientStop Color="#121212" Offset="0.5"/>
            <GradientStop Color="#222222" Offset="0.7"/>
            <GradientStop Color="#3A3A3A" Offset="1.0"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="TankCylinderHighlightBrush" StartPoint="0,0" EndPoint="0,1" MappingMode="RelativeToBoundingBox">
            <GradientStop Color="#5A5A5A" Offset="0.0"/>
            <GradientStop Color="#3A3A3A" Offset="0.3"/>
            <GradientStop Color="#2A2A2A" Offset="0.7"/>
            <GradientStop Color="#1A1A1A" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Tank Cone Brush -->
        <LinearGradientBrush x:Key="TankConeBrush" StartPoint="0.5,0" EndPoint="0.5,1" MappingMode="RelativeToBoundingBox">
            <GradientStop Color="#3A3A3A" Offset="0.0"/>
            <GradientStop Color="#222222" Offset="0.4"/>
            <GradientStop Color="#121212" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Oil Tank Cylinder Brush -->
        <LinearGradientBrush x:Key="OilTankCylinderBrush" StartPoint="0,0" EndPoint="1,0" MappingMode="RelativeToBoundingBox">
            <GradientStop Color="#FFFFFF" Offset="0.0"/>
            <GradientStop Color="#E8E8E8" Offset="0.2"/>
            <GradientStop Color="#CCCCCC" Offset="0.5"/>
            <GradientStop Color="#E8E8E8" Offset="0.75"/>
            <GradientStop Color="#FFFFFF" Offset="1.0"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="OilTankConeBrush" StartPoint="0.5,0" EndPoint="0.5,1" MappingMode="RelativeToBoundingBox">
            <GradientStop Color="#F0F0F0" Offset="0.0"/>
            <GradientStop Color="#DDDDDD" Offset="0.4"/>
            <GradientStop Color="#BBBBBB" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Carbon Fill Brush -->
        <LinearGradientBrush x:Key="CarbonFillBrush" StartPoint="0.5,1" EndPoint="0.5,0" MappingMode="RelativeToBoundingBox">
            <GradientStop Color="#101010" Offset="0.0"/>
            <GradientStop Color="#1A1A1A" Offset="0.3"/>
            <GradientStop Color="#151515" Offset="0.7"/>
            <GradientStop Color="#0A0A0A" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Oil Fill Brush -->
        <LinearGradientBrush x:Key="OilFillBrush" StartPoint="0.5,1" EndPoint="0.5,0" MappingMode="RelativeToBoundingBox">
            <GradientStop Color="#FFD700" Offset="0.0"/>
            <GradientStop Color="#DAA520" Offset="0.4"/>
            <GradientStop Color="#B8860B" Offset="0.8"/>
            <GradientStop Color="#8B6914" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Valve Style -->
        <Style x:Key="ValveStyle" TargetType="Path">
            <Setter Property="Stroke" Value="#666666"/>
            <Setter Property="StrokeThickness" Value="2"/>
        </Style>

        <!-- Sensor Light Style -->
        <Style x:Key="SensorLightStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Height" Value="10"/>
            <Setter Property="Stroke" Value="#444444"/>
            <Setter Property="StrokeThickness" Value="1.5"/>
        </Style>
    </local:BaseEquipmentControl.Resources>

    <Grid x:Name="RootGrid" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <TransformGroup>
                <RotateTransform x:Name="RotationTransform" Angle="0" CenterX="0" CenterY="0"/>
                <ScaleTransform x:Name="ScaleTransform" ScaleX="1" ScaleY="1"/>
            </TransformGroup>
        </Grid.RenderTransform>

        <!-- Shadow -->
        <Ellipse x:Name="ShadowEllipse"
                 Fill="#40000000"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Bottom"
                 Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=local:BaseEquipmentControl}, Converter={StaticResource DiameterToShadowWidthConverter}}"
                 Height="12"
                 Margin="0,0,0,-6"
                 IsHitTestVisible="False"
                 Opacity="0.3">
            <Ellipse.Effect>
                <BlurEffect Radius="8" KernelType="Gaussian"/>
            </Ellipse.Effect>
        </Ellipse>

        <Grid x:Name="TankBodyGrid">
            <!-- Cylinder Border -->
            <Border x:Name="CylinderBorder"
                    Background="{StaticResource TankCylinderBrush}"
                    CornerRadius="0">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="4" ShadowDepth="1" Opacity="0.5" Direction="270"/>
                </Border.Effect>
                <Grid>
                    <!-- Left Highlight -->
                    <Rectangle x:Name="LeftHighlight"
                               Width="8"
                               HorizontalAlignment="Left"
                               Margin="2,0,0,0"
                               RadiusX="2" RadiusY="2">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0" MappingMode="RelativeToBoundingBox">
                                <GradientStop Color="#5A5A5A" Offset="0.0"/>
                                <GradientStop Color="#00000000" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <!-- Right Highlight -->
                    <Rectangle x:Name="RightHighlight"
                               Width="6"
                               HorizontalAlignment="Right"
                               Margin="0,0,2,0"
                               RadiusX="2" RadiusY="2">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="1,0" EndPoint="0,0" MappingMode="RelativeToBoundingBox">
                                <GradientStop Color="#555555" Offset="0.0"/>
                                <GradientStop Color="#00000000" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <!-- Tank Label -->
                    <TextBlock x:Name="TankLabel"
                               Text="{Binding TankName}"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="#CCCCCC"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               MaxWidth="80">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="Black" BlurRadius="2" ShadowDepth="1" Opacity="0.8"/>
                        </TextBlock.Effect>
                    </TextBlock>
                </Grid>
            </Border>

            <!-- Cone -->
            <Path x:Name="ConePath"
                  Fill="{StaticResource TankConeBrush}"
                  Stretch="Fill"
                  VerticalAlignment="Bottom"
                  Height="{Binding ConeHeight, RelativeSource={RelativeSource AncestorType=local:BaseEquipmentControl}}"
                  Data="{Binding ConeGeometry, RelativeSource={RelativeSource AncestorType=local:BaseEquipmentControl}}"
                  Margin="0,0,0,0">
                <Path.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="4" ShadowDepth="2" Opacity="0.4" Direction="270"/>
                </Path.Effect>
            </Path>

            <!-- Top Cover -->
            <Ellipse x:Name="TopCover"
                     Fill="{StaticResource TankCylinderHighlightBrush}"
                     Height="12"
                     VerticalAlignment="Top"
                     Margin="8,4,8,0">
                <Ellipse.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="2" ShadowDepth="1" Opacity="0.5" Direction="270"/>
                </Ellipse.Effect>
            </Ellipse>

            <!-- Bottom Cover -->
            <Ellipse x:Name="BottomCover"
                     Fill="#1A1A1A"
                     Height="8"
                     VerticalAlignment="Bottom"
                     Margin="8,0,8,0"/>

            <!-- Fill Level -->
            <Grid x:Name="FillLevelGrid"
                  VerticalAlignment="Bottom"
                  ClipToBounds="True">
                <Grid.Clip>
                    <RectangleGeometry x:Name="FillClipRect" Rect="0,0,100,100"/>
                </Grid.Clip>

                <!-- Carbon Fill -->
                <Path x:Name="CarbonFillPath"
                      Fill="{StaticResource CarbonFillBrush}"
                      Visibility="Collapsed"
                      Data="{Binding FillGeometry, RelativeSource={RelativeSource AncestorType=local:BaseEquipmentControl}}">
                    <Path.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="3" ShadowDepth="0" Opacity="0.5"/>
                    </Path.Effect>
                </Path>

                <!-- Oil Fill -->
                <Path x:Name="OilFillPath"
                      Fill="{StaticResource OilFillBrush}"
                      Visibility="Collapsed"
                      Data="{Binding FillGeometry, RelativeSource={RelativeSource AncestorType=local:BaseEquipmentControl}}">
                    <Path.Effect>
                        <DropShadowEffect Color="#FFD700" BlurRadius="3" ShadowDepth="0" Opacity="0.3"/>
                    </Path.Effect>
                </Path>

                <!-- Surface Wave -->
                <Path x:Name="SurfaceWavePath"
                      Fill="#20FFFFFF"
                      Visibility="Collapsed"
                      Data="{Binding WaveGeometry, RelativeSource={RelativeSource AncestorType=local:BaseEquipmentControl}}"
                      Opacity="0.3"/>
            </Grid>

            <!-- Inlet Valve -->
            <Path x:Name="InletValvePath"
                  Style="{StaticResource ValveStyle}"
                  Data="{Binding InletValveGeometry, RelativeSource={RelativeSource AncestorType=local:BaseEquipmentControl}}"
                  Visibility="Collapsed">
                <Path.RenderTransform>
                    <RotateTransform x:Name="InletValveRotation" CenterX="10" CenterY="10"/>
                </Path.RenderTransform>
            </Path>

            <!-- Outlet Valve -->
            <Path x:Name="OutletValvePath"
                  Style="{StaticResource ValveStyle}"
                  Data="{Binding OutletValveGeometry, RelativeSource={RelativeSource AncestorType=local:BaseEquipmentControl}}"
                  VerticalAlignment="Bottom"
                  Visibility="Collapsed">
                <Path.RenderTransform>
                    <RotateTransform x:Name="OutletValveRotation" CenterX="10" CenterY="10"/>
                </Path.RenderTransform>
            </Path>

            <!-- Dust Outlet -->
            <Path x:Name="DustOutletPath"
                  Style="{StaticResource ValveStyle}"
                  Data="{Binding DustOutletGeometry, RelativeSource={RelativeSource AncestorType=local:BaseEquipmentControl}}"
                  Visibility="Collapsed"/>

            <!-- Inlet Flange -->
            <Ellipse x:Name="InletFlange"
                     Width="24" Height="24"
                     Stroke="#666666" StrokeThickness="2"
                     Fill="#333333"
                     Visibility="Collapsed">
                <Ellipse.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="2" ShadowDepth="1" Opacity="0.5"/>
                </Ellipse.Effect>
            </Ellipse>

            <!-- Dust Flange -->
            <Ellipse x:Name="DustFlange"
                     Width="20" Height="20"
                     Stroke="#666666" StrokeThickness="2"
                     Fill="#333333"
                     Visibility="Collapsed"/>

            <!-- High Level Sensor -->
            <Ellipse x:Name="HighLevelSensor"
                     Style="{StaticResource SensorLightStyle}"
                     Visibility="Collapsed"
                     ToolTip="High Level"/>

            <!-- Low Level Sensor -->
            <Ellipse x:Name="LowLevelSensor"
                     Style="{StaticResource SensorLightStyle}"
                     Visibility="Collapsed"
                     ToolTip="Low Level"/>

            <!-- Temperature Display -->
            <Border x:Name="TempDisplay"
                    Background="#20000000"
                    BorderBrush="#666666" BorderThickness="1"
                    CornerRadius="4"
                    Padding="4,2"
                    Visibility="Collapsed"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,8,8,0">
                <TextBlock x:Name="TempText"
                           Text="{Binding Temperature, StringFormat={}{0:F1} C}"
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="#FFD700"
                           FontFamily="Consolas"/>
            </Border>

            <!-- Status Light -->
            <Ellipse x:Name="StatusLight"
                     Width="16" Height="16"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Top"
                     Margin="8,8,0,0"
                     Stroke="#444444" StrokeThickness="2">
                <Ellipse.Fill>
                    <RadialGradientBrush Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5" GradientOrigin="0.5,0.5">
                        <GradientStop Color="#404040" Offset="0.0"/>
                        <GradientStop Color="#202020" Offset="1.0"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="2" ShadowDepth="1" Opacity="0.5"/>
                </Ellipse.Effect>
            </Ellipse>

            <!-- Anchor Points -->
            <ItemsControl x:Name="AnchorsControl"
                          ItemsSource="{Binding Anchors}"
                          Visibility="Collapsed">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas x:Name="AnchorsCanvas" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Ellipse x:Name="AnchorEllipse"
                                 Style="{StaticResource AnchorPointStyle}"
                                 Fill="{Binding IsConnected, Converter={StaticResource BoolToConnectedBrushConverter}}"
                                 ToolTip="{Binding Name}"
                                 Tag="{Binding}">
                            <Ellipse.RenderTransform>
                                <TranslateTransform X="-7" Y="-7"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Canvas.Left" Value="{Binding Position.X, Converter={StaticResource PointToCanvasLeftConverter}}"/>
                        <Setter Property="Canvas.Top" Value="{Binding Position.Y, Converter={StaticResource PointToCanvasTopConverter}}"/>
                    </Style>
                </ItemsControl.ItemContainerStyle>
            </ItemsControl>

            <!-- Selection Border -->
            <Border x:Name="SelectionBorder"
                    Style="{StaticResource SelectionBorderStyle}"
                    Visibility="Collapsed"/>
        </Grid>
    </Grid>
</local:BaseEquipmentControl>



