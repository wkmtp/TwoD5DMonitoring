<local:BaseEquipmentControl x:Class="TwoD5DMonitoring.Controls.Equipment.ValveControl"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:local="clr-namespace:TwoD5DMonitoring.Controls"
              xmlns:models="clr-namespace:TwoD5DMonitoring.Models"
              xmlns:conv="clr-namespace:TwoD5DMonitoring.Converters">

    <local:BaseEquipmentControl.Resources>
        <conv:EquipmentStateToColorConverter x:Key="StateToColorConverter" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <conv:BoolToConnectedBrushConverter x:Key="BoolToConnectedBrushConverter" />
        <conv:DiameterToShadowThicknessConverter x:Key="DiameterToShadowThicknessConverter" />
        <conv:PointToCanvasLeftConverter x:Key="PointToCanvasLeftConverter" />
        <conv:PointToCanvasTopConverter x:Key="PointToCanvasTopConverter" />

        <!-- Valve Body Geometry -->
        <PathGeometry x:Key="ValveBodyGeometry">
            <PathFigure StartPoint="0,0" IsClosed="True">
                <LineSegment Point="50,0"/>
                <LineSegment Point="50,40"/>
                <LineSegment Point="0,40"/>
            </PathFigure>
        </PathGeometry>

        <!-- Y-Type Valve Geometry -->
        <PathGeometry x:Key="YTypeValveGeometry">
            <PathFigure StartPoint="25,0" IsClosed="True">
                <LineSegment Point="0,35"/>
                <LineSegment Point="15,35"/>
                <LineSegment Point="25,20"/>
                <LineSegment Point="35,35"/>
                <LineSegment Point="50,35"/>
            </PathFigure>
        </PathGeometry>

        <!-- V-Type Valve Geometry -->
        <PathGeometry x:Key="VTypeValveGeometry">
            <PathFigure StartPoint="25,0" IsClosed="True">
                <LineSegment Point="10,30"/>
                <LineSegment Point="25,20"/>
                <LineSegment Point="40,30"/>
            </PathFigure>
        </PathGeometry>

        <!-- Valve Core Geometry -->
        <PathGeometry x:Key="ValveCoreGeometry">
            <PathFigure StartPoint="20,0" IsClosed="True">
                <LineSegment Point="30,0"/>
                <LineSegment Point="30,15"/>
                <LineSegment Point="20,15"/>
            </PathFigure>
        </PathGeometry>

        <!-- Actuator Geometry -->
        <PathGeometry x:Key="ActuatorGeometry">
            <PathFigure StartPoint="15,0" IsClosed="True">
                <LineSegment Point="35,0"/>
                <LineSegment Point="35,-25"/>
                <LineSegment Point="15,-25"/>
            </PathFigure>
        </PathGeometry>

        <!-- Flange Geometry -->
        <PathGeometry x:Key="FlangeGeometry">
            <PathFigure StartPoint="0,0" IsClosed="True">
                <LineSegment Point="20,0"/>
                <LineSegment Point="20,15"/>
                <LineSegment Point="0,15"/>
            </PathFigure>
        </PathGeometry>

        <!-- Valve Body Brush -->
        <LinearGradientBrush x:Key="ValveBodyBrush" StartPoint="0,0" EndPoint="1,0" MappingMode="RelativeToBoundingBox">
            <GradientStop Color="#4A4A4A" Offset="0.0"/>
            <GradientStop Color="#333333" Offset="0.5"/>
            <GradientStop Color="#222222" Offset="1.0"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ValveCoreBrush" StartPoint="0,0" EndPoint="0,1" MappingMode="RelativeToBoundingBox">
            <GradientStop Color="#5A5A5A" Offset="0.0"/>
            <GradientStop Color="#3A3A3A" Offset="0.5"/>
            <GradientStop Color="#2A2A2A" Offset="1.0"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ActuatorBrush" StartPoint="0,0" EndPoint="0,1" MappingMode="RelativeToBoundingBox">
            <GradientStop Color="#5A5A5A" Offset="0.0"/>
            <GradientStop Color="#3A3A3A" Offset="0.5"/>
            <GradientStop Color="#2A2A2A" Offset="1.0"/>
        </LinearGradientBrush>

        <Style x:Key="ValveStyle" TargetType="Path">
            <Setter Property="Stroke" Value="#666666"/>
            <Setter Property="StrokeThickness" Value="2"/>
        </Style>

        <Style x:Key="IndicatorLightStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Height" Value="10"/>
            <Setter Property="Stroke" Value="#444444"/>
            <Setter Property="StrokeThickness" Value="2"/>
        </Style>
    </local:BaseEquipmentControl.Resources>

    <Grid x:Name="RootGrid" Width="50" Height="80" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <TransformGroup>
                <RotateTransform x:Name="RotationTransform" Angle="0" CenterX="25" CenterY="40"/>
                <ScaleTransform x:Name="ScaleTransform" ScaleX="1" ScaleY="1"/>
            </TransformGroup>
        </Grid.RenderTransform>

        <!-- Valve Body -->
        <Path x:Name="ValveBody"
              Data="{StaticResource ValveBodyGeometry}"
              Fill="{StaticResource ValveBodyBrush}"
              Stroke="#555555" StrokeThickness="1.5">
            <Path.Effect>
                <DropShadowEffect Color="Black" BlurRadius="3" ShadowDepth="1" Opacity="0.5" Direction="270"/>
            </Path.Effect>
        </Path>

        <!-- Flow Path -->
        <Path x:Name="FlowPath"
              Data="{StaticResource YTypeValveGeometry}"
              Stroke="#666666" StrokeThickness="1" StrokeDashArray="3,3"
              Opacity="0.5"/>

        <!-- Valve Core -->
        <Path x:Name="ValveCore"
              Data="{StaticResource ValveCoreGeometry}"
              Fill="#3A3A3A"
              Canvas.Left="15" Canvas.Top="12"
              Width="20" Height="15">
            <Path.RenderTransform>
                <TranslateTransform x:Name="CoreTranslate" X="15" Y="12"/>
            </Path.RenderTransform>
        </Path>

        <!-- Actuator -->
        <Path x:Name="Actuator"
              Data="{StaticResource ActuatorGeometry}"
              Fill="#4A4A4A" Stroke="#666666" StrokeThickness="1"
              Canvas.Left="12.5" Canvas.Top="-25">
            <Path.Effect>
                <DropShadowEffect Color="Black" BlurRadius="2" ShadowDepth="1" Opacity="0.4"/>
            </Path.Effect>
        </Path>

        <!-- Inlet Flange -->
        <Path x:Name="InletFlange"
              Data="{StaticResource FlangeGeometry}"
              Fill="#333333" Stroke="#666666" StrokeThickness="2"
              Canvas.Left="15" Canvas.Top="-15"
              Width="20" Height="15">
            <Path.Effect>
                <DropShadowEffect Color="Black" BlurRadius="2" ShadowDepth="1" Opacity="0.5"/>
            </Path.Effect>
        </Path>

        <Path x:Name="OutletFlange1"
              Data="{StaticResource FlangeGeometry}"
              Fill="#333333" Stroke="#666666" StrokeThickness="2"
              Canvas.Left="0" Canvas.Top="40"
              Width="20" Height="15">
            <Path.RenderTransform>
                <RotateTransform CenterX="10" CenterY="7.5" Angle="90"/>
            </Path.RenderTransform>
            <Path.Effect>
                <DropShadowEffect Color="Black" BlurRadius="2" ShadowDepth="1" Opacity="0.5"/>
            </Path.Effect>
        </Path>

        <Path x:Name="OutletFlange2"
              Data="{StaticResource FlangeGeometry}"
              Fill="#333333" Stroke="#666666" StrokeThickness="2"
              Canvas.Left="30" Canvas.Top="40"
              Width="20" Height="15">
            <Path.RenderTransform>
                <RotateTransform CenterX="10" CenterY="7.5" Angle="-90"/>
            </Path.RenderTransform>
            <Path.Effect>
                <DropShadowEffect Color="Black" BlurRadius="2" ShadowDepth="1" Opacity="0.5"/>
            </Path.Effect>
        </Path>

        <!-- Status Light -->
        <Ellipse x:Name="StatusLight"
                 Width="10" Height="10"
                 HorizontalAlignment="Right" VerticalAlignment="Top"
                 Margin="0,4,4,0" Stroke="#444444" StrokeThickness="1.5">
            <Ellipse.Fill>
                <RadialGradientBrush Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5" GradientOrigin="0.5,0.5">
                    <GradientStop Color="#404040" Offset="0.0"/>
                    <GradientStop Color="#202020" Offset="1.0"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <!-- Anchor Points -->
        <ItemsControl x:Name="AnchorsControl" Visibility="Collapsed">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Ellipse Style="{StaticResource AnchorPointStyle}"
                             Fill="{Binding IsConnected, Converter={StaticResource BoolToConnectedBrushConverter}}"
                             ToolTip="{Binding Name}"
                             Tag="{Binding}">
                        <Ellipse.RenderTransform>
                            <TranslateTransform X="-7" Y="-7"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="Canvas.Left" Value="{Binding Position.X, Converter={StaticResource PointToCanvasLeftConverter}}"/>
                    <Setter Property="Canvas.Top" Value="{Binding Position.Y, Converter={StaticResource PointToCanvasTopConverter}}"/>
                </Style>
            </ItemsControl.ItemContainerStyle>
        </ItemsControl>

        <!-- Selection Border -->
        <Border x:Name="SelectionBorder" Style="{StaticResource SelectionBorderStyle}" Visibility="Collapsed"/>
    </Grid>
</local:BaseEquipmentControl>





