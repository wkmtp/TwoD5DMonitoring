<UserControl x:Class="TwoD5DMonitoring.Designer.DesignerCanvas"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TwoD5DMonitoring.Designer"
             xmlns:controls="clr-namespace:TwoD5DMonitoring.Controls"
             xmlns:models="clr-namespace:TwoD5DMonitoring.Models"
             xmlns:conv="clr-namespace:TwoD5DMonitoring.Converters">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
        
        <!-- 预览连接线样式 -->
        <Style x:Key="PreviewConnectionLineStyle" TargetType="Path">
            <Setter Property="Stroke" Value="Orange"/>
            <Setter Property="StrokeThickness" Value="2"/>
            <Setter Property="StrokeDashArray" Value="4,4"/>
            <Setter Property="StrokeDashCap" Value="Round"/>
        </Style>

        <!-- 网格画刷 -->
        <DrawingBrush x:Key="GridBrush" Viewport="0,0,20,20" ViewportUnits="Absolute" TileMode="Tile">
            <DrawingBrush.Drawing>
                <GeometryDrawing>
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <LineGeometry StartPoint="0,0" EndPoint="20,0"/>
                            <LineGeometry StartPoint="0,0" EndPoint="0,20"/>
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#333333" Thickness="0.5"/>
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <!-- 工具箱项模板 -->
        <DataTemplate x:Key="ToolboxItemTemplate">
            <Border Background="#2A2A2A" BorderBrush="#444444" BorderThickness="1"
                    CornerRadius="4" Margin="4" Padding="8" Width="120"
                    ToolTip="{Binding Description}">
                <StackPanel Orientation="Horizontal">
                    <Viewbox Width="32" Height="32" Margin="0,0,8,0">
                        <ContentControl Content="{Binding Icon}" />
                    </Viewbox>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="{Binding Category}" FontSize="10" Foreground="#888888"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="#1A1A1A">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>  <!-- 工具箱+属性面板 -->
            <ColumnDefinition Width="*"/>     <!-- 设计画布 -->
            <ColumnDefinition Width="280"/>  <!-- 对象树/输出 -->
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>   <!-- 工具栏 -->
            <RowDefinition Height="*"/>    <!-- 主内容区 -->
            <RowDefinition Height="30"/>   <!-- 状态栏 -->
        </Grid.RowDefinitions>

        <!-- 顶部工具栏 -->
        <ToolBar Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Background="#252525" BorderBrush="#444444" BorderThickness="0,0,0,1">
            <Button Command="{Binding NewProjectCommand}" ToolTip="新建项目 (Ctrl+N)">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📄" FontSize="14" Margin="0,0,4,0"/>
                    <TextBlock Text="新建" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Command="{Binding OpenProjectCommand}" ToolTip="打开项目 (Ctrl+O)">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📂" FontSize="14" Margin="0,0,4,0"/>
                    <TextBlock Text="打开" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Command="{Binding SaveProjectCommand}" ToolTip="保存项目 (Ctrl+S)">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="💾" FontSize="14" Margin="0,0,4,0"/>
                    <TextBlock Text="保存" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Separator/>
            <Button Command="{Binding UndoCommand}" ToolTip="撤销 (Ctrl+Z)">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="↶" FontSize="14" Margin="0,0,4,0"/>
                    <TextBlock Text="撤销" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Command="{Binding RedoCommand}" ToolTip="重做 (Ctrl+Y)">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="↷" FontSize="14" Margin="0,0,4,0"/>
                    <TextBlock Text="重做" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Separator/>
            <Button Command="{Binding ToggleGridCommand}" ToolTip="显示/隐藏网格 (G)">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⊞" FontSize="14" Margin="0,0,4,0"/>
                    <TextBlock Text="网格" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Command="{Binding ToggleSnapCommand}" ToolTip="吸附网格 (S)">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🧲" FontSize="14" Margin="0,0,4,0"/>
                    <TextBlock Text="吸附" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Separator/>
            <ComboBox x:Name="GridSizeCombo" Width="80" SelectedValue="{Binding GridSize, Mode=TwoWay}"
                      ToolTip="网格大小">
                <ComboBoxItem Content="10" Tag="10"/>
                <ComboBoxItem Content="20" Tag="20"/>
                <ComboBoxItem Content="50" Tag="50"/>
                <ComboBoxItem Content="100" Tag="100"/>
            </ComboBox>
            <Separator/>
            <Button Command="{Binding SwitchToRuntimeCommand}" Background="#0078D4" Foreground="White"
                    ToolTip="切换到运行时模式 (F5)">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="▶" FontSize="14" Margin="0,0,4,0"/>
                    <TextBlock Text="运行时" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </ToolBar>

        <!-- 左侧面板：工具箱 + 属性面板 -->
        <Grid Grid.Row="1" Grid.Column="0" Background="#1E1E1E">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 工具箱 -->
            <Border Grid.Row="0" BorderBrush="#444444" BorderThickness="0,0,0,1" Padding="4">
                <TextBlock Text="📦 工具箱" FontSize="13" FontWeight="Bold" Foreground="White" Margin="4"/>
            </Border>
            <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
                <TabItem Header="输送设备" Foreground="White">
                    <ListBox ItemsSource="{Binding ConveyingTools}" ItemTemplate="{StaticResource ToolboxItemTemplate}"
                             Background="#1E1E1E" BorderThickness="0"
                             SelectedItem="{Binding SelectedTool, Mode=TwoWay}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>
                </TabItem>
                <TabItem Header="上辅机设备" Foreground="White">
                    <ListBox ItemsSource="{Binding UpperTools}" ItemTemplate="{StaticResource ToolboxItemTemplate}"
                             Background="#1E1E1E" BorderThickness="0"
                             SelectedItem="{Binding SelectedTool, Mode=TwoWay}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>
                </TabItem>
                <TabItem Header="管路阀门" Foreground="White">
                    <ListBox ItemsSource="{Binding PipeTools}" ItemTemplate="{StaticResource ToolboxItemTemplate}"
                             Background="#1E1E1E" BorderThickness="0"
                             SelectedItem="{Binding SelectedTool, Mode=TwoWay}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>
                </TabItem>
            </TabControl>

            <!-- 属性面板 -->
            <Border Grid.Row="2" BorderBrush="#444444" BorderThickness="0,1,0,1" Padding="4" Background="#252525">
                <TextBlock Text="🔧 属性面板" FontSize="13" FontWeight="Bold" Foreground="White" Margin="4"/>
            </Border>
            <Grid Grid.Row="3" Background="#1E1E1E">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="PropertyPanel" Margin="8"/>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- 中央设计画布 -->
        <Border Grid.Row="1" Grid.Column="1" Background="#141414" BorderBrush="#333333" BorderThickness="1"
                ClipToBounds="True" AllowDrop="True">
            <Grid x:Name="CanvasContainer">
                <!-- 网格背景 -->
                <Canvas x:Name="GridCanvas" Background="{StaticResource GridBrush}"
                        Visibility="{Binding ShowGrid, Converter={StaticResource BoolToVisibilityConverter}}"/>

                <!-- 设计画布 -->
                <Canvas x:Name="DesignCanvas" Background="Transparent"
                        MouseLeftButtonDown="OnCanvasMouseDown"
                        MouseMove="OnCanvasMouseMove"
                        MouseLeftButtonUp="OnCanvasMouseUp"
                        MouseRightButtonDown="OnCanvasRightClick"
                        Drop="OnCanvasDrop"
                        DragOver="OnCanvasDragOver"
                        AllowDrop="True">
                    
                    <!-- 连接线预览（拖拽时） -->
                    <Path x:Name="PreviewConnectionLine"
                          Style="{StaticResource PreviewConnectionLineStyle}"
                          Visibility="Collapsed">
                        <Path.Data>
                            <LineGeometry x:Name="PreviewLineGeometry" />
                        </Path.Data>
                    </Path>

                    <!-- 连接线 -->
                    <ItemsControl x:Name="PipeLinesControl" ItemsSource="{Binding Pipes}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <!-- 设备元素 -->
                    <ItemsControl x:Name="ElementsControl" ItemsSource="{Binding Elements}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding EquipmentModel.Position.X}"/>
                                <Setter Property="Canvas.Top" Value="{Binding EquipmentModel.Position.Y}"/>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                    </ItemsControl>
                </Canvas>
            </Grid>
        </Border>

        <!-- 右侧面板：对象树 + 输出 -->
        <Grid Grid.Row="1" Grid.Column="2" Background="#1E1E1E">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TabControl Grid.Row="0" Grid.RowSpan="2" Background="Transparent" BorderThickness="0">
                <TabItem Header="📋 对象树" Foreground="White">
                    <TreeView x:Name="ObjectTree"
                              ItemsSource="{Binding ProjectElements}"
                              Background="#1E1E1E" BorderThickness="0" Foreground="White">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Icon}" Margin="0,0,4,0"/>
                                    <TextBlock Text="{Binding Name}" Foreground="White"/>
                                    <TextBlock Text=" ({Type})" Foreground="#888888" FontSize="10"/>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </TabItem>
                <TabItem Header="📝 输出" Foreground="White">
                    <ListBox x:Name="OutputList" Background="#141414" BorderThickness="0" Foreground="#AAAAAA"
                             FontFamily="Consolas" FontSize="11"/>
                </TabItem>
                <TabItem Header="⚙ 属性" Foreground="White">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#1E1E1E">
                        <StackPanel x:Name="PropertyPanelControl" Margin="8">
                            <TextBlock Text="未选择元素" Foreground="#888888" FontSize="12" HorizontalAlignment="Center" Margin="0,20"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- 状态栏 -->
        <StatusBar Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Background="#252525" BorderBrush="#444444" BorderThickness="0,1,0,0">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="就绪" Foreground="#AAAAAA" FontSize="11"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="CoordText" Text="X: 0, Y: 0" Foreground="#888888" FontSize="11"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="ZoomText" Text="100%" Foreground="#888888" FontSize="11"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</UserControl>