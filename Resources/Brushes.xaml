<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:models="clr-namespace:TwoD5DMonitoring.Models">

    <!-- ========== 设备状态颜色 ========== -->
    <SolidColorBrush x:Key="StateStoppedBrush" Color="#808080" />
    <SolidColorBrush x:Key="StateRunningBrush" Color="#00FF00" />
    <SolidColorBrush x:Key="StateWarningBrush" Color="#FFFF00" />
    <SolidColorBrush x:Key="StateAlarmBrush" Color="#FF0000" />
    <SolidColorBrush x:Key="StateMaintenanceBrush" Color="#0078FF" />

    <!-- ========== 管道类型刷子 ========== -->
    <LinearGradientBrush x:Key="PipeMaterialBrush" StartPoint="0,0" EndPoint="0,1" MappingMode="RelativeToBoundingBox">
        <GradientStop Color="#4A4A4A" Offset="0.0"/>
        <GradientStop Color="#3A3A3A" Offset="0.15"/>
        <GradientStop Color="#2D2D2D" Offset="0.45"/>
        <GradientStop Color="#1A1A1A" Offset="0.55"/>
        <GradientStop Color="#2D2D2D" Offset="0.7"/>
        <GradientStop Color="#151515" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="PipeGasBrush" StartPoint="0,0" EndPoint="0,1" MappingMode="RelativeToBoundingBox">
        <GradientStop Color="#60A0E0" Offset="0.0"/>
        <GradientStop Color="#4080C0" Offset="0.3"/>
        <GradientStop Color="#2060A0" Offset="0.7"/>
        <GradientStop Color="#104080" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="PipeSideBlowBrush" StartPoint="0,0" EndPoint="0,1" MappingMode="RelativeToBoundingBox">
        <GradientStop Color="#E0A040" Offset="0.0"/>
        <GradientStop Color="#C08020" Offset="0.5"/>
        <GradientStop Color="#A06010" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="PipeDustBrush" StartPoint="0,0" EndPoint="0,1" MappingMode="RelativeToBoundingBox">
        <GradientStop Color="#505050" Offset="0.0"/>
        <GradientStop Color="#383838" Offset="0.5"/>
        <GradientStop Color="#202020" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="PipeHighlightBrush" StartPoint="0,0" EndPoint="0,1" MappingMode="RelativeToBoundingBox">
        <GradientStop Color="#FFFFFF" Offset="0.0"/>
        <GradientStop Color="#AAAAAA" Offset="0.3"/>
        <GradientStop Color="#666666" Offset="0.7"/>
        <GradientStop Color="#333333" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="PipeShadowBrush" StartPoint="0,0" EndPoint="0,1" MappingMode="RelativeToBoundingBox">
        <GradientStop Color="#00000000" Offset="0.0"/>
        <GradientStop Color="#33000000" Offset="0.5"/>
        <GradientStop Color="#80000000" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- ========== 设备材质刷子 ========== -->
    <!-- 炭黑罐 - 深灰金属光泽 -->
    <LinearGradientBrush x:Key="CarbonBlackTankBrush" StartPoint="0,0" EndPoint="1,1" MappingMode="RelativeToBoundingBox">
        <GradientStop Color="#2A2A2A" Offset="0.0"/>
        <GradientStop Color="#1A1A1A" Offset="0.3"/>
        <GradientStop Color="#0D0D0D" Offset="0.6"/>
        <GradientStop Color="#1A1A1A" Offset="0.8"/>
        <GradientStop Color="#2A2A2A" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="CarbonBlackTankSideBrush" StartPoint="0,0.5" EndPoint="1,0.5" MappingMode="RelativeToBoundingBox">
        <GradientStop Color="#3A3A3A" Offset="0.0"/>
        <GradientStop Color="#1A1A1A" Offset="0.3"/>
        <GradientStop Color="#0A0A0A" Offset="0.5"/>
        <GradientStop Color="#1A1A1A" Offset="0.7"/>
        <GradientStop Color="#2A2A2A" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- 炭黑罐锥体渐变 -->
    <LinearGradientBrush x:Key="CarbonBlackTankConeBrush" StartPoint="0.5,0" EndPoint="0.5,1" MappingMode="RelativeToBoundingBox">
        <GradientStop Color="#3A3A3A" Offset="0.0"/>
        <GradientStop Color="#222222" Offset="0.4"/>
        <GradientStop Color="#0D0D0D" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- 油罐 - 不锈钢高光 -->
    <LinearGradientBrush x:Key="OilTankBrush" StartPoint="0,0" EndPoint="1,1" MappingMode="RelativeToBoundingBox">
        <GradientStop Color="#F0F0F0" Offset="0.0"/>
        <GradientStop Color="#D0D0D0" Offset="0.25"/>
        <GradientStop Color="#B0B0B0" Offset="0.5"/>
        <GradientStop Color="#C0C0C0" Offset="0.75"/>
        <GradientStop Color="#E0E0E0" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="OilTankSideBrush" StartPoint="0,0.5" EndPoint="1,0.5" MappingMode="RelativeToBoundingBox">
        <GradientStop Color="#FFFFFF" Offset="0.0"/>
        <GradientStop Color="#E0E0E0" Offset="0.2"/>
        <GradientStop Color="#B0B0B0" Offset="0.5"/>
        <GradientStop Color="#D0D0D0" Offset="0.8"/>
        <GradientStop Color="#F0F0F0" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- 密炼机机体 -->
    <LinearGradientBrush x:Key="MixerBodyBrush" StartPoint="0,0" EndPoint="0,1" MappingMode="RelativeToBoundingBox">
        <GradientStop Color="#4A4A4A" Offset="0.0"/>
        <GradientStop Color="#383838" Offset="0.3"/>
        <GradientStop Color="#282828" Offset="0.6"/>
        <GradientStop Color="#181818" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="MixerChamberBrush" StartPoint="0,0" EndPoint="1,0" MappingMode="RelativeToBoundingBox">
        <GradientStop Color="#1A1A1A" Offset="0.0"/>
        <GradientStop Color="#0A0A0A" Offset="0.3"/>
        <GradientStop Color="#050505" Offset="0.5"/>
        <GradientStop Color="#0A0A0A" Offset="0.7"/>
        <GradientStop Color="#1A1A1A" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- 转子渐变 -->
    <LinearGradientBrush x:Key="RotorBrush" StartPoint="0,0" EndPoint="1,1" MappingMode="RelativeToBoundingBox">
        <GradientStop Color="#4A4A4A" Offset="0.0"/>
        <GradientStop Color="#2A2A2A" Offset="0.5"/>
        <GradientStop Color="#1A1A1A" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- 料位填充 - 炭黑 -->
    <LinearGradientBrush x:Key="CarbonMaterialBrush" StartPoint="0.5,1" EndPoint="0.5,0" MappingMode="RelativeToBoundingBox">
        <GradientStop Color="#101010" Offset="0.0"/>
        <GradientStop Color="#1A1A1A" Offset="0.3"/>
        <GradientStop Color="#151515" Offset="0.7"/>
        <GradientStop Color="#0A0A0A" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="CarbonMaterialSideBrush" StartPoint="0,0.5" EndPoint="1,0.5" MappingMode="RelativeToBoundingBox">
        <GradientStop Color="#1A1A1A" Offset="0.0"/>
        <GradientStop Color="#0D0D0D" Offset="0.5"/>
        <GradientStop Color="#1A1A1A" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- 料位填充 - 油料 -->
    <LinearGradientBrush x:Key="OilMaterialBrush" StartPoint="0.5,1" EndPoint="0.5,0" MappingMode="RelativeToBoundingBox">
        <GradientStop Color="#FFD700" Offset="0.0"/>
        <GradientStop Color="#DAA520" Offset="0.4"/>
        <GradientStop Color="#B8860B" Offset="0.8"/>
        <GradientStop Color="#8B6914" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- 胶料 -->
    <LinearGradientBrush x:Key="RubberMaterialBrush" StartPoint="0.5,1" EndPoint="0.5,0" MappingMode="RelativeToBoundingBox">
        <GradientStop Color="#2A1A1A" Offset="0.0"/>
        <GradientStop Color="#1A0D0D" Offset="0.5"/>
        <GradientStop Color="#100808" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- 气流粒子 -->
    <SolidColorBrush x:Key="GasParticleBrush" Color="#B0D0FF" Opacity="0.7" />
    <SolidColorBrush x:Key="MaterialParticleBrush" Color="#282828" Opacity="0.9" />
    <SolidColorBrush x:Key="SideBlowParticleBrush" Color="#FFD700" Opacity="0.8" />
    <SolidColorBrush x:Key="DustParticleBrush" Color="#808080" Opacity="0.6" />

    <!-- 状态指示灯 -->
    <RadialGradientBrush x:Key="IndicatorLightOffBrush" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5" GradientOrigin="0.5,0.5">
        <GradientStop Color="#404040" Offset="0.0"/>
        <GradientStop Color="#202020" Offset="1.0"/>
    </RadialGradientBrush>

    <RadialGradientBrush x:Key="IndicatorLightRunningBrush" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5" GradientOrigin="0.5,0.5">
        <GradientStop Color="#80FF80" Offset="0.0"/>
        <GradientStop Color="#00CC00" Offset="0.5"/>
        <GradientStop Color="#008000" Offset="1.0"/>
    </RadialGradientBrush>

    <RadialGradientBrush x:Key="IndicatorLightWarningBrush" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5" GradientOrigin="0.5,0.5">
        <GradientStop Color="#FFFF80" Offset="0.0"/>
        <GradientStop Color="#FFCC00" Offset="0.5"/>
        <GradientStop Color="#CC9900" Offset="1.0"/>
    </RadialGradientBrush>

    <RadialGradientBrush x:Key="IndicatorLightAlarmBrush" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5" GradientOrigin="0.5,0.5">
        <GradientStop Color="#FF8080" Offset="0.0"/>
        <GradientStop Color="#FF0000" Offset="0.5"/>
        <GradientStop Color="#CC0000" Offset="1.0"/>
    </RadialGradientBrush>

    <!-- 选择框样式 -->
    <Style x:Key="SelectionBorderStyle" TargetType="Border">
        <Setter Property="BorderBrush" Value="Orange"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="BorderStyle" Value="Solid"/>
        <Setter Property="Margin" Value="-2"/>
    </Style>

    <!-- 连接点样式 -->
    <Style x:Key="AnchorPointStyle" TargetType="Ellipse">
        <Setter Property="Width" Value="14"/>
        <Setter Property="Height" Value="14"/>
        <Setter Property="Fill" Value="DodgerBlue"/>
        <Setter Property="Stroke" Value="White"/>
        <Setter Property="StrokeThickness" Value="2"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style x:Key="ConnectedAnchorPointStyle" TargetType="Ellipse" BasedOn="{StaticResource AnchorPointStyle}">
        <Setter Property="Fill" Value="LimeGreen"/>
    </Style>

    <!-- 控制点样式 -->
    <Style x:Key="ControlPointStyle" TargetType="Thumb">
        <Setter Property="Width" Value="14"/>
        <Setter Property="Height" Value="14"/>
        <Setter Property="Background" Value="#FF8800"/>
        <Setter Property="BorderBrush" Value="White"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="Cursor" Value="SizeAll"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Ellipse Fill="{TemplateBinding Background}"
                             Stroke="{TemplateBinding BorderBrush}"
                             StrokeThickness="{TemplateBinding BorderThickness}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>