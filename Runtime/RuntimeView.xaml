<UserControl x:Class="TwoD5DMonitoring.Runtime.RuntimeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TwoD5DMonitoring.Runtime"
             Background="#141414">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <!-- 运行时工具栏 -->
        <ToolBar Grid.Row="0" Background="#252525" BorderBrush="#444444" BorderThickness="0,0,0,1">
            <Button x:Name="BtnStartAll" Content="▶ 全部启动" Background="#27AE60" Foreground="White" 
                    Padding="12,4" Margin="4,0" Click="OnStartAllClick"/>
            <Button x:Name="BtnStopAll" Content="⏹ 全部停止" Background="#E74C3C" Foreground="White"
                    Padding="12,4" Margin="4,0" Click="OnStopAllClick"/>
            <Separator/>
            <Button x:Name="BtnEmergencyStop" Content="🛑 急停" Background="#C0392B" Foreground="White"
                    Padding="12,4" Margin="4,0" Click="OnEmergencyStopClick"/>
            <Separator/>
            <ComboBox x:Name="SpeedCombo" Width="120" SelectedIndex="1"
                      ToolTip="仿真速度">
                <ComboBoxItem Content="0.5x" Tag="0.5"/>
                <ComboBoxItem Content="1x" Tag="1.0"/>
                <ComboBoxItem Content="2x" Tag="2.0"/>
                <ComboBoxItem Content="5x" Tag="5.0"/>
            </ComboBox>
            <Separator/>
            <Button x:Name="BtnSwitchToDesigner" Content="🔧 设计器" Background="#3498DB" Foreground="White"
                    Padding="12,4" Margin="4,0" Click="OnSwitchToDesignerClick"/>
        </ToolBar>

        <!-- 主画布 -->
        <Border Grid.Row="1" Background="#141414" BorderBrush="#333333" BorderThickness="1" ClipToBounds="True">
            <Canvas x:Name="RuntimeCanvas" Background="#141414"/>
        </Border>

        <!-- 状态栏 -->
        <StatusBar Grid.Row="2" Background="#252525" BorderBrush="#444444" BorderThickness="0,1,0,0">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="运行中" Foreground="#00FF00" FontWeight="Bold" FontSize="12"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="PlcStatusText" Text="PLC: 已连接" Foreground="#00FF00" FontSize="11"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="ElementCountText" Text="设备: 0" Foreground="#AAAAAA" FontSize="11"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="AlarmCountText" Text="报警: 0" Foreground="#AAAAAA" FontSize="11"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="TimeText" Text="2024-01-01 00:00:00" Foreground="#888888" FontSize="11"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</UserControl>