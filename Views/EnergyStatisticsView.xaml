<UserControl x:Class="TwoD5DMonitoring.Views.EnergyStatisticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:TwoD5DMonitoring.ViewModels"
             xmlns:conv="clr-namespace:TwoD5DMonitoring.Converters"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1400"
             Background="#1A1A1A"
             Foreground="White">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Brushes.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
            <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
            <conv:EnumToStringConverter x:Key="EnumToStr"/>
            <conv:StatusToColorConverter x:Key="StatusToColor"/>

            <Style TargetType="TextBlock" x:Key="HeaderText">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Margin" Value="0,0,0,5"/>
            </Style>

            <Style TargetType="TextBlock" x:Key="LabelText">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Foreground" Value="#CCCCCC"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0,0,5,0"/>
            </Style>

            <Style TargetType="TextBox" x:Key="InputBox">
                <Setter Property="Background" Value="#2A2A2A"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderBrush" Value="#444444"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="5,3"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="MinWidth" Value="120"/>
            </Style>

            <Style TargetType="ComboBox" x:Key="InputCombo">
                <Setter Property="Background" Value="#2A2A2A"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderBrush" Value="#444444"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="5,3"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="MinWidth" Value="120"/>
            </Style>

            <Style TargetType="Button" x:Key="ActionButton">
                <Setter Property="Background" Value="#3A3A3A"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderBrush" Value="#555555"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="10,4"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Margin" Value="3,0"/>
            </Style>

            <Style TargetType="Button" x:Key="PrimaryButton" BasedOn="{StaticResource ActionButton}">
                <Setter Property="Background" Value="#2E7D32"/>
                <Setter Property="BorderBrush" Value="#4CAF50"/>
            </Style>

            <Style TargetType="Button" x:Key="AccentButton" BasedOn="{StaticResource ActionButton}">
                <Setter Property="Background" Value="#1976D2"/>
                <Setter Property="BorderBrush" Value="#2196F3"/>
            </Style>

            <Style TargetType="DataGrid" x:Key="StandardGrid">
                <Setter Property="Background" Value="#1E1E1E"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderBrush" Value="#333333"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="GridLinesVisibility" Value="Horizontal"/>
                <Setter Property="HorizontalGridLinesBrush" Value="#333333"/>
                <Setter Property="AutoGenerateColumns" Value="False"/>
                <Setter Property="IsReadOnly" Value="True"/>
                <Setter Property="SelectionMode" Value="Single"/>
            </Style>

            <Style TargetType="DataGridColumnHeader" x:Key="GridHeader">
                <Setter Property="Background" Value="#2A2A2A"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderBrush" Value="#444444"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="Padding" Value="6,4"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="FontSize" Value="11"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部工具栏 -->
        <Border Grid.Row="0" Background="#2A2A2A" BorderBrush="#444444" BorderThickness="0,0,0,1" Padding="10,8">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⚡ 能耗统计分析" Style="{StaticResource HeaderText}" VerticalAlignment="Center"/>

                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="20,0" Width="1"/>

                    <!-- 能源类型选择 -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                        <TextBlock Text="能源类型:" Style="{StaticResource LabelText}"/>
                        <ComboBox ItemsSource="{Binding EnergyTypes}" SelectedItem="{Binding EnergyTypeFilter}"
                                  Style="{StaticResource InputCombo}" Width="120" Margin="5,0,0,0">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource EnumToStr}}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <!-- 电表选择 -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                        <TextBlock Text="电表:" Style="{StaticResource LabelText}"/>
                        <ComboBox ItemsSource="{Binding AvailableMeters}" 
                                  SelectedItem="{Binding SelectedMeterForAdd}"
                                  Style="{StaticResource InputCombo}" Width="200" Margin="5,0,0,0">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Content="➕" Style="{StaticResource ActionButton}" Command="{Binding AddMeterCommand}" CommandParameter="{Binding SelectedMeterForAdd}" Padding="8,4" Margin="5,0,0,0"/>
                    </StackPanel>

                    <!-- 时间范围 -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                        <TextBlock Text="开始:" Style="{StaticResource LabelText}"/>
                        <DatePicker SelectedDate="{Binding StartTime}" Width="130" Margin="3,0"/>
                        <TextBlock Text="结束:" Style="{StaticResource LabelText}" Margin="10,0,0,0"/>
                        <DatePicker SelectedDate="{Binding EndTime}" Width="130" Margin="3,0"/>

                        <ComboBox ItemsSource="{Binding PeriodTypes}" SelectedItem="{Binding Period}"
                                  Style="{StaticResource InputCombo}" Width="100" Margin="10,0,0,0">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource EnumToStr}}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <!-- 操作按钮 -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                        <Button Content="🔍 查询统计" Style="{StaticResource PrimaryButton}" Command="{Binding QueryStatisticsCommand}"/>
                        <Button Content="💾 计算并缓存" Style="{StaticResource AccentButton}" Command="{Binding CalculateAndCacheCommand}" Margin="5,0,0,0"/>
                        <Button Content="📊 同比环比" Style="{StaticResource ActionButton}" Command="{Binding ComparePeriodsCommand}" Margin="5,0,0,0"/>
                    </StackPanel>

                    <!-- 导出按钮 -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                        <Button Content="📋 加载记录" Style="{StaticResource ActionButton}" Command="{Binding LoadRecordsCommand}"/>
                        <Button Content="💾 缓存统计" Style="{StaticResource ActionButton}" Command="{Binding LoadCachedStatsCommand}" Margin="5,0,0,0"/>
                        <Button Content="📥 导出数据" Style="{StaticResource AccentButton}" Command="{Binding ExportDataCommand}" Margin="5,0,0,0"/>
                        <Button Content="📈 导出图表" Style="{StaticResource ActionButton}" Command="{Binding ExportChartCommand}" Margin="5,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- 主内容区 -->
        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="400"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：关键指标卡片 + 趋势图表 -->
            <Border Grid.Column="0" Background="#1E1E1E" BorderBrush="#333333" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 关键指标卡片 -->
                    <Border Grid.Row="0" Background="#1A1A1A" BorderBrush="#333333" BorderThickness="0,0,0,1" Margin="10" Padding="15">
                        <UniformGrid Columns="6" Rows="1">
                            <Border Background="#1E1E1E" BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="10" Margin="5">
                                <StackPanel>
                                    <TextBlock Text="总消耗" Style="{StaticResource LabelText}" HorizontalAlignment="Center" Foreground="#888888"/>
                                    <TextBlock Text="{Binding TotalConsumption, StringFormat=F2}" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#2196F3"/>
                                    <TextBlock Text="{Binding EnergyTypeFilter, Converter={StaticResource EnergyTypeToUnit}}" HorizontalAlignment="Center" Foreground="#888888" FontSize="10"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#1E1E1E" BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="10" Margin="5">
                                <StackPanel>
                                    <TextBlock Text="总费用" Style="{StaticResource LabelText}" HorizontalAlignment="Center" Foreground="#888888"/>
                                    <TextBlock Text="{Binding TotalCost, StringFormat='F2 元'}" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#FF9800"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#1E1E1E" BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="10" Margin="5">
                                <StackPanel>
                                    <TextBlock Text="平均/小时" Style="{StaticResource LabelText}" HorizontalAlignment="Center" Foreground="#888888"/>
                                    <TextBlock Text="{Binding AvgConsumptionPerHour, StringFormat='F2'}" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#4CAF50"/>
                                    <TextBlock Text="{Binding EnergyTypeFilter, Converter={StaticResource EnergyTypeToUnit}}" HorizontalAlignment="Center" Foreground="#888888" FontSize="10" />
                                </StackPanel>
                            </Border>
                            <Border Background="#1E1E1E" BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="10" Margin="5">
                                <StackPanel>
                                    <TextBlock Text="峰值消耗" Style="{StaticResource LabelText}" HorizontalAlignment="Center" Foreground="#888888"/>
                                    <TextBlock Text="{Binding PeakConsumption, StringFormat=F2}" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#F44336"/>
                                    <TextBlock Text="{Binding PeakTime, StringFormat='HH:mm'}" HorizontalAlignment="Center" Foreground="#888888" FontSize="10"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#1E1E1E" BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="10" Margin="5">
                                <StackPanel>
                                    <TextBlock Text="最小消耗" Style="{StaticResource LabelText}" HorizontalAlignment="Center" Foreground="#888888"/>
                                    <TextBlock Text="{Binding MinConsumption, StringFormat=F2}" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#9C27B0"/>
                                    <TextBlock Text="{Binding MinTime, StringFormat='HH:mm'}" HorizontalAlignment="Center" Foreground="#888888" FontSize="10"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#1E1E1E" BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="10" Margin="5">
                                <StackPanel>
                                    <TextBlock Text="同比/环比" Style="{StaticResource LabelText}" HorizontalAlignment="Center" Foreground="#888888"/>
<StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="同比: " Foreground="#888888"/>
                                    <TextBlock Text="{Binding YoYChangePercent, StringFormat='F2%'}" 
                                               Foreground="{Binding YoYChangePercent, Converter={StaticResource ChangePercentToColor}}" FontWeight="Bold"/>
                                    <TextBlock Text="  环比: " Foreground="#888888" Margin="10,0,0,0"/>
                                    <TextBlock Text="{Binding MoMChangePercent, StringFormat='F2%'}" 
                                               Foreground="{Binding MoMChangePercent, Converter={StaticResource ChangePercentToColor}}" FontWeight="Bold"/>
                                </StackPanel>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </Border>

                    <!-- 趋势图表 -->
                    <Border Grid.Row="1" Margin="10,0,10,10" Background="#0D0D0D" BorderBrush="#333333" BorderThickness="1" CornerRadius="4">
                        <lvc:CartesianChart x:Name="EnergyChart"
                                            Series="{Binding HourlySeries}"
                                            XAxes="{Binding XAxes}"
                                            YAxes="{Binding YAxes}"
                                            TooltipPosition="Top"
                                            LegendPosition="Right"
                                            AnimationsSpeed="0:0:0.3">
                        </lvc:CartesianChart>
                    </Border>

                    <!-- 分项统计 -->
                    <Border Grid.Row="2" Margin="10,0,10,10" Background="#1E1E1E" BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="15">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="📊 分项能耗统计" Style="{StaticResource HeaderText}" Margin="0,0,0,10"/>

                            <DataGrid Grid.Row="1" ItemsSource="{Binding EquipmentConsumption}"
                                      Style="{StaticResource StandardGrid}"
                                      ColumnHeaderStyle="{StaticResource GridHeader}"
                                      AutoGenerateColumns="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="设备/区域" Binding="{Binding Key}" Width="*"/>
                                    <DataGridTextColumn Header="消耗量" Binding="{Binding Value, StringFormat=F2}" Width="100">
                                        <DataGridTextColumn.CellStyle>
                                            <Style TargetType="DataGridCell">
                                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                            </Style>
                                        </DataGridTextColumn.CellStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="占比" Binding="{Binding Percentage, StringFormat='F2%'}" Width="80">
                                        <DataGridTextColumn.CellStyle>
                                            <Style TargetType="DataGridCell">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="Foreground" Value="#FF9800"/>
                                            </Style>
                                        </DataGridTextColumn.CellStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#333333"/>

            <!-- 右侧：记录列表 / 缓存统计 / 同比环比 -->
            <Border Grid.Column="2" Background="#1E1E1E" BorderBrush="#333333" BorderThickness="1" CornerRadius="4">
                <TabControl Background="Transparent" BorderThickness="0">
                    <TabItem Header="📋 详细记录" Foreground="White" Background="#2A2A2A" BorderBrush="#444444">
                        <DataGrid ItemsSource="{Binding EnergyRecords}"
                                  Style="{StaticResource StandardGrid}"
                                  ColumnHeaderStyle="{StaticResource GridHeader}"
                                  AutoGenerateColumns="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="时间" Binding="{Binding Timestamp, StringFormat='yyyy-MM-dd HH:mm'}" Width="140"/>
                                <DataGridTextColumn Header="电表" Binding="{Binding MeterName}" Width="*"/>
                                <DataGridTextColumn Header="读数" Binding="{Binding Reading, StringFormat=F2}" Width="90">
                                    <DataGridTextColumn.CellStyle>
                                        <Style TargetType="DataGridCell">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                        </Style>
                                    </DataGridTextColumn.CellStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="消耗" Binding="{Binding Consumption, StringFormat=F2}" Width="90">
                                    <DataGridTextColumn.CellStyle>
                                        <Style TargetType="DataGridCell">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                        </Style>
                                    </DataGridTextColumn.CellStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="费用" Binding="{Binding Cost, StringFormat=F2}" Width="80">
                                    <DataGridTextColumn.CellStyle>
                                        <Style TargetType="DataGridCell">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                        </Style>
                                    </DataGridTextColumn.CellStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>

                    <TabItem Header="💾 缓存统计" Foreground="White" Background="#2A2A2A" BorderBrush="#444444">
                        <DataGrid ItemsSource="{Binding CachedStatistics}"
                                  Style="{StaticResource StandardGrid}"
                                  ColumnHeaderStyle="{StaticResource GridHeader}"
                                  AutoGenerateColumns="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="类型" Binding="{Binding EnergyType, Converter={StaticResource EnumToStr}}" Width="100"/>
                                <DataGridTextColumn Header="周期" Binding="{Binding PeriodStart, StringFormat='yyyy-MM-dd'}" Width="*"/>
                                <DataGridTextColumn Header="总消耗" Binding="{Binding TotalConsumption, StringFormat=F2}" Width="100"/>
                                <DataGridTextColumn Header="总费用" Binding="{Binding TotalCost, StringFormat=F2}" Width="100"/>
                                <DataGridTextColumn Header="计算时间" Binding="{Binding CalculatedAt, StringFormat='yyyy-MM-dd HH:mm'}" Width="130"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>

                    <TabItem Header="📊 同比环比" Foreground="White" Background="#2A2A2A" BorderBrush="#444444">
                        <StackPanel Margin="15">
                            <TextBlock Text="周期对比分析" Style="{StaticResource HeaderText}" Margin="0,0,0,15"/>

                            <Border Background="#1E1E1E" BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="15" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="当前周期" Style="{StaticResource LabelText}" Foreground="#888888"/>
                                    <TextBlock Foreground="White">
                                    <Run Text="{Binding CurrentStatistics.PeriodStart, StringFormat='yyyy-MM-dd HH:mm'}"/>
                                    <Run Text=" - "/>
                                    <Run Text="{Binding CurrentStatistics.PeriodEnd, StringFormat='yyyy-MM-dd HH:mm'}"/>
                                </TextBlock>
                                    <TextBlock Text="总消耗: {Binding CurrentStatistics.TotalConsumption, StringFormat=F2} {Binding EnergyTypeFilter, Converter={StaticResource EnergyTypeToUnit}}" Foreground="White" FontWeight="Bold" FontSize="14" Margin="0,5,0,0"/>
                                    <TextBlock Text="总费用: {Binding CurrentStatistics.TotalCost, StringFormat=F2} 元" Foreground="#FF9800" FontWeight="Bold" FontSize="14" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#1E1E1E" BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="15">
                                <StackPanel>
                                    <TextBlock Text="对比周期" Style="{StaticResource LabelText}" Foreground="#888888"/>
                                    <TextBlock Text="同比变化: {Binding YoYChangePercent, StringFormat=F2}%" 
                                               Foreground="{Binding YoYChangePercent, Converter={StaticResource ChangePercentToColor}}" FontWeight="Bold" FontSize="16"/>
                                    <TextBlock Text="环比变化: {Binding MoMChangePercent, StringFormat=F2}%" 
                                               Foreground="{Binding MoMChangePercent, Converter={StaticResource ChangePercentToColor}}" FontWeight="Bold" FontSize="16" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="单耗分析" Style="{StaticResource HeaderText}" Margin="0,15,0,5"/>
                            <StackPanel Orientation="Horizontal">
                                <Border Background="#1E1E1E" BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="15" Width="150" Margin="0,0,10,0">
                                    <StackPanel>
                                        <TextBlock Text="吨产品能耗" Style="{StaticResource LabelText}" Foreground="#888888"/>
                                        <TextBlock Text="{Binding ConsumptionPerTon, StringFormat=F2}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#2196F3"/>
                                        <TextBlock Text="{Binding EnergyTypeFilter, Converter={StaticResource EnergyTypeToUnit}, StringFormat='{}{0}/吨'}" HorizontalAlignment="Center" Foreground="#888888" FontSize="10"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#1E1E1E" BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="15" Width="150">
                                    <StackPanel>
                                        <TextBlock Text="批次能耗" Style="{StaticResource LabelText}" Foreground="#888888"/>
                                        <TextBlock Text="{Binding ConsumptionPerBatch, StringFormat=F2}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#FF9800"/>
                                        <TextBlock Text="{Binding EnergyTypeFilter, Converter={StaticResource EnergyTypeToUnit}, StringFormat='{}{0}/批'}" HorizontalAlignment="Center" Foreground="#888888" FontSize="10"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <!-- 状态栏 -->
        <StatusBar Grid.Row="2" Background="#2A2A2A" BorderBrush="#444444" BorderThickness="0,1,0,0" Foreground="White" Height="28">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="计算中..." Visibility="{Binding IsCalculating, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="加载中..." Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="就绪" Visibility="{Binding IsCalculating, Converter={StaticResource InverseBoolToVis}}"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</UserControl>