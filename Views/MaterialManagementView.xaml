<UserControl x:Class="TwoD5DMonitoring.Views.MaterialManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:TwoD5DMonitoring.ViewModels"
             xmlns:conv="clr-namespace:TwoD5DMonitoring.Converters"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1400"
             Background="#1A1A1A"
             Foreground="White">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Brushes.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
            <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
            <conv:EnumToStringConverter x:Key="EnumToStr"/>

            <Style TargetType="TextBlock" x:Key="HeaderText">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Margin" Value="0,0,0,5"/>
            </Style>

            <Style TargetType="TextBlock" x:Key="LabelText">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Foreground" Value="#CCCCCC"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0,0,5,0"/>
            </Style>

            <Style TargetType="TextBox" x:Key="InputBox">
                <Setter Property="Background" Value="#2A2A2A"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderBrush" Value="#444444"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="5,3"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="MinWidth" Value="120"/>
            </Style>

            <Style TargetType="ComboBox" x:Key="InputCombo">
                <Setter Property="Background" Value="#2A2A2A"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderBrush" Value="#444444"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="5,3"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="MinWidth" Value="120"/>
            </Style>

            <Style TargetType="Button" x:Key="ActionButton">
                <Setter Property="Background" Value="#3A3A3A"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderBrush" Value="#555555"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="12,5"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Margin" Value="5,0"/>
            </Style>

            <Style TargetType="Button" x:Key="PrimaryButton" BasedOn="{StaticResource ActionButton}">
                <Setter Property="Background" Value="#2E7D32"/>
                <Setter Property="BorderBrush" Value="#4CAF50"/>
            </Style>

            <Style TargetType="Button" x:Key="DangerButton" BasedOn="{StaticResource ActionButton}">
                <Setter Property="Background" Value="#C62828"/>
                <Setter Property="BorderBrush" Value="#EF5350"/>
            </Style>

            <Style TargetType="DataGrid" x:Key="StandardGrid">
                <Setter Property="Background" Value="#1E1E1E"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderBrush" Value="#333333"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="GridLinesVisibility" Value="Horizontal"/>
                <Setter Property="HorizontalGridLinesBrush" Value="#333333"/>
                <Setter Property="AutoGenerateColumns" Value="False"/>
                <Setter Property="IsReadOnly" Value="True"/>
                <Setter Property="SelectionMode" Value="Single"/>
                <Setter Property="SelectionUnit" Value="FullRow"/>
                <Setter Property="HeadersVisibility" Value="Column"/>
                <Setter Property="CanUserSortColumns" Value="True"/>
                <Setter Property="CanUserResizeColumns" Value="True"/>
                <Setter Property="CanUserReorderColumns" Value="True"/>
            </Style>

            <Style TargetType="DataGridColumnHeader" x:Key="GridHeader">
                <Setter Property="Background" Value="#2A2A2A"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderBrush" Value="#444444"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="Padding" Value="8,5"/>
                <Setter Property="FontWeight" Value="Bold"/>
            </Style>

            <Style TargetType="DataGridCell" x:Key="GridCell">
                <Setter Property="Padding" Value="8,3"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DataGridCell">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部工具栏 -->
        <Border Grid.Row="0" Background="#2A2A2A" BorderBrush="#444444" BorderThickness="0,0,0,1" Padding="10,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="📦 物料管理" Style="{StaticResource HeaderText}" VerticalAlignment="Center"/>
                
                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="20,0" Width="1"/>

                <!-- 分类搜索 -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="分类搜索:" Style="{StaticResource LabelText}"/>
                    <TextBox Text="{Binding CategorySearchText, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource InputBox}" Width="180"/>
                </StackPanel>

                <!-- 分类操作 -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="➕ 新建分类" Style="{StaticResource ActionButton}" Command="{Binding NewCategoryCommand}"/>
                    <Button Content="✏️ 编辑分类" Style="{StaticResource ActionButton}" Command="{Binding EditCategoryCommand}"/>
                    <Button Content="🗑 删除分类" Style="{StaticResource DangerButton}" Command="{Binding DeleteCategoryCommand}"/>
                </StackPanel>

                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="20,0" Width="1"/>

                <!-- 物料搜索与筛选 -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock Text="物料搜索:" Style="{StaticResource LabelText}"/>
                    <TextBox Text="{Binding MaterialSearchText, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource InputBox}" Width="180"/>

                    <ComboBox ItemsSource="{Binding MaterialTypes}" SelectedItem="{Binding MaterialTypeFilter}"
                              Style="{StaticResource InputCombo}" Width="100" Margin="10,0,0,0">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource EnumToStr}}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <ComboBox ItemsSource="{Binding MaterialStatuses}" SelectedItem="{Binding MaterialStatusFilter}"
                              Style="{StaticResource InputCombo}" Width="100" Margin="10,0,0,0">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource EnumToStr}}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <!-- 物料操作 -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <Button Content="➕ 新建物料" Style="{StaticResource PrimaryButton}" Command="{Binding NewMaterialCommand}"/>
                    <Button Content="✏️ 编辑物料" Style="{StaticResource ActionButton}" Command="{Binding EditMaterialCommand}"/>
                    <Button Content="📋 复制物料" Style="{StaticResource ActionButton}" Command="{Binding CopyMaterialCommand}"/>
                    <Button Content="🗑 删除物料" Style="{StaticResource DangerButton}" Command="{Binding DeleteMaterialCommand}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 主内容区 -->
        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="350"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：分类树 -->
            <Border Grid.Column="0" Background="#1E1E1E" BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="5">
                <DockPanel>
                    <TextBlock Text="物料分类" Style="{StaticResource HeaderText}" DockPanel.Dock="Top" Margin="5,5,5,10"/>
                    <TreeView ItemsSource="{Binding Categories}" Background="Transparent" BorderThickness="0"
                              SelectedItemChanged="TreeView_SelectedItemChanged">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Materials}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📁" Margin="0,0,5,0" Foreground="#FF9800"/>
                                    <TextBlock Text="{Binding Name}" Foreground="White"/>
                                    <TextBlock Text=" ({Binding Code})" Foreground="#888888" FontSize="10"/>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="True"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Style>
                        </TreeView.ItemContainerStyle>
                    </TreeView>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#333333"/>

            <!-- 中间：物料列表 -->
            <Border Grid.Column="2" Background="#1E1E1E" BorderBrush="#333333" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid Grid.Row="0" ItemsSource="{Binding Materials}" SelectedItem="{Binding SelectedMaterial}"
                              Style="{StaticResource StandardGrid}"
                              ColumnHeaderStyle="{StaticResource GridHeader}"
                              CellStyle="{StaticResource GridCell}"
                              RowDetailsVisibilityMode="VisibleWhenSelected">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="编码" Binding="{Binding Code}" Width="100"/>
                            <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="规格" Binding="{Binding Specification}" Width="120"/>
                            <DataGridTemplateColumn Header="类型" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding MaterialType, Converter={StaticResource EnumToStr}}" 
                                                   Foreground="{Binding MaterialType, Converter={StaticResource MaterialTypeToColor}}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="状态" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Status, Converter={StaticResource EnumToStr}}" 
                                                   Foreground="{Binding Status, Converter={StaticResource StatusToColor}}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="单位" Binding="{Binding Unit}" Width="50"/>
                            <DataGridTextColumn Header="密度" Binding="{Binding Density, StringFormat=F3}" Width="70"/>
                        </DataGrid.Columns>
                        <DataGrid.RowDetailsTemplate>
                            <DataTemplate>
                                <StackPanel Margin="10" Orientation="Horizontal">
                                    <TextBlock Text="供应商: " Foreground="#AAAAAA"/>
                                    <TextBlock Text="{Binding Supplier}" Foreground="White"/>
                                    <TextBlock Text="  厂家: " Foreground="#AAAAAA" Margin="20,0,0,0"/>
                                    <TextBlock Text="{Binding Manufacturer}" Foreground="White"/>
                                    <TextBlock Text="  备注: " Foreground="#AAAAAA" Margin="20,0,0,0"/>
                                    <TextBlock Text="{Binding Remark}" Foreground="White" TextWrapping="Wrap" MaxWidth="500"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGrid.RowDetailsTemplate>
                    </DataGrid>

                    <!-- 分页 -->
                    <Border Grid.Row="1" Background="#2A2A2A" BorderBrush="#444444" BorderThickness="0,1,0,0" Padding="10,5">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="⏮ 首页" Style="{StaticResource ActionButton}" Command="{Binding FirstPageCommand}" Padding="10,3"/>
                            <Button Content="◀ 上页" Style="{StaticResource ActionButton}" Command="{Binding PrevPageCommand}" Padding="10,3"/>
                            <TextBlock Text="{Binding Page, StringFormat='第 {0} 页'}" VerticalAlignment="Center" Margin="10,0" Foreground="White"/>
                            <TextBlock Text="{Binding TotalPages, StringFormat='共 {0} 页'}" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#AAAAAA"/>
                            <Button Content="下页 ▶" Style="{StaticResource ActionButton}" Command="{Binding NextPageCommand}" Padding="10,3"/>
                            <Button Content="末页 ⏭" Style="{StaticResource ActionButton}" Command="{Binding LastPageCommand}" Padding="10,3"/>
                            <TextBlock Text="{Binding TotalCount, StringFormat='总计 {0} 条'}" VerticalAlignment="Center" Margin="20,0,0,0" Foreground="#AAAAAA"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch" Background="#333333"/>

            <!-- 右侧：详情/编辑面板 -->
            <Border Grid.Column="4" Background="#1E1E1E" BorderBrush="#333333" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 分类编辑面板 -->
                    <Border Grid.Row="0" Visibility="{Binding IsEditingCategory, Converter={StaticResource BoolToVis}}" 
                            Background="#252525" BorderBrush="#444444" BorderThickness="0,0,0,1" Padding="10">
                        <StackPanel>
                            <TextBlock Text="编辑分类" Style="{StaticResource HeaderText}"/>
                            <Grid Margin="0,10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="编码:" Grid.Row="0" Grid.Column="0" Style="{StaticResource LabelText}"/>
                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding EditingCategory.Code}" Style="{StaticResource InputBox}" Margin="0,3"/>

                                <TextBlock Text="名称:" Grid.Row="1" Grid.Column="0" Style="{StaticResource LabelText}"/>
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding EditingCategory.Name}" Style="{StaticResource InputBox}" Margin="0,3"/>

                                <TextBlock Text="排序:" Grid.Row="2" Grid.Column="0" Style="{StaticResource LabelText}"/>
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding EditingCategory.SortOrder}" Style="{StaticResource InputBox}" Margin="0,3"/>

                                <TextBlock Text="描述:" Grid.Row="3" Grid.Column="0" Style="{StaticResource LabelText}"/>
                                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding EditingCategory.Description}" Style="{StaticResource InputBox}" Margin="0,3"/>

                                <CheckBox Grid.Row="4" Grid.Column="1" Content="启用" IsChecked="{Binding EditingCategory.IsActive}" Foreground="White" Margin="0,5"/>
                            </Grid>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                <Button Content="💾 保存" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCategoryCommand}"/>
                                <Button Content="❌ 取消" Style="{StaticResource ActionButton}" Command="{Binding CancelCategoryCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 物料编辑面板 -->
                    <Border Grid.Row="0" Visibility="{Binding IsEditingMaterial, Converter={StaticResource BoolToVis}}" 
                            Background="#252525" BorderBrush="#444444" BorderThickness="0,0,0,1" Padding="10">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="编辑物料" Style="{StaticResource HeaderText}"/>
                                <Grid Margin="0,10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="编码:*" Grid.Row="0" Grid.Column="0" Style="{StaticResource LabelText}"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding EditingMaterial.Code}" Style="{StaticResource InputBox}" Margin="0,3"/>

                                    <TextBlock Text="名称:*" Grid.Row="1" Grid.Column="0" Style="{StaticResource LabelText}"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding EditingMaterial.Name}" Style="{StaticResource InputBox}" Margin="0,3"/>

                                    <TextBlock Text="规格:" Grid.Row="2" Grid.Column="0" Style="{StaticResource LabelText}"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding EditingMaterial.Specification}" Style="{StaticResource InputBox}" Margin="0,3"/>

                                    <TextBlock Text="单位:*" Grid.Row="3" Grid.Column="0" Style="{StaticResource LabelText}"/>
                                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding EditingMaterial.Unit}" Style="{StaticResource InputBox}" Margin="0,3"/>

                                    <TextBlock Text="类型:*" Grid.Row="4" Grid.Column="0" Style="{StaticResource LabelText}"/>
                                    <ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{Binding MaterialTypes}" 
                                              SelectedItem="{Binding EditingMaterial.MaterialType}" Style="{StaticResource InputCombo}" Margin="0,3">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource EnumToStr}}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <TextBlock Text="状态:*" Grid.Row="5" Grid.Column="0" Style="{StaticResource LabelText}"/>
                                    <ComboBox Grid.Row="5" Grid.Column="1" ItemsSource="{Binding MaterialStatuses}" 
                                              SelectedItem="{Binding EditingMaterial.Status}" Style="{StaticResource InputCombo}" Margin="0,3">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource EnumToStr}}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <TextBlock Text="分类:" Grid.Row="6" Grid.Column="0" Style="{StaticResource LabelText}"/>
                                    <ComboBox Grid.Row="6" Grid.Column="1" ItemsSource="{Binding Categories}" 
                                              SelectedValue="{Binding EditingMaterial.CategoryId}" 
                                              SelectedValuePath="Id" DisplayMemberPath="Name" Style="{StaticResource InputCombo}" Margin="0,3"/>

                                    <TextBlock Text="密度:" Grid.Row="7" Grid.Column="0" Style="{StaticResource LabelText}"/>
                                    <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding EditingMaterial.Density, StringFormat=F3}" Style="{StaticResource InputBox}" Margin="0,3"/>

                                    <TextBlock Text="水分(%):" Grid.Row="8" Grid.Column="0" Style="{StaticResource LabelText}"/>
                                    <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding EditingMaterial.MoistureContent, StringFormat=F2}" Style="{StaticResource InputBox}" Margin="0,3"/>

                                    <TextBlock Text="粒径(μm):" Grid.Row="9" Grid.Column="0" Style="{StaticResource LabelText}"/>
                                    <TextBox Grid.Row="9" Grid.Column="1" Text="{Binding EditingMaterial.ParticleSize, StringFormat=F1}" Style="{StaticResource InputBox}" Margin="0,3"/>

                                    <TextBlock Text="颜色:" Grid.Row="10" Grid.Column="0" Style="{StaticResource LabelText}"/>
                                    <TextBox Grid.Row="10" Grid.Column="1" Text="{Binding EditingMaterial.Color}" Style="{StaticResource InputBox}" Margin="0,3"/>

                                    <TextBlock Text="供应商:" Grid.Row="11" Grid.Column="0" Style="{StaticResource LabelText}"/>
                                    <TextBox Grid.Row="11" Grid.Column="1" Text="{Binding EditingMaterial.Supplier}" Style="{StaticResource InputBox}" Margin="0,3"/>

                                    <TextBlock Text="厂家:" Grid.Row="12" Grid.Column="0" Style="{StaticResource LabelText}"/>
                                    <TextBox Grid.Row="12" Grid.Column="1" Text="{Binding EditingMaterial.Manufacturer}" Style="{StaticResource InputBox}" Margin="0,3"/>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="0,10">
                                    <CheckBox Content="可称量" IsChecked="{Binding EditingMaterial.IsWeighable}" Foreground="White" Margin="0,0,15,0"/>
                                    <CheckBox Content="批次管理" IsChecked="{Binding EditingMaterial.IsBatchManaged}" Foreground="White" Margin="0,0,15,0"/>
                                    <TextBlock Text="保质期(天):" Style="{StaticResource LabelText}"/>
                                    <TextBox Text="{Binding EditingMaterial.ShelfLifeDays}" Style="{StaticResource InputBox}" Width="80"/>
                                </StackPanel>

                                <TextBlock Text="存储条件:" Style="{StaticResource LabelText}" Margin="0,5,0,0"/>
                                <TextBox Text="{Binding EditingMaterial.StorageCondition}" Style="{StaticResource InputBox}" TextWrapping="Wrap" Height="60" Margin="0,3"/>

                                <TextBlock Text="备注:" Style="{StaticResource LabelText}" Margin="0,5,0,0"/>
                                <TextBox Text="{Binding EditingMaterial.Remark}" Style="{StaticResource InputBox}" TextWrapping="Wrap" Height="60" Margin="0,3"/>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                    <Button Content="💾 保存" Style="{StaticResource PrimaryButton}" Command="{Binding SaveMaterialCommand}"/>
                                    <Button Content="❌ 取消" Style="{StaticResource ActionButton}" Command="{Binding CancelMaterialCommand}"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- 物料属性/罐体分配 -->
                    <Border Grid.Row="1" Visibility="{Binding IsEditingMaterial, Converter={StaticResource InverseBoolToVis}}">
                        <TabControl Background="Transparent" BorderThickness="0">
                            <TabItem Header="📋 扩展属性" Foreground="White" Background="#2A2A2A" BorderBrush="#444444">
                                <Grid Margin="5">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="➕ 添加属性" Style="{StaticResource ActionButton}" Command="{Binding AddPropertyCommand}"/>
                                    </StackPanel>
                                    <DataGrid Grid.Row="1" ItemsSource="{Binding MaterialProperties}" 
                                              Style="{StaticResource StandardGrid}"
                                              ColumnHeaderStyle="{StaticResource GridHeader}"
                                              CellStyle="{StaticResource GridCell}"
                                              CanUserAddRows="False">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="属性名" Binding="{Binding Name}" Width="*"/>
                                            <DataGridTextColumn Header="值" Binding="{Binding Value}" Width="150"/>
                                            <DataGridTextColumn Header="单位" Binding="{Binding Unit}" Width="80"/>
                                            <DataGridTextColumn Header="类型" Binding="{Binding DataType}" Width="80"/>
                                            <DataGridTemplateColumn Header="操作" Width="80">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Content="🗑" Style="{StaticResource DangerButton}" 
                                                                Command="{Binding DataContext.DeletePropertyCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                CommandParameter="{Binding}" Padding="5,2" FontSize="10"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </TabItem>
                            <TabItem Header="🏭 罐体分配" Foreground="White" Background="#2A2A2A" BorderBrush="#444444">
                                <Grid Margin="5">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="➕ 分配罐体" Style="{StaticResource ActionButton}" Command="{Binding AssignToTankCommand}"/>
                                        <Button Content="🔄 变更物料" Style="{StaticResource ActionButton}" Command="{Binding ChangeTankMaterialCommand}"/>
                                        <Button Content="📜 查看历史" Style="{StaticResource ActionButton}" Command="{Binding LoadTankHistoryCommand}"/>
                                    </StackPanel>
                                    <DataGrid Grid.Row="1" ItemsSource="{Binding TankMaterials}" SelectedItem="{Binding SelectedTankMaterial}"
                                              Style="{StaticResource StandardGrid}"
                                              ColumnHeaderStyle="{StaticResource GridHeader}"
                                              CellStyle="{StaticResource GridCell}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="罐体" Binding="{Binding TankName}" Width="*"/>
                                            <DataGridTextColumn Header="编码" Binding="{Binding TankCode}" Width="80"/>
                                            <DataGridTextColumn Header="主物料" Binding="{Binding IsPrimary, Converter={StaticResource BoolToYesNo}}" Width="70"/>
                                            <DataGridTextColumn Header="优先级" Binding="{Binding Priority}" Width="60"/>
                                            <DataGridTextColumn Header="最大容量" Binding="{Binding MaxCapacity, StringFormat=F1}" Width="80"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </TabItem>
                            <TabItem Header="📜 变更历史" Foreground="White" Background="#2A2A2A" BorderBrush="#444444">
                                <DataGrid ItemsSource="{Binding TankMaterialHistory}" 
                                          Style="{StaticResource StandardGrid}"
                                          ColumnHeaderStyle="{StaticResource GridHeader}"
                                          CellStyle="{StaticResource GridCell}"
                                          IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="时间" Binding="{Binding ChangeTime, StringFormat='yyyy-MM-dd HH:mm'}" Width="140"/>
                                        <DataGridTextColumn Header="原物料" Binding="{Binding OldMaterialName}" Width="*"/>
                                        <DataGridTextColumn Header="新物料" Binding="{Binding NewMaterialName}" Width="*"/>
                                        <DataGridTextColumn Header="原因" Binding="{Binding ChangeReason}" Width="*"/>
                                        <DataGridTextColumn Header="操作员" Binding="{Binding Operator}" Width="80"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </TabItem>
                        </TabControl>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- 状态栏 -->
        <StatusBar Grid.Row="2" Background="#2A2A2A" BorderBrush="#444444" BorderThickness="0,1,0,0" Foreground="White">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="{Binding IsLoading, Converter={StaticResource BoolToLoadingText}}"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</UserControl>