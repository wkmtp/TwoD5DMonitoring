<UserControl x:Class="TwoD5DMonitoring.Views.OeeAnalysisView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:TwoD5DMonitoring.ViewModels"
             xmlns:conv="clr-namespace:TwoD5DMonitoring.Converters"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1400"
             Background="#1A1A1A"
             Foreground="White">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Brushes.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
            <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
            <conv:EnumToStringConverter x:Key="EnumToStr"/>
            <conv:StatusToColorConverter x:Key="StatusToColor"/>

            <Style TargetType="TextBlock" x:Key="HeaderText">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Margin" Value="0,0,0,5"/>
            </Style>

            <Style TargetType="TextBlock" x:Key="LabelText">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Foreground" Value="#CCCCCC"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0,0,5,0"/>
            </Style>

            <Style TargetType="TextBox" x:Key="InputBox">
                <Setter Property="Background" Value="#2A2A2A"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderBrush" Value="#444444"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="5,3"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="MinWidth" Value="120"/>
            </Style>

            <Style TargetType="ComboBox" x:Key="InputCombo">
                <Setter Property="Background" Value="#2A2A2A"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderBrush" Value="#444444"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="5,3"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="MinWidth" Value="120"/>
            </Style>

            <Style TargetType="Button" x:Key="ActionButton">
                <Setter Property="Background" Value="#3A3A3A"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderBrush" Value="#555555"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="10,4"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Margin" Value="3,0"/>
            </Style>

            <Style TargetType="Button" x:Key="PrimaryButton" BasedOn="{StaticResource ActionButton}">
                <Setter Property="Background" Value="#2E7D32"/>
                <Setter Property="BorderBrush" Value="#4CAF50"/>
            </Style>

            <Style TargetType="Button" x:Key="AccentButton" BasedOn="{StaticResource ActionButton}">
                <Setter Property="Background" Value="#1976D2"/>
                <Setter Property="BorderBrush" Value="#2196F3"/>
            </Style>

            <Style TargetType="DataGrid" x:Key="StandardGrid">
                <Setter Property="Background" Value="#1E1E1E"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderBrush" Value="#333333"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="GridLinesVisibility" Value="Horizontal"/>
                <Setter Property="HorizontalGridLinesBrush" Value="#333333"/>
                <Setter Property="AutoGenerateColumns" Value="False"/>
                <Setter Property="IsReadOnly" Value="True"/>
                <Setter Property="SelectionMode" Value="Single"/>
            </Style>

            <Style TargetType="DataGridColumnHeader" x:Key="GridHeader">
                <Setter Property="Background" Value="#2A2A2A"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderBrush" Value="#444444"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="Padding" Value="6,4"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="FontSize" Value="11"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部工具栏：OEE 计算参数 -->
        <Border Grid.Row="0" Background="#2A2A2A" BorderBrush="#444444" BorderThickness="0,0,0,1" Padding="10,8">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🏭 OEE 分析计算" Style="{StaticResource HeaderText}" VerticalAlignment="Center"/>

                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="20,0" Width="1"/>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                        <TextBlock Text="设备编码:" Style="{StaticResource LabelText}"/>
                        <TextBox Text="{Binding EquipmentCode}" Style="{StaticResource InputBox}" Width="120"/>
                        <TextBlock Text="设备名称:" Style="{StaticResource LabelText}" Margin="10,0,0,0"/>
                        <TextBox Text="{Binding EquipmentName}" Style="{StaticResource InputBox}" Width="150"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                        <TextBlock Text="周期:" Style="{StaticResource LabelText}"/>
                        <ComboBox ItemsSource="{Binding PeriodTypes}" SelectedItem="{Binding Period}"
                                  Style="{StaticResource InputCombo}" Width="100" Margin="5,0,0,0">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource EnumToStr}}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Text="开始:" Style="{StaticResource LabelText}" Margin="10,0,0,0"/>
                        <DatePicker SelectedDate="{Binding PeriodStart}" Width="130" Margin="3,0"/>
                        <TextBlock Text="结束:" Style="{StaticResource LabelText}" Margin="10,0,0,0"/>
                        <DatePicker SelectedDate="{Binding PeriodEnd}" Width="130" Margin="3,0"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                        <TextBlock Text="计划时间(分):" Style="{StaticResource LabelText}"/>
                        <TextBox Text="{Binding PlannedTime}" Style="{StaticResource InputBox}" Width="80" Margin="3,0"/>
                        <TextBlock Text="理想速率(kg/h):" Style="{StaticResource LabelText}" Margin="10,0,0,0"/>
                        <TextBox Text="{Binding IdealRunRate}" Style="{StaticResource InputBox}" Width="100" Margin="3,0"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                        <TextBlock Text="实际产出(kg):" Style="{StaticResource LabelText}"/>
                        <TextBox Text="{Binding ActualOutput}" Style="{StaticResource InputBox}" Width="100" Margin="3,0"/>
                        <TextBlock Text="合格产出(kg):" Style="{StaticResource LabelText}" Margin="10,0,0,0"/>
                        <TextBox Text="{Binding GoodOutput}" Style="{StaticResource InputBox}" Width="100" Margin="3,0"/>
                        <TextBlock Text="次品(kg):" Style="{StaticResource LabelText}" Margin="10,0,0,0"/>
                        <TextBox Text="{Binding DefectOutput}" Style="{StaticResource InputBox}" Width="80" Margin="3,0"/>
                    </StackPanel>

                    <Button Content="🧮 计算 OEE" Style="{StaticResource PrimaryButton}" Command="{Binding CalculateOeeCommand}" Padding="15,5" Margin="10,0,0,0" IsEnabled="{Binding IsCalculating, Converter={StaticResource InverseBoolToVis}}"/>
                    <Button Content="📥 导出 CSV" Style="{StaticResource AccentButton}" Command="{Binding ExportOeeCommand}" Padding="12,5" Margin="5,0,0,0"/>
                    <Button Content="📊 加载历史" Style="{StaticResource ActionButton}" Command="{Binding LoadHistoryCommand}" Padding="12,5" Margin="5,0,0,0"/>
                    <Button Content="📈 趋势图" Style="{StaticResource ActionButton}" Command="{Binding LoadTrendCommand}" Padding="12,5" Margin="5,0,0,0"/>
                    <Button Content="⏸ 停机记录" Style="{StaticResource ActionButton}" Command="{Binding LoadDowntimeCommand}" Padding="12,5" Margin="5,0,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- 主内容区 -->
        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="450"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：OEE 结果卡片 + 历史列表 -->
            <Border Grid.Column="0" Background="#1E1E1E" BorderBrush="#333333" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 当前计算结果卡片 -->
                    <Border Grid.Row="0" Background="#1A1A1A" BorderBrush="#333333" BorderThickness="0,0,0,1" Margin="10" Padding="15" Visibility="{Binding SelectedOee, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="OEE" Style="{StaticResource LabelText}" HorizontalAlignment="Center" Foreground="#888888"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding CalculatedOee, StringFormat='F2%'}" 
                                       FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#4CAF50"/>

                            <TextBlock Grid.Row="0" Grid.Column="1" Text="可用率" Style="{StaticResource LabelText}" HorizontalAlignment="Center" Foreground="#888888"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CalculatedAvailability, StringFormat='F2%'}" 
                                       FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#2196F3"/>

                            <TextBlock Grid.Row="0" Grid.Column="2" Text="性能率" Style="{StaticResource LabelText}" HorizontalAlignment="Center" Foreground="#888888"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding CalculatedPerformance, StringFormat='F2%'}" 
                                       FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#FF9800"/>

                            <TextBlock Grid.Row="0" Grid.Column="3" Text="质量率" Style="{StaticResource LabelText}" HorizontalAlignment="Center" Foreground="#888888"/>
                            <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding CalculatedQuality, StringFormat='F2%'}" 
                                       FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#9C27B0"/>

                            <StackPanel Grid.Row="0" Grid.Column="4" Grid.RowSpan="2" Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="OEE 综合评分" Style="{StaticResource LabelText}" HorizontalAlignment="Center" Foreground="#888888"/>
                                <TextBlock Text="{Binding CalculatedOee, StringFormat=F1}" 
                                           FontSize="36" FontWeight="Bold" HorizontalAlignment="Center" 
                                           Foreground="{Binding CalculatedOee, Converter={StaticResource OeeToColorConverter}}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 详细指标 -->
                    <Border Grid.Row="1" Background="#1A1A1A" BorderBrush="#333333" BorderThickness="0,0,0,1" Margin="10" Padding="15" Visibility="{Binding SelectedOee, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="计划生产时间" Style="{StaticResource LabelText}" Foreground="#888888"/>
                                <TextBlock Text="{Binding SelectedOee.PlannedProductionTime, StringFormat='F1 分钟'}" Foreground="White" FontWeight="Bold" FontSize="14"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1">
                                <TextBlock Text="实际运行时间" Style="{StaticResource LabelText}" Foreground="#888888"/>
                                <TextBlock Text="{Binding SelectedOee.ActualRunTime, StringFormat='F1 分钟'}" Foreground="White" FontWeight="Bold" FontSize="14"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <TextBlock Text="停机时间" Style="{StaticResource LabelText}" Foreground="#888888"/>
                                <TextBlock Text="{Binding SelectedOee.Downtime, StringFormat='F1 分钟'}" Foreground="White" FontWeight="Bold" FontSize="14"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="3">
                                <TextBlock Text="理想生产速率" Style="{StaticResource LabelText}" Foreground="#888888"/>
                                <TextBlock Text="{Binding SelectedOee.IdealRunRate, StringFormat='F1 kg/h'}" Foreground="White" FontWeight="Bold" FontSize="14"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0">
                                <TextBlock Text="实际产出" Style="{StaticResource LabelText}" Foreground="#888888"/>
                                <TextBlock Text="{Binding SelectedOee.ActualOutput, StringFormat='F1 kg'}" Foreground="White" FontWeight="Bold" FontSize="14"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1">
                                <TextBlock Text="合格产出" Style="{StaticResource LabelText}" Foreground="#888888"/>
                                <TextBlock Text="{Binding SelectedOee.GoodOutput, StringFormat='F1 kg'}" Foreground="White" FontWeight="Bold" FontSize="14"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="2">
                                <TextBlock Text="次品产出" Style="{StaticResource LabelText}" Foreground="#888888"/>
                                <TextBlock Text="{Binding SelectedOee.DefectOutput, StringFormat='F1 kg'}" Foreground="White" FontWeight="Bold" FontSize="14"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="3">
                                <TextBlock Text="六大损失分析" Style="{StaticResource LabelText}" Foreground="#888888"/>
                                <TextBlock Text="{Binding SelectedOee.LossCategories.Count, Converter={StaticResource CountToCategoryConverter}}" Foreground="White" FontWeight="Bold" FontSize="14"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 历史列表 -->
                    <Border Grid.Row="2" Background="#1E1E1E" BorderBrush="#333333" BorderThickness="1" CornerRadius="0,0,4,4" Margin="10,0,10,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="#2A2A2A" BorderBrush="#444444" BorderThickness="0,0,0,1" Padding="10,8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📊 OEE 历史记录" Style="{StaticResource HeaderText}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding OeeResults.Count, StringFormat='共 {0} 条记录'}" Foreground="#AAAAAA" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </StackPanel>
                            </Border>

                            <DataGrid Grid.Row="1" ItemsSource="{Binding OeeResults}" SelectedItem="{Binding SelectedOee}"
                                      Style="{StaticResource StandardGrid}"
                                      ColumnHeaderStyle="{StaticResource GridHeader}"
                                      AutoGenerateColumns="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="设备" Binding="{Binding EquipmentName}" Width="*"/>
                                    <DataGridTextColumn Header="编码" Binding="{Binding EquipmentCode}" Width="100"/>
                                    <DataGridTemplateColumn Header="OEE" Width="80">
                                        <DataGridTemplateColumn.CellTemplate>
<DataTemplate>
                                                    <TextBlock Text="{Binding Oee, StringFormat='F2%'}" 
                                                               Foreground="{Binding Oee, Converter={StaticResource OeeToColorConverter}}"
                                                               HorizontalAlignment="Center" FontWeight="Bold"/>
                                                </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="可用率" Binding="{Binding Availability, StringFormat='F2%'}" Width="80">
                                        <DataGridTextColumn.CellStyle>
                                            <Style TargetType="DataGridCell">
                                                <Setter Property="Foreground" Value="#2196F3"/>
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.CellStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="性能" Binding="{Binding Performance, StringFormat='F2%'}" Width="80">
                                        <DataGridTextColumn.CellStyle>
                                            <Style TargetType="DataGridCell">
                                                <Setter Property="Foreground" Value="#FF9800"/>
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.CellStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="质量" Binding="{Binding Quality, StringFormat='F2%'}" Width="80">
                                        <DataGridTextColumn.CellStyle>
                                            <Style TargetType="DataGridCell">
                                                <Setter Property="Foreground" Value="#9C27B0"/>
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.CellStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="计划时间" Binding="{Binding PlannedProductionTime, StringFormat=F1}" Width="80"/>
                                    <DataGridTextColumn Header="实际运行" Binding="{Binding ActualRunTime, StringFormat=F1}" Width="80"/>
                                    <DataGridTextColumn Header="停机" Binding="{Binding Downtime, StringFormat=F1}" Width="70">
                                        <DataGridTextColumn.CellStyle>
                                            <Style TargetType="DataGridCell">
                                                <Setter Property="Foreground" Value="#F44336"/>
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.CellStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="实际产出" Binding="{Binding ActualOutput, StringFormat=F1}" Width="80"/>
                                    <DataGridTextColumn Header="合格/次品" Binding="{Binding GoodOutput, StringFormat='F1'}" Width="100"/>
                                    <DataGridTextColumn Header="时间" Binding="{Binding PeriodStart, StringFormat='yyyy-MM-dd HH:mm'}" Width="130"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#333333"/>

            <!-- 右侧：停机记录 / 损失分析 -->
            <Border Grid.Column="2" Background="#1E1E1E" BorderBrush="#333333" BorderThickness="1" CornerRadius="4">
                <TabControl Background="Transparent" BorderThickness="0">
                    <TabItem Header="⏸ 停机记录" Foreground="White" Background="#2A2A2A" BorderBrush="#444444"
                             Visibility="{Binding DowntimeRecords.Count, Converter={StaticResource CountToVis}}">
                        <DataGrid ItemsSource="{Binding DowntimeRecords}"
                                  Style="{StaticResource StandardGrid}"
                                  ColumnHeaderStyle="{StaticResource GridHeader}"
                                  AutoGenerateColumns="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="开始时间" Binding="{Binding StartTime, StringFormat='yyyy-MM-dd HH:mm'}" Width="140"/>
                                <DataGridTextColumn Header="结束时间" Binding="{Binding EndTime, StringFormat='yyyy-MM-dd HH:mm'}" Width="140"/>
                                <DataGridTextColumn Header="时长(分)" Binding="{Binding Duration, StringFormat=F1}" Width="80">
                                    <DataGridTextColumn.CellStyle>
                                        <Style TargetType="DataGridCell">
                                            <Setter Property="Foreground" Value="#F44336"/>
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.CellStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="原因" Binding="{Binding Reason}" Width="*"/>
                                <DataGridTextColumn Header="类别" Binding="{Binding CategoryDisplayName}" Width="100">
                                    <DataGridTextColumn.CellStyle>
                                        <Style TargetType="DataGridCell">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.CellStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                    <TabItem Header="📉 损失分析" Foreground="White" Background="#2A2A2A" BorderBrush="#444444"
                             Visibility="{Binding SelectedOee.LossCategories.Count, Converter={StaticResource CountToVis}}">
                        <DataGrid ItemsSource="{Binding SelectedOee.LossCategories}"
                                  Style="{StaticResource StandardGrid}"
                                  ColumnHeaderStyle="{StaticResource GridHeader}"
                                  AutoGenerateColumns="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="损失类别" Binding="{Binding Category}" Width="*"/>
                                <DataGridTextColumn Header="时间损失(分)" Binding="{Binding TimeLoss, StringFormat=F1}" Width="100">
                                    <DataGridTextColumn.CellStyle>
                                        <Style TargetType="DataGridCell">
                                            <Setter Property="Foreground" Value="#F44336"/>
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.CellStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="占比(%)" Binding="{Binding Percentage, StringFormat=F2}" Width="80">
                                    <DataGridTextColumn.CellStyle>
                                        <Style TargetType="DataGridCell">
                                            <Setter Property="Foreground" Value="#FF9800"/>
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.CellStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <!-- 状态栏 -->
        <StatusBar Grid.Row="2" Background="#2A2A2A" BorderBrush="#444444" BorderThickness="0,1,0,0" Foreground="White" Height="28">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="计算中..." Visibility="{Binding IsCalculating, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="加载中..." Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="就绪" Visibility="{Binding IsCalculating, Converter={StaticResource InverseBoolToVis}}"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</UserControl>