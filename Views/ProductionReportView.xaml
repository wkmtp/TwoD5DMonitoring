<UserControl x:Class="TwoD5DMonitoring.Views.ProductionReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:TwoD5DMonitoring.ViewModels"
             xmlns:conv="clr-namespace:TwoD5DMonitoring.Converters"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1400"
             Background="#1A1A1A"
             Foreground="White">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Brushes.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
            <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
            <conv:EnumToStringConverter x:Key="EnumToStr"/>
            <conv:StatusToColorConverter x:Key="StatusToColor"/>
            <conv:ReportTypeToColorConverter x:Key="ReportTypeToColor"/>

            <Style TargetType="TextBlock" x:Key="HeaderText">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Margin" Value="0,0,0,5"/>
            </Style>

            <Style TargetType="TextBlock" x:Key="LabelText">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Foreground" Value="#CCCCCC"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0,0,5,0"/>
            </Style>

            <Style TargetType="Button" x:Key="ActionButton">
                <Setter Property="Background" Value="#3A3A3A"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderBrush" Value="#555555"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="10,4"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Margin" Value="3,0"/>
            </Style>

            <Style TargetType="Button" x:Key="PrimaryButton" BasedOn="{StaticResource ActionButton}">
                <Setter Property="Background" Value="#2E7D32"/>
                <Setter Property="BorderBrush" Value="#4CAF50"/>
            </Style>

            <Style TargetType="Button" x:Key="DangerButton" BasedOn="{StaticResource ActionButton}">
                <Setter Property="Background" Value="#C62828"/>
                <Setter Property="BorderBrush" Value="#EF5350"/>
            </Style>

            <Style TargetType="Button" x:Key="AccentButton" BasedOn="{StaticResource ActionButton}">
                <Setter Property="Background" Value="#1976D2"/>
                <Setter Property="BorderBrush" Value="#2196F3"/>
            </Style>

            <Style TargetType="DataGrid" x:Key="StandardGrid">
                <Setter Property="Background" Value="#1E1E1E"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderBrush" Value="#333333"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="GridLinesVisibility" Value="Horizontal"/>
                <Setter Property="HorizontalGridLinesBrush" Value="#333333"/>
                <Setter Property="AutoGenerateColumns" Value="False"/>
                <Setter Property="IsReadOnly" Value="True"/>
                <Setter Property="SelectionMode" Value="Single"/>
                <Setter Property="SelectionUnit" Value="FullRow"/>
            </Style>

            <Style TargetType="DataGridColumnHeader" x:Key="GridHeader">
                <Setter Property="Background" Value="#2A2A2A"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderBrush" Value="#444444"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="Padding" Value="6,4"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="FontSize" Value="11"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部工具栏 -->
        <Border Grid.Row="0" Background="#2A2A2A" BorderBrush="#444444" BorderThickness="0,0,0,1" Padding="10,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="📋 生产报表管理" Style="{StaticResource HeaderText}" VerticalAlignment="Center"/>
                
                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="20,0" Width="1"/>

                <!-- 筛选 -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                    <ComboBox ItemsSource="{Binding ReportTypes}" SelectedItem="{Binding ReportTypeFilter}"
                              Style="{StaticResource InputCombo}" Width="110" Margin="0,0,10,0">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource EnumToStr}}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <ComboBox ItemsSource="{Binding ReportStatuses}" SelectedItem="{Binding StatusFilter}"
                              Style="{StaticResource InputCombo}" Width="100" Margin="10,0,0,0">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource EnumToStr}}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <!-- 时间范围 -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="开始:" Style="{StaticResource LabelText}"/>
                    <DatePicker SelectedDate="{Binding PeriodFrom}" Width="130" Margin="3,0"/>
                    <TextBlock Text="结束:" Style="{StaticResource LabelText}" Margin="10,0,0,0"/>
                    <DatePicker SelectedDate="{Binding PeriodTo}" Width="130" Margin="3,0"/>
                </StackPanel>

                <!-- 报表生成按钮 -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="📊 生成班报" Style="{StaticResource PrimaryButton}" Command="{Binding GenerateShiftReportCommand}"/>
                    <Button Content="📅 生成日报" Style="{StaticResource PrimaryButton}" Command="{Binding GenerateDailyReportCommand}" Margin="5,0,0,0"/>
                    <Button Content="📆 生成月报" Style="{StaticResource PrimaryButton}" Command="{Binding GenerateMonthlyReportCommand}" Margin="5,0,0,0"/>
                </StackPanel>

                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="20,0" Width="1"/>

                <!-- 操作按钮 -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="👁 查看" Style="{StaticResource ActionButton}" Command="{Binding ViewReportCommand}"/>
                    <Button Content="✅ 审核" Style="{StaticResource PrimaryButton}" Command="{Binding ApproveReportCommand}"/>
                    <Button Content="📥 导出" Style="{StaticResource AccentButton}" Command="{Binding ExportReportCommand}"/>
                    <Button Content="🖨 打印" Style="{StaticResource ActionButton}" Command="{Binding PrintReportCommand}"/>
                    <Button Content="🗑 删除" Style="{StaticResource DangerButton}" Command="{Binding DeleteReportCommand}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 主列表区 -->
        <Border Grid.Row="1" Margin="10" Background="#1E1E1E" BorderBrush="#333333" BorderThickness="1" CornerRadius="4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DataGrid Grid.Row="0" ItemsSource="{Binding Reports}" SelectedItem="{Binding SelectedReport}"
                          Style="{StaticResource StandardGrid}"
                          ColumnHeaderStyle="{StaticResource GridHeader}"
                          RowDetailsVisibilityMode="VisibleWhenSelected">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="报表编号" Binding="{Binding ReportNumber}" Width="130"/>
                        <DataGridTemplateColumn Header="类型" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ReportType, Converter={StaticResource EnumToStr}}" 
                                               Foreground="{Binding ReportType, Converter={StaticResource ReportTypeToColor}}"
                                               HorizontalAlignment="Center" FontWeight="Bold"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="状态" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Status, Converter={StaticResource EnumToStr}}" 
                                               Foreground="{Binding Status, Converter={StaticResource StatusToColor}}"
                                               HorizontalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="班次" Binding="{Binding ShiftName}" Width="80"/>
                        <DataGridTextColumn Header="周期开始" Binding="{Binding PeriodStart, StringFormat='yyyy-MM-dd HH:mm'}" Width="130"/>
                        <DataGridTextColumn Header="周期结束" Binding="{Binding PeriodEnd, StringFormat='yyyy-MM-dd HH:mm'}" Width="130"/>
                        <DataGridTextColumn Header="总批次" Binding="{Binding Summary.TotalBatches}" Width="70"/>
                        <DataGridTextColumn Header="完成批次" Binding="{Binding Summary.CompletedBatches}" Width="70"/>
                        <DataGridTextColumn Header="总重量(kg)" Binding="{Binding Summary.TotalWeight, StringFormat=F1}" Width="90"/>
                        <DataGridTextColumn Header="合格率(%)" Binding="{Binding Summary.YieldRate, StringFormat=F1}" Width="80"/>
                        <DataGridTextColumn Header="生成者" Binding="{Binding GeneratedBy}" Width="80"/>
                        <DataGridTextColumn Header="生成时间" Binding="{Binding GeneratedAt, StringFormat='yyyy-MM-dd HH:mm'}" Width="130"/>
                    </DataGrid.Columns>
                    <DataGrid.RowDetailsTemplate>
                        <DataTemplate>
                            <StackPanel Margin="15" Orientation="Horizontal">
                                <TextBlock Text="总重量: " Foreground="#AAAAAA"/>
                                <TextBlock Text="{Binding Summary.TotalWeight, StringFormat='F1 kg'}" Foreground="White" FontWeight="Bold"/>
                                <TextBlock Text="  合格重量: " Foreground="#AAAAAA" Margin="20,0,0,0"/>
                                <TextBlock Text="{Binding Summary.QualifiedWeight, StringFormat='F1 kg'}" Foreground="#4CAF50" FontWeight="Bold"/>
                                <TextBlock Text="  产率: " Foreground="#AAAAAA" Margin="20,0,0,0"/>
                                <TextBlock Text="{Binding Summary.YieldRate, StringFormat='F1%'}" Foreground="#2196F3" FontWeight="Bold"/>
                                <TextBlock Text="  电耗: " Foreground="#AAAAAA" Margin="20,0,0,0"/>
                                <TextBlock Text="{Binding Summary.ElectricityConsumption, StringFormat='F1 kWh'}" Foreground="#FF9800" FontWeight="Bold"/>
                                <TextBlock Text="  可用率: " Foreground="#AAAAAA" Margin="20,0,0,0"/>
                                <TextBlock Text="{Binding Summary.Availability, StringFormat='F1%'}" Foreground="#9C27B0" FontWeight="Bold"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGrid.RowDetailsTemplate>
                </DataGrid>

                <!-- 分页 -->
                <Border Grid.Row="1" Background="#2A2A2A" BorderBrush="#444444" BorderThickness="0,1,0,0" Padding="10,5">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="⏮" Style="{StaticResource ActionButton}" Command="{Binding FirstPageCommand}" Padding="8,2" ToolTip="首页"/>
                        <Button Content="◀" Style="{StaticResource ActionButton}" Command="{Binding PrevPageCommand}" Padding="8,2" ToolTip="上一页"/>
                        <TextBlock Text="{Binding Page, StringFormat='第 {0} 页'}" VerticalAlignment="Center" Margin="10,0" Foreground="White"/>
                        <TextBlock Text="{Binding TotalPages, StringFormat='共 {0} 页'}" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#AAAAAA"/>
                        <Button Content="▶" Style="{StaticResource ActionButton}" Command="{Binding NextPageCommand}" Padding="8,2" ToolTip="下一页"/>
                        <Button Content="⏭" Style="{StaticResource ActionButton}" Command="{Binding LastPageCommand}" Padding="8,2" ToolTip="末页"/>
                        <TextBlock Text="{Binding TotalCount, StringFormat='总计 {0} 条'}" VerticalAlignment="Center" Margin="20,0,0,0" Foreground="#AAAAAA"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 状态栏 -->
        <StatusBar Background="#2A2A2A" BorderBrush="#444444" BorderThickness="0,1,0,0" Foreground="White" Height="28">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="{Binding IsGenerating, Converter={StaticResource BoolToGeneratingText}}"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</UserControl>