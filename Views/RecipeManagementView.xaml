<UserControl x:Class="TwoD5DMonitoring.Views.RecipeManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:TwoD5DMonitoring.ViewModels"
             xmlns:conv="clr-namespace:TwoD5DMonitoring.Converters"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1600"
             Background="#1A1A1A"
             Foreground="White">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Brushes.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
            <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
            <conv:EnumToStringConverter x:Key="EnumToStr"/>
            <conv:BoolToYesNoConverter x:Key="BoolToYesNo"/>
            <conv:StatusToColorConverter x:Key="StatusToColor"/>
            <conv:MaterialTypeToColorConverter x:Key="MaterialTypeToColor"/>

            <Style TargetType="TextBlock" x:Key="HeaderText">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Margin" Value="0,0,0,5"/>
            </Style>

            <Style TargetType="TextBlock" x:Key="LabelText">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Foreground" Value="#CCCCCC"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0,0,5,0"/>
            </Style>

            <Style TargetType="TextBox" x:Key="InputBox">
                <Setter Property="Background" Value="#2A2A2A"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderBrush" Value="#444444"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="5,3"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="MinWidth" Value="120"/>
            </Style>

            <Style TargetType="ComboBox" x:Key="InputCombo">
                <Setter Property="Background" Value="#2A2A2A"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderBrush" Value="#444444"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="5,3"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="MinWidth" Value="120"/>
            </Style>

            <Style TargetType="Button" x:Key="ActionButton">
                <Setter Property="Background" Value="#3A3A3A"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderBrush" Value="#555555"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="10,4"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Margin" Value="3,0"/>
            </Style>

            <Style TargetType="Button" x:Key="PrimaryButton" BasedOn="{StaticResource ActionButton}">
                <Setter Property="Background" Value="#2E7D32"/>
                <Setter Property="BorderBrush" Value="#4CAF50"/>
            </Style>

            <Style TargetType="Button" x:Key="DangerButton" BasedOn="{StaticResource ActionButton}">
                <Setter Property="Background" Value="#C62828"/>
                <Setter Property="BorderBrush" Value="#EF5350"/>
            </Style>

            <Style TargetType="Button" x:Key="AccentButton" BasedOn="{StaticResource ActionButton}">
                <Setter Property="Background" Value="#1976D2"/>
                <Setter Property="BorderBrush" Value="#2196F3"/>
            </Style>

            <Style TargetType="DataGrid" x:Key="StandardGrid">
                <Setter Property="Background" Value="#1E1E1E"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderBrush" Value="#333333"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="GridLinesVisibility" Value="Horizontal"/>
                <Setter Property="HorizontalGridLinesBrush" Value="#333333"/>
                <Setter Property="AutoGenerateColumns" Value="False"/>
                <Setter Property="IsReadOnly" Value="True"/>
                <Setter Property="SelectionMode" Value="Single"/>
                <Setter Property="SelectionUnit" Value="FullRow"/>
                <Setter Property="HeadersVisibility" Value="Column"/>
                <Setter Property="CanUserSortColumns" Value="True"/>
            </Style>

            <Style TargetType="DataGridColumnHeader" x:Key="GridHeader">
                <Setter Property="Background" Value="#2A2A2A"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderBrush" Value="#444444"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="Padding" Value="6,4"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="FontSize" Value="11"/>
            </Style>

            <Style TargetType="DataGridCell" x:Key="GridCell">
                <Setter Property="Padding" Value="6,2"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DataGridCell">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部工具栏 -->
        <Border Grid.Row="0" Background="#2A2A2A" BorderBrush="#444444" BorderThickness="0,0,0,1" Padding="10,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="📋 配方管理" Style="{StaticResource HeaderText}" VerticalAlignment="Center"/>
                
                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="20,0" Width="1"/>

                <!-- 搜索与筛选 -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="搜索:" Style="{StaticResource LabelText}"/>
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource InputBox}" Width="200"/>

                    <ComboBox ItemsSource="{Binding RecipeTypes}" SelectedItem="{Binding RecipeTypeFilter}"
                              Style="{StaticResource InputCombo}" Width="110" Margin="10,0,0,0">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource EnumToStr}}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <ComboBox ItemsSource="{Binding RecipeStatuses}" SelectedItem="{Binding StatusFilter}"
                              Style="{StaticResource InputCombo}" Width="100" Margin="10,0,0,0">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource EnumToStr}}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <!-- 配方操作 -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="➕ 新建称量配方" Style="{StaticResource PrimaryButton}" Command="{Binding NewRecipeCommand}" Tag="Weighing"/>
                    <Button Content="➕ 新建混炼配方" Style="{StaticResource PrimaryButton}" Command="{Binding NewRecipeCommand}" Tag="Mixing" Margin="5,0,0,0"/>
                    <Button Content="✏️ 编辑" Style="{StaticResource ActionButton}" Command="{Binding EditRecipeCommand}"/>
                    <Button Content="📋 复制" Style="{StaticResource ActionButton}" Command="{Binding CopyRecipeCommand}"/>
                    <Button Content="🗑 删除" Style="{StaticResource DangerButton}" Command="{Binding DeleteRecipeCommand}"/>
                </StackPanel>

                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="20,0" Width="1"/>

                <!-- 状态流转 -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="📤 提交审核" Style="{StaticResource AccentButton}" Command="{Binding SubmitForReviewCommand}"/>
                    <Button Content="✅ 审核通过" Style="{StaticResource PrimaryButton}" Command="{Binding ApproveCommand}"/>
                    <Button Content="❌ 驳回" Style="{StaticResource DangerButton}" Command="{Binding RejectCommand}"/>
                    <Button Content="🚀 发布" Style="{StaticResource PrimaryButton}" Command="{Binding ReleaseCommand}"/>
                    <Button Content="📦 归档" Style="{StaticResource ActionButton}" Command="{Binding ArchiveCommand}"/>
                    <Button Content="🚫 作废" Style="{StaticResource DangerButton}" Command="{Binding ObsoleteCommand}"/>
                </StackPanel>

                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="20,0" Width="1"/>

                <!-- PLC操作 -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="⬇ 下发到PLC" Style="{StaticResource AccentButton}" Command="{Binding DownloadToPlcCommand}"/>
                    <Button Content="✔ 从PLC校验" Style="{StaticResource ActionButton}" Command="{Binding VerifyFromPlcCommand}"/>
                    <Button Content="📜 下发日志" Style="{StaticResource ActionButton}" Command="{Binding ViewDownloadLogsCommand}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 主内容区 -->
        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="480"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：配方列表 -->
            <Border Grid.Column="0" Background="#1E1E1E" BorderBrush="#333333" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid Grid.Row="0" ItemsSource="{Binding Recipes}" SelectedItem="{Binding SelectedRecipe}"
                              Style="{StaticResource StandardGrid}"
                              ColumnHeaderStyle="{StaticResource GridHeader}"
                              CellStyle="{StaticResource GridCell}"
                              RowDetailsVisibilityMode="VisibleWhenSelected">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="编码" Binding="{Binding Code}" Width="110"/>
                            <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*"/>
                            <DataGridTemplateColumn Header="类型" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding RecipeType, Converter={StaticResource EnumToStr}}" 
                                                   Foreground="{Binding RecipeType, Converter={StaticResource MaterialTypeToColor}}"
                                                   HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="状态" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Status, Converter={StaticResource EnumToStr}}" 
                                                   Foreground="{Binding Status, Converter={StaticResource StatusToColor}}"
                                                   HorizontalAlignment="Center" FontWeight="Bold"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="版本" Binding="{Binding CurrentVersion}" Width="70"/>
                            <DataGridTextColumn Header="产品编码" Binding="{Binding ProductCode}" Width="100"/>
                            <DataGridTextColumn Header="批次大小" Binding="{Binding BatchSize, StringFormat=F1}" Width="80"/>
                            <DataGridTextColumn Header="创建者" Binding="{Binding CreatedBy}" Width="80"/>
                            <DataGridTextColumn Header="创建时间" Binding="{Binding CreatedAt, StringFormat='yyyy-MM-dd HH:mm'}" Width="130"/>
                        </DataGrid.Columns>
                        <DataGrid.RowDetailsTemplate>
                            <DataTemplate>
                                <StackPanel Margin="15" Orientation="Horizontal">
                                    <TextBlock Text="产品: " Foreground="#AAAAAA"/>
                                    <TextBlock Text="{Binding ProductName}" Foreground="White" FontWeight="Bold"/>
                                    <TextBlock Text="  目标产率: " Foreground="#AAAAAA" Margin="20,0,0,0"/>
                                    <TextBlock Text="{Binding YieldRate, StringFormat='F1%'}" Foreground="White"/>
                                    <TextBlock Text="  备注: " Foreground="#AAAAAA" Margin="20,0,0,0"/>
                                    <TextBlock Text="{Binding Remark}" Foreground="White" TextWrapping="Wrap" MaxWidth="600"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGrid.RowDetailsTemplate>
                    </DataGrid>

                    <!-- 分页 -->
                    <Border Grid.Row="1" Background="#2A2A2A" BorderBrush="#444444" BorderThickness="0,1,0,0" Padding="10,5">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="⏮" Style="{StaticResource ActionButton}" Command="{Binding FirstPageCommand}" Padding="8,2" ToolTip="首页"/>
                            <Button Content="◀" Style="{StaticResource ActionButton}" Command="{Binding PrevPageCommand}" Padding="8,2" ToolTip="上一页"/>
                            <TextBlock Text="{Binding Page, StringFormat='第 {0} 页'}" VerticalAlignment="Center" Margin="10,0" Foreground="White"/>
                            <TextBlock Text="{Binding TotalPages, StringFormat='共 {0} 页'}" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#AAAAAA"/>
                            <Button Content="▶" Style="{StaticResource ActionButton}" Command="{Binding NextPageCommand}" Padding="8,2" ToolTip="下一页"/>
                            <Button Content="⏭" Style="{StaticResource ActionButton}" Command="{Binding LastPageCommand}" Padding="8,2" ToolTip="末页"/>
                            <TextBlock Text="{Binding TotalCount, StringFormat='总计 {0} 条'}" VerticalAlignment="Center" Margin="20,0,0,0" Foreground="#AAAAAA"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#333333"/>

            <!-- 右侧：详情标签页 -->
            <Border Grid.Column="2" Background="#1E1E1E" BorderBrush="#333333" BorderThickness="1" CornerRadius="4">
                <TabControl Background="Transparent" BorderThickness="0" SelectedIndex="0">
                    <!-- 称量配方明细 -->
                    <TabItem Header="⚖ 称量明细" Foreground="White" Background="#2A2A2A" BorderBrush="#444444" 
                             Visibility="{Binding SelectedRecipe, Converter={StaticResource IsWeighingRecipeToVis}}">
                        <Grid Margin="5">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- 称量配方基本信息 -->
                            <Border Grid.Row="0" Background="#252525" BorderBrush="#444444" BorderThickness="0,0,0,1" Padding="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="称量模式:" Grid.Row="0" Grid.Column="0" Style="{StaticResource LabelText}"/>
                                    <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding WeighingModes}" 
                                              SelectedItem="{Binding EditingRecipe.WeighingMode, Mode=TwoWay}" Style="{StaticResource InputCombo}" Margin="0,3">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource EnumToStr}}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <TextBlock Text="秤ID:" Grid.Row="0" Grid.Column="2" Style="{StaticResource LabelText}"/>
                                    <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding EditingRecipe.ScaleId, Mode=TwoWay}" Style="{StaticResource InputBox}" Margin="0,3"/>

                                    <TextBlock Text="小数位:" Grid.Row="0" Grid.Column="4" Style="{StaticResource LabelText}"/>
                                    <TextBox Grid.Row="0" Grid.Column="5" Text="{Binding EditingRecipe.DecimalPlaces, Mode=TwoWay}" Style="{StaticResource InputBox}" Margin="0,3" Width="60"/>

                                    <TextBlock Text="总重量:" Grid.Row="1" Grid.Column="0" Style="{StaticResource LabelText}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding EditingRecipe.TotalWeight, StringFormat=F2}" Foreground="#4CAF50" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <TextBlock Text="kg" Grid.Row="1" Grid.Column="2" Style="{StaticResource LabelText}" Foreground="#888888"/>

                                    <TextBlock Text="批次大小:" Grid.Row="1" Grid.Column="3" Style="{StaticResource LabelText}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="4" Text="{Binding EditingRecipe.BatchSize, StringFormat=F1}" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <TextBlock Text="kg" Grid.Row="1" Grid.Column="5" Style="{StaticResource LabelText}" Foreground="#888888"/>
                                </Grid>
                            </Border>

                            <!-- 明细列表 -->
                            <DataGrid Grid.Row="1" ItemsSource="{Binding WeighingLines}" SelectedItem="{Binding SelectedWeighingLine}"
                                      Style="{StaticResource StandardGrid}"
                                      ColumnHeaderStyle="{StaticResource GridHeader}"
                                      CellStyle="{StaticResource GridCell}"
                                      CanUserAddRows="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="行号" Binding="{Binding LineNumber}" Width="50"/>
                                    <DataGridTextColumn Header="物料编码" Binding="{Binding MaterialCode}" Width="100"/>
                                    <DataGridTextColumn Header="物料名称" Binding="{Binding MaterialName}" Width="*"/>
                                    <DataGridTextColumn Header="目标重量" Binding="{Binding TargetWeight, StringFormat=F3}" Width="90"/>
                                    <DataGridTextColumn Header="占比(%)" Binding="{Binding Percentage, StringFormat=F2}" Width="70"/>
                                    <DataGridTextColumn Header="正差(%)" Binding="{Binding TolerancePositive, StringFormat=F1}" Width="70"/>
                                    <DataGridTextColumn Header="负差(%)" Binding="{Binding ToleranceNegative, StringFormat=F1}" Width="70"/>
                                    <DataGridTextColumn Header="最小值" Binding="{Binding MinWeight, StringFormat=F3}" Width="80"/>
                                    <DataGridTextColumn Header="最大值" Binding="{Binding MaxWeight, StringFormat=F3}" Width="80"/>
                                    <DataGridTemplateColumn Header="加料方式" Width="90">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding FeederType, Converter={StaticResource EnumToStr}}" HorizontalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="关键" Width="50">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsCritical}" IsEnabled="False" HorizontalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- 明细操作 -->
                            <Border Grid.Row="2" Background="#2A2A2A" BorderBrush="#444444" BorderThickness="0,1,0,0" Padding="8">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="➕ 新增行" Style="{StaticResource ActionButton}" Command="{Binding AddWeighingLineCommand}"/>
                                    <Button Content="✏️ 编辑" Style="{StaticResource ActionButton}" Command="{Binding EditWeighingLineCommand}"/>
                                    <Button Content="🗑 删除" Style="{StaticResource DangerButton}" Command="{Binding DeleteWeighingLineCommand}"/>
                                    <Button Content="⬆ 上移" Style="{StaticResource ActionButton}" Command="{Binding MoveWeighingLineUpCommand}"/>
                                    <Button Content="⬇ 下移" Style="{StaticResource ActionButton}" Command="{Binding MoveWeighingLineDownCommand}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </TabItem>

                    <!-- 混炼配方步骤 -->
                    <TabItem Header="🔄 混炼步骤" Foreground="White" Background="#2A2A2A" BorderBrush="#444444"
                             Visibility="{Binding SelectedRecipe, Converter={StaticResource IsMixingRecipeToVis}}">
                        <Grid Margin="5">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- 混炼配方基本信息 -->
                            <Border Grid.Row="0" Background="#252525" BorderBrush="#444444" BorderThickness="0,0,0,1" Padding="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="工艺类型:" Grid.Row="0" Grid.Column="0" Style="{StaticResource LabelText}"/>
                                    <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding MixingProcessTypes}" 
                                              SelectedItem="{Binding EditingRecipe.ProcessType, Mode=TwoWay}" Style="{StaticResource InputCombo}" Margin="0,3">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource EnumToStr}}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <TextBlock Text="混炼机ID:" Grid.Row="0" Grid.Column="2" Style="{StaticResource LabelText}"/>
                                    <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding EditingRecipe.MixerId, Mode=TwoWay}" Style="{StaticResource InputBox}" Margin="0,3"/>

                                    <TextBlock Text="目标温度(℃):" Grid.Row="0" Grid.Column="4" Style="{StaticResource LabelText}"/>
                                    <TextBox Grid.Row="0" Grid.Column="5" Text="{Binding EditingRecipe.TargetTemperature, Mode=TwoWay, StringFormat=F1}" Style="{StaticResource InputBox}" Margin="0,3"/>

                                    <TextBlock Text="目标时间(s):" Grid.Row="1" Grid.Column="0" Style="{StaticResource LabelText}"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding EditingRecipe.TargetTime, Mode=TwoWay}" Style="{StaticResource InputBox}" Margin="0,3"/>

                                    <TextBlock Text="出料温度(℃):" Grid.Row="1" Grid.Column="2" Style="{StaticResource LabelText}"/>
                                    <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding EditingRecipe.DumpTemperature, Mode=TwoWay}" Style="{StaticResource InputBox}" Margin="0,3"/>

                                    <TextBlock Text="转子转速:" Grid.Row="1" Grid.Column="4" Style="{StaticResource LabelText}"/>
                                    <TextBox Grid.Row="1" Grid.Column="5" Text="{Binding EditingRecipe.RotorSpeed, Mode=TwoWay}" Style="{StaticResource InputBox}" Margin="0,3"/>

                                    <TextBlock Text="顶栓压力:" Grid.Row="2" Grid.Column="0" Style="{StaticResource LabelText}"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding EditingRecipe.RamPressure, Mode=TwoWay, StringFormat=F1}" Style="{StaticResource InputBox}" Margin="0,3"/>

                                    <TextBlock Text="顶栓位置:" Grid.Row="2" Grid.Column="2" Style="{StaticResource LabelText}"/>
                                    <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding EditingRecipe.RamPosition, Mode=TwoWay}" Style="{StaticResource InputBox}" Margin="0,3"/>

                                    <StackPanel Grid.Row="2" Grid.Column="4" Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <CheckBox Content="启用温控" IsChecked="{Binding EditingRecipe.EnableTempControl, Mode=TwoWay}" Foreground="White" Margin="0,0,15,0"/>
                                        <CheckBox Content="启用能耗控制" IsChecked="{Binding EditingRecipe.EnableEnergyControl, Mode=TwoWay}" Foreground="White"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- 步骤列表 -->
                            <DataGrid Grid.Row="1" ItemsSource="{Binding MixingSteps}" SelectedItem="{Binding SelectedMixingStep}"
                                      Style="{StaticResource StandardGrid}"
                                      ColumnHeaderStyle="{StaticResource GridHeader}"
                                      CellStyle="{StaticResource GridCell}"
                                      CanUserAddRows="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="步骤" Binding="{Binding StepNumber}" Width="50"/>
                                    <DataGridTemplateColumn Header="类型" Width="80">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding StepTypeDisplayName}" 
                                                           Foreground="{Binding StepType, Converter={StaticResource StepTypeToColor}}"
                                                           HorizontalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="物料" Binding="{Binding MaterialName}" Width="*"/>
                                    <DataGridTextColumn Header="投料量" Binding="{Binding Amount, StringFormat=F3}" Width="80"/>
                                    <DataGridTextColumn Header="投料时间(s)" Binding="{Binding AddTime}" Width="90"/>
                                    <DataGridTextColumn Header="持续时间(s)" Binding="{Binding Duration}" Width="90"/>
                                    <DataGridTextColumn Header="目标温度" Binding="{Binding TargetTemp}" Width="80"/>
                                    <DataGridTextColumn Header="转速" Binding="{Binding RotorSpeed}" Width="60"/>
                                    <DataGridTextColumn Header="压力" Binding="{Binding RamPressure, StringFormat=F1}" Width="70"/>
                                    <DataGridTemplateColumn Header="自动出料" Width="80">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsAutoDump}" IsEnabled="False" HorizontalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="等待温度" Width="80">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding WaitForTemp}" IsEnabled="False" HorizontalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- 步骤操作 -->
                            <Border Grid.Row="2" Background="#2A2A2A" BorderBrush="#444444" BorderThickness="0,1,0,0" Padding="8">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="➕ 新增步骤" Style="{StaticResource ActionButton}" Command="{Binding AddMixingStepCommand}"/>
                                    <Button Content="✏️ 编辑" Style="{StaticResource ActionButton}" Command="{Binding EditMixingStepCommand}"/>
                                    <Button Content="🗑 删除" Style="{StaticResource DangerButton}" Command="{Binding DeleteMixingStepCommand}"/>
                                    <Button Content="⬆ 上移" Style="{StaticResource ActionButton}" Command="{Binding MoveMixingStepUpCommand}"/>
                                    <Button Content="⬇ 下移" Style="{StaticResource ActionButton}" Command="{Binding MoveMixingStepDownCommand}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </TabItem>

                    <!-- 版本管理 -->
                    <TabItem Header="📚 版本管理" Foreground="White" Background="#2A2A2A" BorderBrush="#444444">
                        <Grid Margin="5">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,5">
                                <Button Content="➕ 新建版本" Style="{StaticResource PrimaryButton}" Command="{Binding NewVersionCommand}"/>
                                <Button Content="✅ 设为当前" Style="{StaticResource AccentButton}" Command="{Binding SetCurrentVersionCommand}"/>
                            </StackPanel>

                            <DataGrid Grid.Row="1" ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion}"
                                      Style="{StaticResource StandardGrid}"
                                      ColumnHeaderStyle="{StaticResource GridHeader}"
                                      CellStyle="{StaticResource GridCell}"
                                      IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="版本号" Binding="{Binding Version}" Width="100"/>
                                    <DataGridTemplateColumn Header="状态" Width="80">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding IsCurrent, Converter={StaticResource BoolToCurrentText}}" 
                                                           Foreground="{Binding IsCurrent, Converter={StaticResource BoolToCurrentColor}}"
                                                           HorizontalAlignment="Center" FontWeight="Bold"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="变更说明" Binding="{Binding ChangeDescription}" Width="*"/>
                                    <DataGridTextColumn Header="创建者" Binding="{Binding CreatedBy}" Width="80"/>
                                    <DataGridTextColumn Header="创建时间" Binding="{Binding CreatedAt, StringFormat='yyyy-MM-dd HH:mm'}" Width="140"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>

                    <!-- 下发日志 -->
                    <TabItem Header="📥 下发日志" Foreground="White" Background="#2A2A2A" BorderBrush="#444444">
                        <DataGrid ItemsSource="{Binding DownloadLogs}" 
                                  Style="{StaticResource StandardGrid}"
                                  ColumnHeaderStyle="{StaticResource GridHeader}"
                                  CellStyle="{StaticResource GridCell}"
                                  IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="时间" Binding="{Binding StartTime, StringFormat='yyyy-MM-dd HH:mm:ss'}" Width="140"/>
                                <DataGridTemplateColumn Header="状态" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Status, Converter={StaticResource EnumToStr}}" 
                                                       Foreground="{Binding Status, Converter={StaticResource DownloadStatusToColor}}"
                                                       HorizontalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="目标PLC" Binding="{Binding TargetPlc}" Width="*"/>
                                <DataGridTextColumn Header="版本" Binding="{Binding Version}" Width="80"/>
                                <DataGridTextColumn Header="操作员" Binding="{Binding Operator}" Width="80"/>
                                <DataGridTextColumn Header="耗时" Binding="{Binding Duration, StringFormat='{}{0:mm\\:ss}'}" Width="80"/>
                                <DataGridTextColumn Header="错误信息" Binding="{Binding ErrorMessage}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>

                    <!-- 批次记录 -->
                    <TabItem Header="📦 批次记录" Foreground="White" Background="#2A2A2A" BorderBrush="#444444">
                        <Grid Margin="5">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,5">
                                <Button Content="➕ 创建批次" Style="{StaticResource PrimaryButton}" Command="{Binding CreateBatchCommand}"/>
                            </StackPanel>

                            <DataGrid Grid.Row="1" ItemsSource="{Binding Batches}" 
                                      Style="{StaticResource StandardGrid}"
                                      ColumnHeaderStyle="{StaticResource GridHeader}"
                                      CellStyle="{StaticResource GridCell}"
                                      IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="批次号" Binding="{Binding BatchNumber}" Width="*"/>
                                    <DataGridTextColumn Header="配方" Binding="{Binding RecipeCode}" Width="120"/>
                                    <DataGridTextColumn Header="版本" Binding="{Binding RecipeVersion}" Width="80"/>
                                    <DataGridTemplateColumn Header="状态" Width="90">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Status, Converter={StaticResource EnumToStr}}" 
                                                           Foreground="{Binding Status, Converter={StaticResource BatchStatusToColor}}"
                                                           HorizontalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="目标重量" Binding="{Binding TargetWeight, StringFormat=F1}" Width="90"/>
                                    <DataGridTextColumn Header="实际重量" Binding="{Binding ActualWeight, StringFormat=F1}" Width="90"/>
                                    <DataGridTextColumn Header="开始时间" Binding="{Binding StartTime, StringFormat='yyyy-MM-dd HH:mm'}" Width="130"/>
                                    <DataGridTextColumn Header="结束时间" Binding="{Binding EndTime, StringFormat='yyyy-MM-dd HH:mm'}" Width="130"/>
                                    <DataGridTextColumn Header="操作员" Binding="{Binding Operator}" Width="80"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>

                    <!-- 编辑表单 -->
                    <TabItem Header="✏️ 编辑配方" Foreground="White" Background="#2A2A2A" BorderBrush="#444444"
                             Visibility="{Binding IsEditingRecipe, Converter={StaticResource BoolToVis}}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="10">
                            <StackPanel>
                                <TextBlock Text="编辑配方基本信息" Style="{StaticResource HeaderText}"/>

                                <Grid Margin="0,10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="编码:*" Grid.Row="0" Grid.Column="0" Style="{StaticResource LabelText}"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding EditingRecipe.Code}" Style="{StaticResource InputBox}" Margin="0,3"/>

                                    <TextBlock Text="名称:*" Grid.Row="0" Grid.Column="2" Style="{StaticResource LabelText}"/>
                                    <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding EditingRecipe.Name}" Style="{StaticResource InputBox}" Margin="0,3"/>

                                    <TextBlock Text="类型:*" Grid.Row="1" Grid.Column="0" Style="{StaticResource LabelText}"/>
                                    <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding RecipeTypes}" 
                                              SelectedItem="{Binding EditingRecipe.RecipeType}" Style="{StaticResource InputCombo}" Margin="0,3">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource EnumToStr}}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <TextBlock Text="状态:*" Grid.Row="1" Grid.Column="2" Style="{StaticResource LabelText}"/>
                                    <ComboBox Grid.Row="1" Grid.Column="3" ItemsSource="{Binding RecipeStatuses}" 
                                              SelectedItem="{Binding EditingRecipe.Status}" Style="{StaticResource InputCombo}" Margin="0,3">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource EnumToStr}}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <TextBlock Text="产品编码:" Grid.Row="2" Grid.Column="0" Style="{StaticResource LabelText}"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding EditingRecipe.ProductCode}" Style="{StaticResource InputBox}" Margin="0,3"/>

                                    <TextBlock Text="产品名称:" Grid.Row="2" Grid.Column="2" Style="{StaticResource LabelText}"/>
                                    <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding EditingRecipe.ProductName}" Style="{StaticResource InputBox}" Margin="0,3"/>

                                    <TextBlock Text="批次大小(kg):" Grid.Row="3" Grid.Column="0" Style="{StaticResource LabelText}"/>
                                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding EditingRecipe.BatchSize, StringFormat=F1}" Style="{StaticResource InputBox}" Margin="0,3"/>

                                    <TextBlock Text="目标产率(%):" Grid.Row="3" Grid.Column="2" Style="{StaticResource LabelText}"/>
                                    <TextBox Grid.Row="3" Grid.Column="3" Text="{Binding EditingRecipe.YieldRate, StringFormat=F1}" Style="{StaticResource InputBox}" Margin="0,3"/>

                                    <TextBlock Text="版本:" Grid.Row="4" Grid.Column="0" Style="{StaticResource LabelText}"/>
                                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding EditingRecipe.CurrentVersion}" Style="{StaticResource InputBox}" Margin="0,3" IsReadOnly="True"/>

                                    <TextBlock Text="备注:" Grid.Row="5" Grid.Column="0" Style="{StaticResource LabelText}"/>
                                    <TextBox Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding EditingRecipe.Remark}" 
                                             Style="{StaticResource InputBox}" TextWrapping="Wrap" Height="80" Margin="0,3" VerticalAlignment="Top"/>

                                </Grid>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                                    <Button Content="💾 保存" Style="{StaticResource PrimaryButton}" Command="{Binding SaveRecipeCommand}"/>
                                    <Button Content="❌ 取消" Style="{StaticResource ActionButton}" Command="{Binding CancelRecipeCommand}"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- 称量明细编辑 -->
                    <TabItem Header="✏️ 编辑明细" Foreground="White" Background="#2A2A2A" BorderBrush="#444444"
                             Visibility="{Binding IsEditingWeighingLine, Converter={StaticResource BoolToVis}}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="10">
                            <StackPanel>
                                <TextBlock Text="编辑称量明细" Style="{StaticResource HeaderText}"/>

                                <Grid Margin="0,10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="物料:*" Grid.Row="0" Grid.Column="0" Style="{StaticResource LabelText}"/>
                                    <ComboBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" 
                                              ItemsSource="{Binding DataContext.WeighableMaterials, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              SelectedValue="{Binding EditingWeighingLine.MaterialId}"
                                              SelectedValuePath="Id" DisplayMemberPath="DisplayName"
                                              Style="{StaticResource InputCombo}" Margin="0,3"/>

                                    <TextBlock Text="目标重量(kg):*" Grid.Row="1" Grid.Column="0" Style="{StaticResource LabelText}"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding EditingWeighingLine.TargetWeight, StringFormat=F3}" Style="{StaticResource InputBox}" Margin="0,3"/>

                                    <TextBlock Text="正公差(%):" Grid.Row="1" Grid.Column="2" Style="{StaticResource LabelText}"/>
                                    <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding EditingWeighingLine.TolerancePositive, StringFormat=F1}" Style="{StaticResource InputBox}" Margin="0,3"/>

                                    <TextBlock Text="负公差(%):" Grid.Row="2" Grid.Column="0" Style="{StaticResource LabelText}"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding EditingWeighingLine.ToleranceNegative, StringFormat=F1}" Style="{StaticResource InputBox}" Margin="0,3"/>

                                    <TextBlock Text="称量顺序:" Grid.Row="2" Grid.Column="2" Style="{StaticResource LabelText}"/>
                                    <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding EditingWeighingLine.WeighingOrder}" Style="{StaticResource InputBox}" Margin="0,3"/>

                                    <TextBlock Text="加料方式:" Grid.Row="3" Grid.Column="0" Style="{StaticResource LabelText}"/>
                                    <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding FeederTypes}" 
                                              SelectedItem="{Binding EditingWeighingLine.FeederType}" Style="{StaticResource InputCombo}" Margin="0,3">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource EnumToStr}}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <TextBlock Text="关键物料:" Grid.Row="3" Grid.Column="2" Style="{StaticResource LabelText}"/>
                                    <CheckBox Grid.Row="3" Grid.Column="3" IsChecked="{Binding EditingWeighingLine.IsCritical}" 
                                              Content="是" Foreground="White" VerticalAlignment="Center"/>

                                    <TextBlock Text="备注:" Grid.Row="4" Grid.Column="0" Style="{StaticResource LabelText}"/>
                                    <TextBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding EditingWeighingLine.Remark}" 
                                             Style="{StaticResource InputBox}" TextWrapping="Wrap" Height="60" Margin="0,3" VerticalAlignment="Top"/>

                                    <TextBlock Text="PLC重量标签:" Grid.Row="5" Grid.Column="0" Style="{StaticResource LabelText}"/>
                                    <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding EditingWeighingLine.PlcWeightTag}" Style="{StaticResource InputBox}" Margin="0,3"/>

                                    <TextBlock Text="PLC物料标签:" Grid.Row="5" Grid.Column="2" Style="{StaticResource LabelText}"/>
                                    <TextBox Grid.Row="5" Grid.Column="3" Text="{Binding EditingWeighingLine.PlcMaterialTag}" Style="{StaticResource InputBox}" Margin="0,3"/>

                                </Grid>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                                    <Button Content="💾 保存" Style="{StaticResource PrimaryButton}" Command="{Binding SaveWeighingLineCommand}"/>
                                    <Button Content="❌ 取消" Style="{StaticResource ActionButton}" Command="{Binding CancelWeighingLineCommand}"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- 混炼步骤编辑 -->
                    <TabItem Header="✏️ 编辑步骤" Foreground="White" Background="#2A2A2A" BorderBrush="#444444"
                             Visibility="{Binding IsEditingMixingStep, Converter={StaticResource BoolToVis}}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="10">
                            <StackPanel>
                                <TextBlock Text="编辑混炼步骤" Style="{StaticResource HeaderText}"/>

                                <Grid Margin="0,10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="步骤类型:*" Grid.Row="0" Grid.Column="0" Style="{StaticResource LabelText}"/>
                                    <ComboBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" ItemsSource="{Binding StepTypes}" 
                                              SelectedItem="{Binding EditingMixingStep.StepType}" Style="{StaticResource InputCombo}" Margin="0,3">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource EnumToStr}}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <TextBlock Text="物料:" Grid.Row="1" Grid.Column="0" Style="{StaticResource LabelText}"/>
                                    <ComboBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" 
                                              ItemsSource="{Binding DataContext.WeighableMaterials, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              SelectedValue="{Binding EditingMixingStep.MaterialId}"
                                              SelectedValuePath="Id" DisplayMemberPath="DisplayName"
                                              Style="{StaticResource InputCombo}" Margin="0,3"/>

                                    <TextBlock Text="投料量(kg):" Grid.Row="1" Grid.Column="2" Style="{StaticResource LabelText}"/>
                                    <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding EditingMixingStep.Amount, StringFormat=F3}" Style="{StaticResource InputBox}" Margin="0,3"/>

                                    <TextBlock Text="投料时间(s):" Grid.Row="2" Grid.Column="0" Style="{StaticResource LabelText}"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding EditingMixingStep.AddTime}" Style="{StaticResource InputBox}" Margin="0,3"/>

                                    <TextBlock Text="持续时间(s):" Grid.Row="2" Grid.Column="2" Style="{StaticResource LabelText}"/>
                                    <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding EditingMixingStep.Duration}" Style="{StaticResource InputBox}" Margin="0,3"/>

                                    <TextBlock Text="目标温度(℃):" Grid.Row="3" Grid.Column="0" Style="{StaticResource LabelText}"/>
                                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding EditingMixingStep.TargetTemp}" Style="{StaticResource InputBox}" Margin="0,3"/>

                                    <TextBlock Text="转子转速:" Grid.Row="3" Grid.Column="2" Style="{StaticResource LabelText}"/>
                                    <TextBox Grid.Row="3" Grid.Column="3" Text="{Binding EditingMixingStep.RotorSpeed}" Style="{StaticResource InputBox}" Margin="0,3"/>

                                    <TextBlock Text="顶栓压力:" Grid.Row="4" Grid.Column="0" Style="{StaticResource LabelText}"/>
                                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding EditingMixingStep.RamPressure, StringFormat=F1}" Style="{StaticResource InputBox}" Margin="0,3"/>

                                    <StackPanel Grid.Row="4" Grid.Column="2" Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <CheckBox Content="自动出料" IsChecked="{Binding EditingMixingStep.IsAutoDump}" Foreground="White" Margin="0,0,15,0"/>
                                        <CheckBox Content="等待温度" IsChecked="{Binding EditingMixingStep.WaitForTemp}" Foreground="White"/>
                                    </StackPanel>

                                    <TextBlock Text="跳转条件:" Grid.Row="5" Grid.Column="0" Style="{StaticResource LabelText}"/>
                                    <TextBox Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding EditingMixingStep.Condition}" Style="{StaticResource InputBox}" Margin="0,3"/>

                                    <TextBlock Text="备注:" Grid.Row="6" Grid.Column="0" Style="{StaticResource LabelText}"/>
                                    <TextBox Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding EditingMixingStep.Remark}" 
                                             Style="{StaticResource InputBox}" TextWrapping="Wrap" Height="60" Margin="0,3" VerticalAlignment="Top"/>

                                </Grid>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                                    <Button Content="💾 保存" Style="{StaticResource PrimaryButton}" Command="{Binding SaveMixingStepCommand}"/>
                                    <Button Content="❌ 取消" Style="{StaticResource ActionButton}" Command="{Binding CancelMixingStepCommand}"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <!-- 状态栏 -->
        <StatusBar Grid.Row="2" Background="#2A2A2A" BorderBrush="#444444" BorderThickness="0,1,0,0" Foreground="White">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="加载中..." Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="就绪" Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVis}}"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</UserControl>