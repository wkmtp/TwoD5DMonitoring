<UserControl x:Class="TwoD5DMonitoring.Views.TankMaterialAssignmentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:TwoD5DMonitoring.ViewModels"
             xmlns:conv="clr-namespace:TwoD5DMonitoring.Converters"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200"
             Background="#1A1A1A"
             Foreground="White">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Brushes.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
            <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
            <conv:EnumToStringConverter x:Key="EnumToStr"/>
            <conv:BoolToYesNoConverter x:Key="BoolToYesNo"/>
            <conv:StatusToColorConverter x:Key="StatusToColor"/>

            <Style TargetType="TextBlock" x:Key="HeaderText">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Margin" Value="0,0,0,5"/>
            </Style>

            <Style TargetType="TextBlock" x:Key="LabelText">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Foreground" Value="#CCCCCC"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0,0,5,0"/>
            </Style>

            <Style TargetType="TextBox" x:Key="InputBox">
                <Setter Property="Background" Value="#2A2A2A"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderBrush" Value="#444444"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="5,3"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="MinWidth" Value="120"/>
            </Style>

            <Style TargetType="ComboBox" x:Key="InputCombo">
                <Setter Property="Background" Value="#2A2A2A"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderBrush" Value="#444444"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="5,3"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="MinWidth" Value="120"/>
            </Style>

            <Style TargetType="Button" x:Key="ActionButton">
                <Setter Property="Background" Value="#3A3A3A"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderBrush" Value="#555555"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="12,5"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Margin" Value="5,0"/>
            </Style>

            <Style TargetType="Button" x:Key="PrimaryButton" BasedOn="{StaticResource ActionButton}">
                <Setter Property="Background" Value="#2E7D32"/>
                <Setter Property="BorderBrush" Value="#4CAF50"/>
            </Style>

            <Style TargetType="Button" x:Key="DangerButton" BasedOn="{StaticResource ActionButton}">
                <Setter Property="Background" Value="#C62828"/>
                <Setter Property="BorderBrush" Value="#EF5350"/>
            </Style>

            <Style TargetType="DataGrid" x:Key="StandardGrid">
                <Setter Property="Background" Value="#1E1E1E"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderBrush" Value="#333333"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="GridLinesVisibility" Value="Horizontal"/>
                <Setter Property="HorizontalGridLinesBrush" Value="#333333"/>
                <Setter Property="AutoGenerateColumns" Value="False"/>
                <Setter Property="IsReadOnly" Value="True"/>
                <Setter Property="SelectionMode" Value="Single"/>
                <Setter Property="SelectionUnit" Value="FullRow"/>
                <Setter Property="HeadersVisibility" Value="Column"/>
            </Style>

            <Style TargetType="DataGridColumnHeader" x:Key="GridHeader">
                <Setter Property="Background" Value="#2A2A2A"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderBrush" Value="#444444"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="Padding" Value="8,5"/>
                <Setter Property="FontWeight" Value="Bold"/>
            </Style>

            <Style TargetType="DataGridCell" x:Key="GridCell">
                <Setter Property="Padding" Value="8,3"/>
                <Setter Property="BorderThickness" Value="0"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部工具栏 -->
        <Border Grid.Row="0" Background="#2A2A2A" BorderBrush="#444444" BorderThickness="0,0,0,1" Padding="10,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🏭 罐体物料分配" Style="{StaticResource HeaderText}" VerticalAlignment="Center"/>
                
                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="20,0" Width="1"/>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="搜索罐体:" Style="{StaticResource LabelText}"/>
                    <TextBox x:Name="TankSearchBox" Style="{StaticResource InputBox}" Width="200" 
                             TextChanged="TankSearchBox_TextChanged"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="🔄 刷新" Style="{StaticResource ActionButton}" Click="Refresh_Click"/>
                    <Button Content="➕ 分配物料" Style="{StaticResource PrimaryButton}" Click="AssignMaterial_Click"/>
                    <Button Content="📜 查看历史" Style="{StaticResource ActionButton}" Click="ViewHistory_Click"/>
                    <Button Content="📊 导出报表" Style="{StaticResource ActionButton}" Click="ExportReport_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 主内容区 -->
        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="400"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：罐体列表 -->
            <Border Grid.Column="0" Background="#1E1E1E" BorderBrush="#333333" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#2A2A2A" BorderBrush="#444444" BorderThickness="0,0,0,1" Padding="10,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="罐体列表" Style="{StaticResource HeaderText}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TankCountText" Text="共 0 个罐体" Foreground="#AAAAAA" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                    </Border>

                    <DataGrid x:Name="TankGrid" Grid.Row="1" ItemsSource="{Binding TankMaterials}" 
                              SelectedItem="{Binding SelectedTankMaterial, Mode=TwoWay}"
                              Style="{StaticResource StandardGrid}"
                              ColumnHeaderStyle="{StaticResource GridHeader}"
                              CellStyle="{StaticResource GridCell}"
                              AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="罐体编码" Binding="{Binding TankCode}" Width="100"/>
                            <DataGridTextColumn Header="罐体名称" Binding="{Binding TankName}" Width="*"/>
                            <DataGridTemplateColumn Header="类型" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding TankType, Converter={StaticResource EnumToStr}}" 
                                                   HorizontalAlignment="Center" FontSize="11"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="主物料" Binding="{Binding MaterialName}" Width="*"/>
                            <DataGridTextColumn Header="物料编码" Binding="{Binding MaterialCode}" Width="100"/>
                            <DataGridTemplateColumn Header="主料" Width="50">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsPrimary}" IsEnabled="False" HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="优先级" Binding="{Binding Priority}" Width="60"/>
                            <DataGridTextColumn Header="最大容量" Binding="{Binding MaxCapacity, StringFormat=F1}" Width="80"/>
                            <DataGridTextColumn Header="最低液位" Binding="{Binding MinLevel, StringFormat=F1}" Width="80"/>
                            <DataGridTextColumn Header="最高液位" Binding="{Binding MaxLevel, StringFormat=F1}" Width="80"/>
                            <DataGridTemplateColumn Header="状态" Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding IsActive, Converter={StaticResource BoolToYesNo}}" 
                                                   Foreground="{Binding IsActive, Converter={StaticResource BoolToActiveColor}}"
                                                   HorizontalAlignment="Center" FontSize="11"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#333333"/>

            <!-- 右侧：编辑/详情面板 -->
            <Border Grid.Column="2" Background="#1E1E1E" BorderBrush="#333333" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 编辑面板 -->
                    <Border Grid.Row="0" x:Name="EditPanel" Visibility="Collapsed"
                            Background="#252525" BorderBrush="#444444" BorderThickness="0,0,0,1" Padding="10">
                        <StackPanel>
                            <TextBlock Text="编辑罐体分配" Style="{StaticResource HeaderText}"/>
                            <Grid Margin="0,10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="罐体编码:" Grid.Row="0" Grid.Column="0" Style="{StaticResource LabelText}"/>
                                <TextBox x:Name="TankCodeBox" Grid.Row="0" Grid.Column="1" Style="{StaticResource InputBox}" Margin="0,3" IsReadOnly="True"/>

                                <TextBlock Text="罐体名称:" Grid.Row="1" Grid.Column="0" Style="{StaticResource LabelText}"/>
                                <TextBox x:Name="TankNameBox" Grid.Row="1" Grid.Column="1" Style="{StaticResource InputBox}" Margin="0,3" IsReadOnly="True"/>

                                <TextBlock Text="物料:*" Grid.Row="2" Grid.Column="0" Style="{StaticResource LabelText}"/>
                                <ComboBox x:Name="MaterialCombo" Grid.Row="2" Grid.Column="1" 
                                          ItemsSource="{Binding WeighableMaterials}"
                                          SelectedValue="{Binding SelectedTankMaterial.MaterialId, Mode=TwoWay}"
                                          SelectedValuePath="Id" DisplayMemberPath="DisplayName"
                                          Style="{StaticResource InputCombo}" Margin="0,3"/>

                                <TextBlock Text="主物料:" Grid.Row="3" Grid.Column="0" Style="{StaticResource LabelText}"/>
                                <CheckBox x:Name="IsPrimaryCheck" Grid.Row="3" Grid.Column="1" 
                                          IsChecked="{Binding SelectedTankMaterial.IsPrimary, Mode=TwoWay}" 
                                          Content="设为主物料" Foreground="White" VerticalAlignment="Center"/>

                                <TextBlock Text="优先级:" Grid.Row="4" Grid.Column="0" Style="{StaticResource LabelText}"/>
                                <TextBox x:Name="PriorityBox" Grid.Row="4" Grid.Column="1" 
                                         Text="{Binding SelectedTankMaterial.Priority, Mode=TwoWay}" Style="{StaticResource InputBox}" Margin="0,3"/>

                                <TextBlock Text="最大容量(kg):" Grid.Row="5" Grid.Column="0" Style="{StaticResource LabelText}"/>
                                <TextBox x:Name="MaxCapacityBox" Grid.Row="5" Grid.Column="1" 
                                         Text="{Binding SelectedTankMaterial.MaxCapacity, Mode=TwoWay, StringFormat=F1}" Style="{StaticResource InputBox}" Margin="0,3"/>

                                <TextBlock Text="最低液位:" Grid.Row="6" Grid.Column="0" Style="{StaticResource LabelText}"/>
                                <TextBox x:Name="MinLevelBox" Grid.Row="6" Grid.Column="1" 
                                         Text="{Binding SelectedTankMaterial.MinLevel, Mode=TwoWay, StringFormat=F1}" Style="{StaticResource InputBox}" Margin="0,3"/>

                                <TextBlock Text="最高液位:" Grid.Row="7" Grid.Column="0" Style="{StaticResource LabelText}"/>
                                <TextBox x:Name="MaxLevelBox" Grid.Row="7" Grid.Column="1" 
                                         Text="{Binding SelectedTankMaterial.MaxLevel, Mode=TwoWay, StringFormat=F1}" Style="{StaticResource InputBox}" Margin="0,3"/>
                            </Grid>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                <Button Content="💾 保存" Style="{StaticResource PrimaryButton}" Click="SaveAssignment_Click"/>
                                <Button Content="❌ 取消" Style="{StaticResource ActionButton}" Click="CancelEdit_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 详情/历史面板 -->
                    <Border Grid.Row="1">
                        <TabControl Background="Transparent" BorderThickness="0">
                            <TabItem Header="📋 当前分配" Foreground="White" Background="#2A2A2A" BorderBrush="#444444">
                                <DataGrid x:Name="AssignmentGrid" ItemsSource="{Binding CurrentAssignments}"
                                          Style="{StaticResource StandardGrid}"
                                          ColumnHeaderStyle="{StaticResource GridHeader}"
                                          CellStyle="{StaticResource GridCell}"
                                          IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="罐体" Binding="{Binding TankName}" Width="*"/>
                                        <DataGridTextColumn Header="编码" Binding="{Binding TankCode}" Width="80"/>
                                        <DataGridTextColumn Header="物料" Binding="{Binding MaterialName}" Width="*"/>
                                        <DataGridTextColumn Header="主料" Binding="{Binding IsPrimary, Converter={StaticResource BoolToYesNo}}" Width="50"/>
                                        <DataGridTextColumn Header="优先级" Binding="{Binding Priority}" Width="60"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </TabItem>
                            <TabItem Header="📜 变更历史" Foreground="White" Background="#2A2A2A" BorderBrush="#444444">
                                <DataGrid x:Name="HistoryGrid" ItemsSource="{Binding TankMaterialHistory}"
                                          Style="{StaticResource StandardGrid}"
                                          ColumnHeaderStyle="{StaticResource GridHeader}"
                                          CellStyle="{StaticResource GridCell}"
                                          IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="时间" Binding="{Binding ChangeTime, StringFormat='yyyy-MM-dd HH:mm'}" Width="140"/>
                                        <DataGridTextColumn Header="原物料" Binding="{Binding OldMaterialName}" Width="*"/>
                                        <DataGridTextColumn Header="新物料" Binding="{Binding NewMaterialName}" Width="*"/>
                                        <DataGridTextColumn Header="原因" Binding="{Binding ChangeReason}" Width="*"/>
                                        <DataGridTextColumn Header="操作员" Binding="{Binding Operator}" Width="80"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </TabItem>
                            <TabItem Header="⚠️ 异常监控" Foreground="White" Background="#2A2A2A" BorderBrush="#444444">
                                <DataGrid x:Name="AlertGrid" ItemsSource="{Binding Alerts}"
                                          Style="{StaticResource StandardGrid}"
                                          ColumnHeaderStyle="{StaticResource GridHeader}"
                                          CellStyle="{StaticResource GridCell}"
                                          IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="时间" Binding="{Binding Time, StringFormat='yyyy-MM-dd HH:mm'}" Width="140"/>
                                        <DataGridTextColumn Header="罐体" Binding="{Binding TankName}" Width="*"/>
                                        <DataGridTextColumn Header="类型" Binding="{Binding AlertType}" Width="100"/>
                                        <DataGridTextColumn Header="消息" Binding="{Binding Message}" Width="*"/>
                                        <DataGridTemplateColumn Header="级别" Width="70">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Level}" 
                                                               Foreground="{Binding Level, Converter={StaticResource AlertLevelToColor}}"
                                                               HorizontalAlignment="Center" FontWeight="Bold"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </TabItem>
                        </TabControl>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- 状态栏 -->
        <StatusBar Grid.Row="2" Background="#2A2A2A" BorderBrush="#444444" BorderThickness="0,1,0,0" Foreground="White">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="就绪"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="SelectionText" Text="未选择罐体"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</UserControl>