<Window x:Class="TwoD5DMonitoring.Views.ThreeDEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TwoD5DMonitoring.Views"
        mc:Ignorable="d"
        Title="3D 场景编辑器 - 管理员模式" 
        Height="900" Width="1400"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="#1A1A1A"
        Foreground="White">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>

        <!-- 顶部工具栏 -->
        <Border Grid.Row="0" Grid.ColumnSpan="3" Background="#2A2A2A" BorderBrush="#444444" BorderThickness="0,0,0,1" Padding="10,5">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="✏️ 3D 场景编辑器 (管理员模式)" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,20,0"/>
                
                <Button Content="🆕 新建场景" Margin="5,0" Padding="15,5" Background="#3A3A3A" Foreground="White" 
                        BorderBrush="#555555" BorderThickness="1" Click="NewScene_Click"/>
                <Button Content="📂 打开场景" Margin="5,0" Padding="15,5" Background="#3A3A3A" Foreground="White" 
                        BorderBrush="#555555" BorderThickness="1" Click="OpenScene_Click"/>
                <Button Content="💾 保存场景" Margin="5,0" Padding="15,5" Background="#3A3A3A" Foreground="White" 
                        BorderBrush="#555555" BorderThickness="1" Click="SaveScene_Click"/>
                <Button Content="💾 另存为" Margin="5,0" Padding="15,5" Background="#3A3A3A" Foreground="White" 
                        BorderBrush="#555555" BorderThickness="1" Click="SaveAsScene_Click"/>

                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="10,0" Width="1"/>

                <Button Content="➕ 添加设备" Margin="5,0" Padding="15,5" Background="#2E7D32" Foreground="White" 
                        BorderBrush="#4CAF50" BorderThickness="1" Click="AddDevice_Click"/>
                <Button Content="🗑 删除设备" Margin="5,0" Padding="15,5" Background="#C62828" Foreground="White" 
                        BorderBrush="#EF5350" BorderThickness="1" Click="DeleteDevice_Click"/>
                <Button Content="📋 复制设备" Margin="5,0" Padding="15,5" Background="#3A3A3A" Foreground="White" 
                        BorderBrush="#555555" BorderThickness="1" Click="DuplicateDevice_Click"/>

                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="10,0" Width="1"/>

                <Button Content="↩ 撤销" Margin="5,0" Padding="15,5" Background="#3A3A3A" Foreground="White" 
                        BorderBrush="#555555" BorderThickness="1" Click="Undo_Click"/>
                <Button Content="↪ 重做" Margin="5,0" Padding="15,5" Background="#3A3A3A" Foreground="White" 
                        BorderBrush="#555555" BorderThickness="1" Click="Redo_Click"/>

                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="10,0" Width="1"/>

                <Button Content="👁 预览模式" Margin="5,0" Padding="15,5" Background="#1976D2" Foreground="White" 
                        BorderBrush="#2196F3" BorderThickness="1" Click="PreviewMode_Click"/>
            </StackPanel>
        </Border>

        <!-- 左侧面板：设备库/层级 -->
        <Border Grid.Row="1" Grid.Column="0" Background="#1E1E1E" BorderBrush="#333333" BorderThickness="0,0,1,0" Margin="10,10,0,10" CornerRadius="4,0,0,4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TabControl Background="Transparent" BorderThickness="0">
                    <TabItem Header="📦 设备库" Foreground="White" Background="#2A2A2A" BorderBrush="#444444">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="DeviceLibraryPanel" Margin="10">
                                <!-- 设备库项将在代码中动态生成 -->
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="🌳 场景层级" Foreground="White" Background="#2A2A2A" BorderBrush="#444444">
                        <Grid Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBox x:Name="HierarchySearchBox" Margin="0,0,0,5" Padding="8" 
                                     Background="#2A2A2A" Foreground="White" BorderBrush="#444444" 
                                     BorderThickness="1" TextChanged="HierarchySearchBox_TextChanged"
                                     ToolTip="搜索设备..."/>
                            <TreeView x:Name="SceneHierarchyTree" Grid.Row="1" Background="Transparent" 
                                      BorderThickness="0" Foreground="White"
                                      SelectedItemChanged="SceneHierarchyTree_SelectedItemChanged">
                                <TreeView.Resources>
                                    <HierarchicalDataTemplate DataType="{x:Type local:DeviceTreeItem}" ItemsSource="{Binding Children}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Icon}" Margin="0,0,5,0"/>
                                            <TextBlock Text="{Binding Name}"/>
                                            <TextBlock Text=" (隐藏)" Foreground="#888888" FontSize="10" 
                                                       Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibilityInverse}}"/>
                                        </StackPanel>
                                    </HierarchicalDataTemplate>
                                </TreeView.Resources>
                            </TreeView>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>
        </Border>

        <!-- 中央视口 -->
        <Border Grid.Row="1" Grid.Column="1" Background="#0D0D0D" BorderBrush="#333333" BorderThickness="1" Margin="0,10,0,10" CornerRadius="4">
            <Grid x:Name="ViewportGrid">
                <!-- 3D 视口占位 -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="🎮" FontSize="80" HorizontalAlignment="Center" Foreground="#333333"/>
                    <TextBlock Text="3D 编辑器视口" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" 
                               Foreground="#555555" Margin="0,20,0,10"/>
                    <TextBlock Text="预留 Three.js / Unity / Helix Toolkit 集成接口" FontSize="12" 
                               HorizontalAlignment="Center" Foreground="#777777" TextWrapping="Wrap" MaxWidth="400"/>
                    
                    <!-- 网格可视化占位 -->
                    <Border x:Name="GridVisualization" Margin="0,30,0,0" Width="300" Height="300" 
                            BorderBrush="#333333" BorderThickness="1" Background="#151515">
                        <Canvas x:Name="GridCanvas">
                            <!-- 网格线将在代码中绘制 -->
                        </Canvas>
                    </Border>
                    
                    <TextBlock Text="网格大小: 1米 × 1米" FontSize="11" HorizontalAlignment="Center" 
                               Foreground="#666666" Margin="0,10,0,0"/>
                </StackPanel>

                <!-- 变换 gizmo 占位 -->
                <Border x:Name="TransformGizmo" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="↔ 移动" Width="60" Height="30" Margin="2" Background="#3A3A3A" Foreground="White" BorderBrush="#555555"/>
                        <Button Content="↻ 旋转" Width="60" Height="30" Margin="2" Background="#3A3A3A" Foreground="White" BorderBrush="#555555"/>
                        <Button Content="⤢ 缩放" Width="60" Height="30" Margin="2" Background="#3A3A3A" Foreground="White" BorderBrush="#555555"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 右侧面板：属性/设置 -->
        <Border Grid.Row="1" Grid.Column="2" Background="#1E1E1E" BorderBrush="#333333" BorderThickness="1,0,0,0" Margin="0,10,10,10" CornerRadius="0,4,4,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TabControl Background="Transparent" BorderThickness="0">
                    <TabItem Header="🔧 属性" Foreground="White" Background="#2A2A2A" BorderBrush="#444444">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="PropertyPanel" Margin="10">
                                <TextBlock Text="请选择一个设备" FontSize="13" Foreground="#888888" 
                                           HorizontalAlignment="Center" Margin="0,50,0,0"/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="⚙️ 场景设置" Foreground="White" Background="#2A2A2A" BorderBrush="#444444">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="10">
                                <GroupBox Header="相机设置" Foreground="White" BorderBrush="#444444" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="位置:" FontSize="12" Foreground="#AAAAAA" Margin="0,5,0,2"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="X:" Width="20" FontSize="11"/>
                                            <TextBox x:Name="CamPosX" Text="0" Width="60" Margin="2" Background="#2A2A2A" Foreground="White" BorderBrush="#444444"/>
                                            <TextBlock Text="Y:" Width="20" FontSize="11" Margin="10,0,0,0"/>
                                            <TextBox x:Name="CamPosY" Text="10" Width="60" Margin="2" Background="#2A2A2A" Foreground="White" BorderBrush="#444444"/>
                                            <TextBlock Text="Z:" Width="20" FontSize="11" Margin="10,0,0,0"/>
                                            <TextBox x:Name="CamPosZ" Text="20" Width="60" Margin="2" Background="#2A2A2A" Foreground="White" BorderBrush="#444444"/>
                                        </StackPanel>
                                        <TextBlock Text="目标:" FontSize="12" Foreground="#AAAAAA" Margin="0,10,0,2"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="X:" Width="20" FontSize="11"/>
                                            <TextBox x:Name="CamTargetX" Text="0" Width="60" Margin="2" Background="#2A2A2A" Foreground="White" BorderBrush="#444444"/>
                                            <TextBlock Text="Y:" Width="20" FontSize="11" Margin="10,0,0,0"/>
                                            <TextBox x:Name="CamTargetY" Text="0" Width="60" Margin="2" Background="#2A2A2A" Foreground="White" BorderBrush="#444444"/>
                                            <TextBlock Text="Z:" Width="20" FontSize="11" Margin="10,0,0,0"/>
                                            <TextBox x:Name="CamTargetZ" Text="0" Width="60" Margin="2" Background="#2A2A2A" Foreground="White" BorderBrush="#444444"/>
                                        </StackPanel>
                                    </StackPanel>
                                </GroupBox>

                                <GroupBox Header="环境设置" Foreground="White" BorderBrush="#444444" Margin="0,0,0,10">
                                    <StackPanel>
                                        <CheckBox x:Name="ShowGridCheck" Content="显示网格" Foreground="White" IsChecked="True" Margin="0,5"/>
                                        <CheckBox x:Name="ShowAxesCheck" Content="显示坐标轴" Foreground="White" IsChecked="True" Margin="0,5"/>
                                        <CheckBox x:Name="ShowWireframeCheck" Content="线框模式" Foreground="White" Margin="0,5"/>
                                        
                                        <TextBlock Text="网格大小:" FontSize="12" Foreground="#AAAAAA" Margin="0,10,0,2"/>
                                        <Slider x:Name="GridSizeSlider" Minimum="0.5" Maximum="10" Value="1" TickFrequency="0.5" IsSnapToTickEnabled="True" Margin="0,5"/>
                                        
                                        <TextBlock Text="环境光强度:" FontSize="12" Foreground="#AAAAAA" Margin="0,10,0,2"/>
                                        <Slider x:Name="AmbientIntensitySlider" Minimum="0" Maximum="1" Value="0.5" Margin="0,5"/>
                                    </StackPanel>
                                </GroupBox>

                                <GroupBox Header="导出设置" Foreground="White" BorderBrush="#444444">
                                    <StackPanel>
                                        <Button Content="导出为 Three.js 场景 (JSON)" Margin="0,5" Padding="10" 
                                                Background="#3A3A3A" Foreground="White" BorderBrush="#555555"
                                                Click="ExportThreeJs_Click"/>
                                        <Button Content="导出为 Unity Prefab" Margin="0,5" Padding="10" 
                                                Background="#3A3A3A" Foreground="White" BorderBrush="#555555"
                                                Click="ExportUnity_Click"/>
                                        <Button Content="导出设备列表 (CSV)" Margin="0,5" Padding="10" 
                                                Background="#3A3A3A" Foreground="White" BorderBrush="#555555"
                                                Click="ExportCsv_Click"/>
                                    </StackPanel>
                                </GroupBox>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Grid>
        </Border>

        <!-- 底部状态栏 -->
        <StatusBar Grid.Row="2" Grid.ColumnSpan="3" Background="#2A2A2A" BorderBrush="#444444" BorderThickness="0,1,0,0" Foreground="White">
            <StatusBarItem>
                <TextBlock x:Name="EditorStatusText" Text="就绪 - 编辑模式"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="SelectedDeviceText" Text="未选择设备"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="SceneInfoText" Text="场景: 未保存 | 设备: 0"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>