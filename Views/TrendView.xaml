<UserControl x:Class="TwoD5DMonitoring.Views.TrendView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:TwoD5DMonitoring.ViewModels"
             xmlns:conv="clr-namespace:TwoD5DMonitoring.Converters"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1400"
             Background="#1A1A1A"
             Foreground="White">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Brushes.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
            <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
            <conv:EnumToStringConverter x:Key="EnumToStr"/>

            <Style TargetType="TextBlock" x:Key="HeaderText">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Margin" Value="0,0,0,5"/>
            </Style>

            <Style TargetType="TextBlock" x:Key="LabelText">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Foreground" Value="#CCCCCC"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0,0,5,0"/>
            </Style>

            <Style TargetType="TextBox" x:Key="InputBox">
                <Setter Property="Background" Value="#2A2A2A"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderBrush" Value="#444444"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="5,3"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="MinWidth" Value="120"/>
            </Style>

            <Style TargetType="ComboBox" x:Key="InputCombo">
                <Setter Property="Background" Value="#2A2A2A"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderBrush" Value="#444444"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="5,3"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="MinWidth" Value="120"/>
            </Style>

            <Style TargetType="Button" x:Key="ActionButton">
                <Setter Property="Background" Value="#3A3A3A"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderBrush" Value="#555555"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="10,4"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Margin" Value="3,0"/>
            </Style>

            <Style TargetType="Button" x:Key="PrimaryButton" BasedOn="{StaticResource ActionButton}">
                <Setter Property="Background" Value="#2E7D32"/>
                <Setter Property="BorderBrush" Value="#4CAF50"/>
            </Style>

            <Style TargetType="Button" x:Key="DangerButton" BasedOn="{StaticResource ActionButton}">
                <Setter Property="Background" Value="#C62828"/>
                <Setter Property="BorderBrush" Value="#EF5350"/>
            </Style>

            <Style TargetType="Button" x:Key="AccentButton" BasedOn="{StaticResource ActionButton}">
                <Setter Property="Background" Value="#1976D2"/>
                <Setter Property="BorderBrush" Value="#2196F3"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部工具栏 -->
        <Border Grid.Row="0" Background="#2A2A2A" BorderBrush="#444444" BorderThickness="0,0,0,1" Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="📈 历史趋势分析" Style="{StaticResource HeaderText}" VerticalAlignment="Center"/>

                <!-- 标签选择区 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="可用标签:" Style="{StaticResource LabelText}"/>
                    <ComboBox ItemsSource="{Binding AvailableTags}" 
                              SelectedItem="{Binding SelectedTagForAdd}"
                              DisplayMemberPath="DisplayName"
                              Style="{StaticResource InputCombo}" Width="200" Margin="5,0,0,0"/>
                    <Button Content="➕ 添加" Style="{StaticResource ActionButton}" Command="{Binding AddTagCommand}" CommandParameter="{Binding SelectedTagForAdd}"/>
                    <Button Content="🗑 清空" Style="{StaticResource DangerButton}" Command="{Binding ClearTagsCommand}"/>
                </StackPanel>

                <!-- 时间范围与查询 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="开始:" Style="{StaticResource LabelText}"/>
                    <DatePicker SelectedDate="{Binding StartTime}" Style="{StaticResource DatePickerStyle}" Width="130" Margin="3,0"/>
                    <TextBlock Text="结束:" Style="{StaticResource LabelText}" Margin="10,0,0,0"/>
                    <DatePicker SelectedDate="{Binding EndTime}" Style="{StaticResource DatePickerStyle}" Width="130" Margin="3,0"/>

                    <ComboBox ItemsSource="{Binding QuickRanges}" SelectedItem="{Binding SelectedQuickRange}"
                              Style="{StaticResource InputCombo}" Width="100" Margin="10,0,0,0">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <ComboBox ItemsSource="{Binding AggregationTypes}" SelectedItem="{Binding Aggregation}"
                              Style="{StaticResource InputCombo}" Width="100" Margin="10,0,0,0">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource EnumToStr}}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <ComboBox ItemsSource="{Binding Intervals}" SelectedItem="{Binding Interval}"
                              Style="{StaticResource InputCombo}" Width="100" Margin="10,0,0,0">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Button Content="🔍 查询" Style="{StaticResource PrimaryButton}" Command="{Binding QueryCommand}"/>
                    <Button Content="📥 导出" Style="{StaticResource AccentButton}" Command="{Binding ExportDataCommand}"/>
                    <Button Content="⟳ 自动刷新" Style="{StaticResource AccentButton}" Command="{Binding ToggleAutoRefreshCommand}"
                            Background="{Binding AutoRefresh, Converter={StaticResource BoolToAccentBg}}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 已选标签显示 -->
        <Border Grid.Row="0" Height="40" VerticalAlignment="Bottom" Background="#1E1E1E" BorderBrush="#333333" BorderThickness="0,0,0,1" Visibility="{Binding SelectedTags.Count, Converter={StaticResource CountToVis}}">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding SelectedTags}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{Binding Color}" BorderBrush="#555555" BorderThickness="1" CornerRadius="12" Padding="8,4" Margin="5,2">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding DisplayName}" Foreground="White" FontSize="11" VerticalAlignment="Center"/>
                                    <TextBlock Text=" " Foreground="White" VerticalAlignment="Center"/>
                                    <Button Content="×" Foreground="White" Background="Transparent" BorderThickness="0" Padding="0" 
                                            Command="{Binding DataContext.RemoveTagCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" FontSize="10" Width="16" Height="16" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- 主图表区域 -->
        <Border Grid.Row="1" Margin="10" Background="#0D0D0D" BorderBrush="#333333" BorderThickness="1" CornerRadius="4">
            <Grid>
                <!-- LiveCharts 笛卡尔图表 -->
                <lvc:CartesianChart x:Name="TrendChart" 
Series="{Binding Series}"
                                    XAxes="{Binding XAxes}"
                                    YAxes="{Binding YAxes}"
                                    TooltipPosition="Top"
                                    LegendPosition="Right"
                                    AnimationsSpeed="0:0:0.2">
                        </lvc:CartesianChart>

                <!-- 加载遮罩 -->
                <Border Background="#80000000" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Width="40" Height="40" BorderBrush="#2196F3" BorderThickness="3" CornerRadius="20"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <RotateTransform x:Name="LoadingSpin" Angle="0"/>
                            </Border.RenderTransform>
                            <Border.Triggers>
                                <EventTrigger RoutedEvent="Border.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="LoadingSpin"
                                                             Storyboard.TargetProperty="Angle"
                                                             From="0" To="360" Duration="0:0:1"
                                                             RepeatBehavior="Forever"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Border.Triggers>
                        </Border>
                        <TextBlock Text="正在查询数据..." FontSize="14" Foreground="White" Margin="0,15,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 图例与统计信息 -->
        <Border Grid.Row="2" Height="120" Margin="10,0,10,10" Background="#1E1E1E" BorderBrush="#333333" BorderThickness="1" CornerRadius="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 系列图例 -->
                <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="10">
                    <ItemsControl ItemsSource="{Binding Series}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#2A2A2A" BorderBrush="{Binding Color}" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="5">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="12" Height="12" Fill="{Binding Color}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayName}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding Unit}" Foreground="#888888" FontSize="9"/>
                                        </StackPanel>
                                        <CheckBox IsChecked="{Binding Visible}" Content="显示" Foreground="White" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="10"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- 统计摘要 -->
                <Border Grid.Column="1" Background="#252525" BorderBrush="#444444" BorderThickness="1,0,0,0" Padding="15,10" Width="300">
                    <StackPanel>
                        <TextBlock Text="统计摘要" Style="{StaticResource HeaderText}" Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <TextBlock Text="曲线数:" Style="{StaticResource LabelText}" Width="70"/>
                            <TextBlock Text="{Binding Series.Count}" Foreground="White" FontWeight="Bold"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <TextBlock Text="总数据点:" Style="{StaticResource LabelText}" Width="70"/>
                            <TextBlock Text="{Binding Series.Count, Converter={StaticResource TotalPointsConverter}}" Foreground="White" FontWeight="Bold"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <TextBlock Text="时间范围:" Style="{StaticResource LabelText}" Width="70"/>
                            <TextBlock Text="{Binding StartTime, StringFormat='yyyy-MM-dd HH:mm'}" Foreground="White" FontSize="10"/>
                            <TextBlock Text=" - " Foreground="#888888"/>
                            <TextBlock Text="{Binding EndTime, StringFormat='yyyy-MM-dd HH:mm'}" Foreground="White" FontSize="10"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <TextBlock Text="刷新:" Style="{StaticResource LabelText}" Width="70"/>
                            <TextBlock Text="{Binding AutoRefresh, Converter={StaticResource BoolToAutoRefreshText}}" Foreground="White" FontWeight="Bold"/>
                            <TextBlock Text="{Binding AutoRefresh, Converter={StaticResource RefreshIntervalText}}" Foreground="#888888" FontSize="10" Margin="5,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 状态栏 -->
        <StatusBar Background="#2A2A2A" BorderBrush="#444444" BorderThickness="0,1,0,0" Foreground="White" Height="28">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="加载中..." Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="就绪" Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVis}}"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</UserControl>